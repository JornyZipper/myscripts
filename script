local LOCALHITBOXES_SOURCE = [====[
-- Required only by the LocalScript in PlayerGui. No server code uses this module.
-- These are LOCAL visual/geometry changes, not a server-side damage extension.
local LocalHitboxes = {}

function LocalHitboxes.new()
    local originals = {}
    local self = {}
    local changedKeys = {"Size", "CanCollide", "CanQuery", "Massless"}

    function self:Apply(head, scale)
        if not head.Parent or scale <= 1 then
            self:Restore(head)
            return
        end
        local old = originals[head]
        if not old then
            old = {base = {}, applied = {}}
            for _, key in ipairs(changedKeys) do old.base[key] = head[key] end
            originals[head] = old
        else
            -- If the game's server changed a property, use its new value as the baseline.
            local unchanged = old.scale == scale
            for _, key in ipairs(changedKeys) do
                if head[key] ~= old.applied[key] then
                    old.base[key] = head[key]
                    unchanged = false
                end
            end
            if unchanged then return end
        end
        local nextValues = {
            Size = old.base.Size * scale, CanCollide = false, CanQuery = true, Massless = true,
        }
        for _, key in ipairs(changedKeys) do
            if head[key] ~= nextValues[key] then head[key] = nextValues[key] end
            old.applied[key] = nextValues[key]
        end
        old.scale = scale
    end

    function self:Restore(head)
        local old = originals[head]
        if not old then return end
        if head.Parent then
            for _, key in ipairs(changedKeys) do
                -- Do not overwrite a newer value sent by another game system.
                if head[key] == old.applied[key] then head[key] = old.base[key] end
            end
        end
        originals[head] = nil
    end

    function self:Retain(wanted)
        for head in pairs(originals) do
            if not wanted[head] then self:Restore(head) end
        end
    end

    function self:Clear()
        for head in pairs(originals) do self:Restore(head) end
    end

    return self
end

return LocalHitboxes
]====]

