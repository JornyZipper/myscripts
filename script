local function updateESP()
    table.clear(visualCandidates)
    table.clear(wantedHeads)
    local camera = workspace.CurrentCamera
    local _, _, localRoot = Shared.Alive(player)
    if localRoot and camera and (settings.ESP or settings.Hitbox) then
        for _, other in ipairs(playerList) do
            if Shared.IsTarget(player, other, settings) then
                local character, _, root, head = Shared.Alive(other)
                if character then
                    local distance = (root.Position - localRoot.Position).Magnitude
                    if distance <= settings.MaxDistance then
                        if settings.Hitbox and settings.HeadScale > 1 then
                            wantedHeads[head] = true
                            hitboxes:Apply(head, settings.HeadScale)
                        end
                        local _, onScreen = camera:WorldToViewportPoint(head.Position)
                        local count = #visualCandidates
                        if onScreen and (count < budget.espLimit or distance < visualCandidates[count].distance) then
                            local at = count + 1
                            while at > 1 and visualCandidates[at - 1].distance > distance do at = at - 1 end
                            table.insert(visualCandidates, at, {player = other, character = character, head = head, distance = distance})
                            if #visualCandidates > budget.espLimit then table.remove(visualCandidates) end
                        end
                    end
                end
            end
        end
    end
    hitboxes:Retain(wantedHeads)
    local keep = {}
    -- Only nearby on-screen targets allocate Highlight/Billboard objects.
    for _, item in ipairs(visualCandidates) do
        local other, head = item.player, item.head
        keep[other] = true
        local record = records[other]
        if record and (record.character ~= item.character or record.head ~= head) then
            destroyRecord(other)
            record = nil
        end
        if not record then
            record = {character = item.character, head = head}
            records[other] = record
        end
        syncRecordObjects(record, other)
        local color = Shared.SameTeam(player, other) and C.friend or C.enemy
        if record.highlight then
            setProperty(record.highlight, "FillColor", color)
            setProperty(record.highlight, "OutlineColor", color)
            setProperty(record.highlight, "Enabled", true)
        end
        if record.billboard then
            setProperty(record.billboard, "Enabled", true)
            setProperty(record.billboard, "MaxDistance", settings.MaxDistance)
            setProperty(record.billboard, "StudsOffsetWorldSpace", Vector3.new(0, head.Size.Y / 2 + 1.5, 0))
            setProperty(record.name, "TextColor3", color)
            setProperty(record.name, "TextSize", math.floor(math.clamp(16 - item.distance / 160, 10, 16)))
            setProperty(record.distance, "Text", string.format("%d studs", math.floor(item.distance + 0.5)))
        end
        if record.box then
            setProperty(record.box, "Size", head.Size)
            setProperty(record.box, "Visible", settings.Hitbox and settings.HeadScale > 1)
        end
    end
    for other in pairs(records) do if not keep[other] then destroyRecord(other) end end
end

local viewParams = RaycastParams.new()
viewParams.FilterType = Enum.RaycastFilterType.Exclude
viewParams.IgnoreWater = true
local movementParams = RaycastParams.new()
movementParams.FilterType = Enum.RaycastFilterType.Exclude
movementParams.IgnoreWater = true
movementParams.RespectCanCollide = true

local function hasSight(other, camera, character, head)
    if not settings.WallCheck then return true end
    local now = os.clock()
    local cached = sightCache[other]
    if cached and cached.character == character and now - cached.at < budget.aimInterval then
        return cached.visible
    end
    viewParams.FilterDescendantsInstances = player.Character and {player.Character} or {}
    local hit = workspace:Raycast(camera.CFrame.Position, head.Position - camera.CFrame.Position, viewParams)
    local visible = not hit or hit.Instance:IsDescendantOf(character)
    sightCache[other] = {character = character, at = now, visible = visible}
    return visible
end

local function validTarget(other, camera, localRoot, requireFOV)
    if not other or other.Parent ~= Players or not Shared.IsTarget(player, other, settings) then return nil end
    local character, humanoid, root, head = Shared.Alive(other)
    if not character or character:FindFirstChildOfClass("ForceField") then return nil end
    if (root.Position - localRoot.Position).Magnitude > settings.MaxDistance then return nil end
    local screen, onScreen = camera:WorldToViewportPoint(head.Position)
    local distance = (Vector2.new(screen.X, screen.Y) - camera.ViewportSize / 2).Magnitude
    if requireFOV and (not onScreen or screen.Z <= 0 or distance > settings.AimFOV) then return nil end
    return head, root, distance, humanoid
end

local aimScanCursor = 1
local function chooseTarget(camera, localRoot)
    -- Keep the current target while it remains eligible, avoiding jumps between heads.
    local currentHead = target and validTarget(target, camera, localRoot, true)
    if currentHead and hasSight(target, camera, target.Character, currentHead) then return target end
    table.clear(aimCandidates)
    for _, other in ipairs(playerList) do
        if other ~= player then
            local head, _, distance = validTarget(other, camera, localRoot, true)
            if head then table.insert(aimCandidates, {player = other, head = head, distance = distance}) end
        end
    end
    table.sort(aimCandidates, function(a, b) return a.distance < b.distance end)
    local count = #aimCandidates
    if count == 0 then aimScanCursor = 1 return nil end
    -- Rotate through candidates so occluded near targets don't permanently starve others.
    aimScanCursor = math.min(aimScanCursor, count)
    local checks = math.min(count, budget.aimChecks)
    for offset = 0, checks - 1 do
        local index = ((aimScanCursor + offset - 1) % count) + 1
        local candidate = aimCandidates[index]
        if hasSight(candidate.player, camera, candidate.player.Character, candidate.head) then
            aimScanCursor = 1
            return candidate.player
        end
    end
    aimScanCursor = ((aimScanCursor + checks - 1) % count) + 1
    return nil
end

