local SHARED_SOURCE = [====[
-- Shared setting schema and targeting rules. No external modules or assets.
local Shared = {}
Shared.Version = "1.1.0"
Shared.Schema = {
    ESP = {default = false, kind = "boolean"},
    Names = {default = true, kind = "boolean"},
    TeamCheck = {default = true, kind = "boolean"},
    Aim = {default = false, kind = "boolean"},
    WallCheck = {default = true, kind = "boolean"},
    AimFOV = {default = 130, kind = "number", min = 40, max = 350, step = 10},
    AimSmooth = {default = 12, kind = "number", min = 2, max = 30, step = 2},
    Hitbox = {default = false, kind = "boolean"},
    HeadScale = {default = 2, kind = "number", min = 1, max = 4, step = 0.25},
    Speed = {default = false, kind = "boolean"},
    WalkSpeed = {default = 32, kind = "number", min = 8, max = 100, step = 4},
    Spin = {default = false, kind = "boolean"},
    SpinRate = {default = 360, kind = "number", min = 60, max = 1440, step = 60},
    Strafe = {default = false, kind = "boolean"},
    StrafeRadius = {default = 10, kind = "number", min = 5, max = 30, step = 1},
    StrafeClockwise = {default = true, kind = "boolean"},
    MaxDistance = {default = 1000, kind = "number", min = 100, max = 3000, step = 100},
}

function Shared.Defaults()
    local result = {}
    for key, rule in pairs(Shared.Schema) do
        result[key] = rule.default
    end
    return result
end

function Shared.Validate(key, value)
    if type(key) ~= "string" then return nil end
    local rule = Shared.Schema[key]
    if not rule or type(value) ~= rule.kind then return nil end
    if rule.kind == "boolean" then return value end
    -- NaN and infinities must be rejected before rounding/clamping.
    if value ~= value or value == math.huge or value == -math.huge then return nil end
    value = math.max(rule.min, math.min(rule.max, value))
    value = rule.min + math.floor((value - rule.min) / rule.step + 0.5) * rule.step
    return math.max(rule.min, math.min(rule.max, value))
end

function Shared.SameTeam(a, b)
    -- Two neutral players are opponents, even though both Team properties may be nil.
    return a ~= nil and b ~= nil and not a.Neutral and not b.Neutral
        and a.Team ~= nil and a.Team == b.Team
end

function Shared.IsTarget(viewer, other, settings)
    return other ~= viewer and (not settings.TeamCheck or not Shared.SameTeam(viewer, other))
end

function Shared.DeviceProfile(touch, keyboard, preferred)
    -- PreferredInput handles touch laptops and phones with external keyboards.
    local mobile = preferred == "Touch"
        or (preferred ~= "KeyboardAndMouse" and touch and not keyboard)
    return {
        mobile = mobile, label = mobile and "Script\\mobile" or "Script\\PC",
        espLimit = mobile and 16 or 30, espInterval = mobile and 0.3 or 0.2,
        aimInterval = mobile and 0.14 or 0.08, aimChecks = mobile and 4 or 8,
        probeInterval = mobile and 0.08 or 0.04,
    }
end

function Shared.PerformanceBudget(profile, reduced)
    if profile.mobile and reduced then
        return {espLimit = 8, espInterval = 0.5, aimInterval = 0.2,
            aimChecks = 3, probeInterval = 0.1}
    end
    return profile
end

function Shared.ClampPanel(x, y, width, height, viewX, viewY, insetX, insetY)
    local minX, minY = insetX + 6, insetY + 6
    return math.max(minX, math.min(math.max(minX, viewX - width - 6), x)),
        math.max(minY, math.min(math.max(minY, viewY - height - 6), y))
end

local rigs = setmetatable({}, {__mode = "k"})
function Shared.Alive(player)
    local character = player and player.Character
    if not character or not character.Parent then return nil end
    local rig = rigs[player]
    if not rig or rig.character ~= character or rig.humanoid.Parent ~= character
        or rig.root.Parent ~= character or rig.head.Parent ~= character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local root = character:FindFirstChild("HumanoidRootPart")
        local head = character:FindFirstChild("Head")
        if not humanoid or not root or not root:IsA("BasePart") or not head
            or not head:IsA("BasePart") then return nil end
        rig = {character = character, humanoid = humanoid, root = root, head = head}
        rigs[player] = rig
    end
    local humanoid, root, head = rig.humanoid, rig.root, rig.head
    if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart")
        or not head or not head:IsA("BasePart") then return nil end
    return character, humanoid, root, head
end

return Shared
]====]

local SERVER_SOURCE = [====[
-- MOD MENU 1.1.0 | Put this Script in ServerScriptService.
-- Children: Config (ModuleScript), Shared (ModuleScript), Client (LocalScript).
-- Settings are validated here. Head geometry is modified ONLY on each viewer's client.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(script:WaitForChild("Config"))
local Shared = require(script:WaitForChild("Shared"))
local clientTemplate = script:WaitForChild("Client")

-- Refuse a duplicate installation instead of destroying another running instance.
if ReplicatedStorage:FindFirstChild(Config.RuntimeName) then
    warn("[MOD MENU] Duplicate runtime. Keep only one OwnGameModMenuServer Script.")
    return
end

local runtime = Instance.new("Folder")
runtime.Name = Config.RuntimeName
runtime:SetAttribute("Version", Shared.Version)
local sharedCopy = script.Shared:Clone()
sharedCopy.Name = "Shared"
sharedCopy.Parent = runtime
local request = Instance.new("RemoteEvent")
request.Name = "Request"
request.Parent = runtime
local update = Instance.new("RemoteEvent")
update.Name = "Update"
update.Parent = runtime
runtime.Parent = ReplicatedStorage

local states, connections = {}, {}
local stopped = false

local function allowed(player)
    return (Config.AllowAllStudioTestPlayers and RunService:IsStudio())
        or Config.AdminUserIds[player.UserId] == true
        or (Config.AllowPersonalPlaceOwner and game.CreatorType == Enum.CreatorType.User
            and player.UserId == game.CreatorId)
end

local function sendState(player)
    local state = states[player]
    if state and player.Parent == Players then
        update:FireClient(player, state.settings)
    end
end

local function restoreMovement(state)
    local effect = state.movement
    if not effect then return end
    if effect.humanoid.Parent then
        if effect.speedBefore ~= nil then effect.humanoid.WalkSpeed = effect.speedBefore end
        if effect.rotateBefore ~= nil then effect.humanoid.AutoRotate = effect.rotateBefore end
    end
    state.movement = nil
end

local function applyMovement(player, state)
    local _, humanoid, root = Shared.Alive(player)
    local effect = state.movement
    if effect and effect.humanoid ~= humanoid then
        restoreMovement(state)
        effect = nil
    end
    if not humanoid then return end
    if not effect then
        effect = {humanoid = humanoid}
        state.movement = effect
    end
    if state.settings.Speed then
        if effect.speedBefore == nil then effect.speedBefore = humanoid.WalkSpeed end
        if humanoid.WalkSpeed ~= state.settings.WalkSpeed then
            humanoid.WalkSpeed = state.settings.WalkSpeed
        end
    elseif effect.speedBefore ~= nil then
        humanoid.WalkSpeed = effect.speedBefore
        effect.speedBefore = nil
    end
    local canSpin = state.settings.Spin and not humanoid.Sit
        and not humanoid.PlatformStand and not root.Anchored
    if canSpin then
        if effect.rotateBefore == nil then effect.rotateBefore = humanoid.AutoRotate end
        humanoid.AutoRotate = false
    elseif effect.rotateBefore ~= nil then
        humanoid.AutoRotate = effect.rotateBefore
        effect.rotateBefore = nil
    end
end

local function grant(player)
    if stopped or states[player] or not allowed(player) then return end
    local state = {settings = Shared.Defaults(), tokens = 24, lastRequest = os.clock()}
    states[player] = state
    task.spawn(function()
        local playerGui = player:WaitForChild("PlayerGui", 20)
        if not playerGui or stopped or states[player] ~= state or player.Parent ~= Players then return end
        local existing = playerGui:FindFirstChild(Config.GuiName)
        if existing then
            warn("[MOD MENU] A GUI with the configured name already exists for " .. player.Name)
            return
        end
        local gui = Instance.new("ScreenGui")
        gui.Name = Config.GuiName
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        gui.ScreenInsets = Enum.ScreenInsets.None
        gui.DisplayOrder = 70
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        gui:SetAttribute("RuntimeName", Config.RuntimeName)
        local client = clientTemplate:Clone()
        client.Enabled = true
        client.Parent = gui
        state.gui = gui
        gui.Parent = playerGui
    end)
end

local function revoke(player)
    local state = states[player]
    if not state then return end
    restoreMovement(state)
    if state.gui then state.gui:Destroy() end
    states[player] = nil
end

table.insert(connections, request.OnServerEvent:Connect(function(player, action, key, value)
    local state = states[player]
    if not state or not allowed(player) then return end
    local now = os.clock()
    state.tokens = math.min(24, state.tokens + (now - state.lastRequest) * 12)
    state.lastRequest = now
    if state.tokens < 1 then return end
    state.tokens = state.tokens - 1
    if action == "Sync" then
        sendState(player)
    elseif action == "Set" then
        local clean = Shared.Validate(key, value)
        if clean == nil then return end
        state.settings[key] = clean
        applyMovement(player, state)
        sendState(player)
    elseif action == "Stop" then
        for name, rule in pairs(Shared.Schema) do
            if rule.kind == "boolean" and name ~= "TeamCheck" and name ~= "Names"
                and name ~= "WallCheck" and name ~= "StrafeClockwise" then
                state.settings[name] = false
            end
        end
        restoreMovement(state)
        sendState(player)
    end
end))

table.insert(connections, Players.PlayerAdded:Connect(grant))
table.insert(connections, Players.PlayerRemoving:Connect(function(player)
    revoke(player)
end))
for _, player in ipairs(Players:GetPlayers()) do grant(player) end

local elapsed = 0
table.insert(connections, RunService.Heartbeat:Connect(function(dt)
    elapsed = elapsed + dt
    if elapsed < 0.2 then return end
    elapsed = 0
    for player, state in pairs(states) do
        if player.Parent ~= Players or not allowed(player) then
            revoke(player)
        else
            applyMovement(player, state)
        end
    end
end))

local function cleanup()
    if stopped then return end
    stopped = true
    for _, connection in ipairs(connections) do connection:Disconnect() end
    for player in pairs(states) do revoke(player) end
    runtime:Destroy()
end
script.Destroying:Connect(cleanup)
game:BindToClose(cleanup)
print("[MOD MENU] v" .. Shared.Version .. " ready. RightShift = menu, RMB/L2 = aim, End = stop.")
]====]

