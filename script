local function syncHighlights(wanted, limit)
    local wantedSet = {}
    for _, entry in ipairs(wanted) do wantedSet[entry] = true end
    for _, slot in ipairs(highlightPool) do
        if slot.entry and not wantedSet[slot.entry] then releaseHighlight(slot.entry) end
    end
    while #highlightPool > limit do
        local slot = table.remove(highlightPool)
        if slot.entry then slot.entry.highlight = nil end
        slot.object:Destroy()
    end
    for _, entry in ipairs(wanted) do
        if not entry.highlight then
            local free
            for _, slot in ipairs(highlightPool) do
                if not slot.entry then free = slot; break end
            end
            if not free and #highlightPool < limit then
                free = { object = make("Highlight", {
                    Name = "OutlineSlot" .. (#highlightPool + 1), Enabled = false,
                    FillTransparency = 1, OutlineTransparency = 0,
                }, highlightFolder) }
                table.insert(highlightPool, free)
            end
            if free then
                free.entry = entry
                entry.highlight = free.object
                free.object.Adornee = entry.character
            end
        end
        if entry.highlight then
            set(entry.highlight, "OutlineColor", settings.Color)
            set(entry.highlight, "DepthMode", settings.ThroughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded)
            set(entry.highlight, "Enabled", true)
        end
    end
end
local function alive(entry)
    return not entry.removed and entry.player.Character == entry.character
        and entry.root and entry.root:IsDescendantOf(Workspace)
        and entry.humanoid and entry.humanoid.Parent and entry.humanoid.Health > 0
end
local loadedCount, totalCount = 0, 0
local function refreshTargets(camera, origin)
    local candidates, wanted = {}, {}
    loadedCount, totalCount = 0, 0
    for player, entry in pairs(tracked) do
        totalCount = totalCount + 1
        local character = player.Character
        if entry.character ~= character then
            releaseHighlight(entry)
            entry.character = character
            entry.clear, entry.nextLabel, entry.nextRay = nil, 0, 0
            local old = character and character:FindFirstChild("ClientPlayerOutline")
            if old and old:IsA("Highlight") then old:Destroy() end
        end
        entry.root = character and character:FindFirstChild("HumanoidRootPart")
        if entry.root and not entry.root:IsA("BasePart") then entry.root = nil end
        entry.head = character and character:FindFirstChild("Head")
        entry.humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if alive(entry) then
            loadedCount = loadedCount + 1
            entry.distance = (entry.root.Position - origin).Magnitude
            local target = entry.head and entry.head:IsA("BasePart") and entry.head.Position or entry.root.Position
            local point, onScreen = camera:WorldToViewportPoint(target)
            if settings.Enabled and onScreen and point.Z > 0 then table.insert(candidates, entry) end
        end
    end
    table.sort(candidates, function(a, b)
        if a.distance == b.distance then return a.player.UserId < b.player.UserId end
        return a.distance < b.distance
    end)
    local selected = {}
    active = {}
    local markerLimit = settings.LiteMode and 24 or 64
    local outlineLimit = settings.LiteMode and 6 or 16
    for i = 1, math.min(#candidates, markerLimit) do
        local entry = candidates[i]
        active[#active + 1] = entry
        selected[entry] = true
        if settings.Outlines and entry.distance < settings.FarDistance and #wanted < outlineLimit then
            wanted[#wanted + 1] = entry
        end
    end
    for _, entry in pairs(tracked) do if not selected[entry] then hide(entry) end end
    syncHighlights(wanted, outlineLimit)
    if panel.Visible then
        set(status, "Text", (settings.LiteMode and "LITE" or "FULL") .. " · меток " .. #active .. " · игроков " .. loadedCount .. "/" .. totalCount)
    end
end
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
local lastCamera, filterCamera, filterCharacter
local now, frameElapsed, nextScan = 0, 0, 0
local previousEnabled = true
local function hideAll()
    for _, entry in pairs(tracked) do hide(entry) end
    syncHighlights({}, settings.LiteMode and 6 or 16)
end
local function render(deltaTime)
    if stopped then return end
    now, frameElapsed = now + deltaTime, frameElapsed + deltaTime
    if not settings.Enabled then
        if previousEnabled or dirty then hideAll(); dirty = false end
        previousEnabled = false
        return
    end
    if not previousEnabled then dirty = true; previousEnabled = true end
    local camera = Workspace.CurrentCamera
    if camera ~= lastCamera then
        lastCamera = camera
        dirty = true
        for _, entry in pairs(tracked) do entry.clear = nil end
        if not camera then hideAll() end
    end
    if not camera then return end
    local interval = settings.LiteMode and 1 / 20 or 1 / 30
    if not dirty and frameElapsed + 0.000001 < interval then return end
    frameElapsed = frameElapsed % interval
    local character = localPlayer.Character
    local selfRoot = character and character:FindFirstChild("HumanoidRootPart")
    local origin = selfRoot and selfRoot.Position or camera.CFrame.Position
    if dirty or now >= nextScan then
        refreshTargets(camera, origin)
        nextScan = now + (settings.LiteMode and 0.35 or 0.2)
        dirty = false
    end
    if camera ~= filterCamera or character ~= filterCharacter then
        filterCamera, filterCharacter = camera, character
        local exclude = { camera, highlightFolder }
        if character then exclude[#exclude + 1] = character end
        rayParams.FilterDescendantsInstances = exclude
    end
    local viewport = camera.ViewportSize
    local lineStart = Vector2.new(viewport.X * 0.5, viewport.Y - (mobile and 64 or 24))
    local occupied, labelCount = {}, 0
    local labelLimit = settings.LiteMode and 6 or 14
    for _, entry in ipairs(active) do
        if not alive(entry) then
            if not entry.removed then hide(entry); releaseHighlight(entry) end
            dirty = true
        else
            local targetPosition = entry.head and entry.head.Parent == entry.character and entry.head.Position or entry.root.Position
            local point, onScreen = camera:WorldToViewportPoint(targetPosition)
            local visible = onScreen and point.Z > 0
            if visible and not settings.ThroughWalls then
                if now >= entry.nextRay or entry.clear == nil then
                    local hit = Workspace:Raycast(camera.CFrame.Position, targetPosition - camera.CFrame.Position, rayParams)
                    entry.clear = not hit or hit.Instance:IsDescendantOf(entry.character)
                    entry.nextRay = now + (settings.LiteMode and 0.25 or 0.15)
                end
                visible = entry.clear == true
            end
            local distance = (entry.root.Position - origin).Magnitude
            -- In Lite mode, dots also cover nearby players outside the outline budget.
            local showDot = settings.FarDots and (distance >= settings.FarDistance or (settings.Outlines and not entry.highlight))
            local showLabel = false
            if visible and settings.Labels and labelCount < labelLimit
                and (not settings.LiteMode or distance <= 750) then
                -- Put our small label below/to the side of the built-in name tag.
                local width, height = math.min(154, viewport.X), 30
                local x = math.clamp(point.X + 12, 0, math.max(0, viewport.X - width))
                local y = math.clamp(point.Y + 12, 0, math.max(0, viewport.Y - height))
                local overlaps = false
                for _, box in ipairs(occupied) do
                    if x < box.x + width + 4 and x + width + 4 > box.x
                        and y < box.y + height + 4 and y + height + 4 > box.y then overlaps = true; break end
                end
                if not overlaps then
                    occupied[#occupied + 1] = { x = x, y = y }
                    labelCount = labelCount + 1
                    showLabel = true
                    set(entry.label, "Position", UDim2.fromOffset(x, y))
                    if now >= entry.nextLabel then
                        set(entry.label, "Text", entry.player.DisplayName .. "\n" .. math.floor(distance + 0.5) .. " studs")
                        entry.nextLabel = now + (settings.LiteMode and 0.5 or 0.25)
                    end
                end
            end
            set(entry.gui, "Visible", visible and (showDot or settings.Tracers or showLabel))
            set(entry.label, "Visible", showLabel)
            if visible then
                set(entry.dot, "Visible", showDot)
                if showDot then set(entry.dot, "Position", UDim2.fromOffset(point.X, point.Y)) end
                set(entry.line, "Visible", settings.Tracers)
                if settings.Tracers then
                    local target = Vector2.new(point.X, point.Y)
                    local delta, midpoint = target - lineStart, (target + lineStart) * 0.5
                    set(entry.line, "Position", UDim2.fromOffset(midpoint.X, midpoint.Y))
                    set(entry.line, "Size", UDim2.fromOffset(delta.Magnitude, 1))
                    set(entry.line, "Rotation", math.deg(math.atan2(delta.Y, delta.X)))
                end
            end
        end
    end
end
cleanup = function()
    if stopped then return end
    stopped = true
    RunService:UnbindFromRenderStep(RENDER_NAME)
    for _, connection in ipairs(connections) do connection:Disconnect() end
    drag = nil
    active, tracked, highlightPool = {}, {}, {}
    highlightFolder:Destroy()
    overlayGui:Destroy()
    menuGui:Destroy()
end
connect(shutdown.Event, cleanup)
connect(menuGui.Destroying, cleanup)
if typeof(script) == "Instance" then connect(script.Destroying, cleanup) end
RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Camera.Value + 1, render)
