local function aimStep(dt)
    if dead then return end
    local camera = workspace.CurrentCamera
    local _, humanoid, root = Shared.Alive(player)
    local using = camera and root and not humanoid.Sit and not humanoid.PlatformStand
        and camera.CameraType ~= Enum.CameraType.Scriptable and engaged()
    if using then
        targetTimer = targetTimer + dt
        if targetTimer >= budget.aimInterval then
            targetTimer = 0
            target = chooseTarget(camera, root)
            if settings.Strafe and not orbitTarget then orbitTarget = target end
        end
        local head = target and validTarget(target, camera, root, true)
        if head and settings.Aim then
            local delta = head.Position - camera.CFrame.Position
            if delta.Magnitude > 0.01 then
                local goal = CFrame.lookAt(camera.CFrame.Position, head.Position)
                camera.CFrame = camera.CFrame:Lerp(goal, 1 - math.exp(-settings.AimSmooth * math.min(dt, 0.1)))
            end
        end
    else
        target, orbitTarget = nil, nil
        targetTimer = 1
    end
    setProperty(fovCircle, "Visible", ready and settings.Aim and not panel.Visible and root ~= nil)
    setProperty(crosshair, "Visible", fovCircle.Visible)
    setProperty(fovStroke, "Color", target and C.friend or C.active)
    setProperty(aimButton, "Text", using and "AIM\nACTIVE" or "AIM\nREADY")
    setProperty(aimButton, "BackgroundColor3", using and C.active or C.card)
end

local nextProbe, probeAllowed, probeTarget = 0, false, nil
local function stopStrafe()
    if lastStrafeHumanoid and lastStrafeHumanoid.Parent then
        lastStrafeHumanoid:Move(Vector3.zero, false)
    end
    lastStrafeHumanoid = nil
    nextProbe, probeAllowed, probeTarget = 0, false, nil
end

local function movementStep(dt)
    if dead then return end
    if not settings.Spin and (not settings.Strafe or not engaged()) then
        stopStrafe()
        return
    end
    local character, humanoid, root = Shared.Alive(player)
    local camera = workspace.CurrentCamera
    if not root or not camera or humanoid.Sit or humanoid.PlatformStand or root.Anchored then
        stopStrafe()
        return
    end
    if settings.Spin and ready then
        root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(settings.SpinRate) * math.min(dt, 0.1), 0)
    end
    if not settings.Strafe or not engaged() or camera.CameraType == Enum.CameraType.Scriptable then
        stopStrafe()
        orbitTarget = nil
        return
    end
    local _, otherRoot = validTarget(orbitTarget, camera, root, false)
    if not otherRoot then
        orbitTarget = target
        _, otherRoot = validTarget(orbitTarget, camera, root, false)
    end
    if not otherRoot or (otherRoot.Position - root.Position).Magnitude > 120 then
        stopStrafe()
        return
    end
    local offset = root.Position - otherRoot.Position
    local flat = Vector3.new(offset.X, 0, offset.Z)
    local distance = flat.Magnitude
    if distance < 0.05 then flat, distance = Vector3.new(1, 0, 0), 1 end
    local radial = flat / distance
    local tangent = Vector3.new(-radial.Z, 0, radial.X) * (settings.StrafeClockwise and 1 or -1)
    local correction = math.clamp((settings.StrafeRadius - distance) / 3, -2, 2)
    local direction = (tangent + radial * correction).Unit
    local now = os.clock()
    if now >= nextProbe or probeTarget ~= orbitTarget then
        nextProbe, probeTarget = now + budget.probeInterval, orbitTarget
        movementParams.FilterDescendantsInstances = {character}
        -- Probe ahead of the distance covered before the next scheduled check.
        local lookAhead = math.clamp(humanoid.WalkSpeed * (budget.probeInterval + 0.1), 2.5, 24)
        local obstacle = workspace:Raycast(root.Position, direction * lookAhead, movementParams)
        local ground = workspace:Raycast(root.Position + direction * lookAhead, Vector3.new(0, -9, 0), movementParams)
        local _, _, _, otherHead = Shared.Alive(orbitTarget)
        probeAllowed = not obstacle and ground ~= nil and otherHead ~= nil
            and hasSight(orbitTarget, camera, orbitTarget.Character, otherHead)
    end
    if not probeAllowed then direction = Vector3.zero end
    humanoid:Move(direction, false)
    lastStrafeHumanoid = humanoid
end

local aimBound, movementBound = false, false
updateBindings = function()
    local wantAim = ready and (settings.Aim or settings.Strafe)
    local wantMovement = ready and (settings.Spin or settings.Strafe)
    if wantAim and not aimBound then
        RunService:BindToRenderStep(rootName .. "Aim", Enum.RenderPriority.Camera.Value + 1, aimStep)
    elseif not wantAim and aimBound then
        RunService:UnbindFromRenderStep(rootName .. "Aim")
    end
    if wantMovement and not movementBound then
        RunService:BindToRenderStep(rootName .. "Movement", Enum.RenderPriority.Character.Value + 1, movementStep)
    elseif not wantMovement and movementBound then
        RunService:UnbindFromRenderStep(rootName .. "Movement")
        stopStrafe()
    end
    aimBound, movementBound = wantAim, wantMovement
    if not wantAim then
        fovCircle.Visible, crosshair.Visible = false, false
        aimButton.Text, aimButton.BackgroundColor3 = "AIM\nOFF", C.card
    end
end

local fpsFrames, fpsTime = 0, 0

connect(RunService.Heartbeat, function(dt)
    if dead then return end
    if profile.mobile and (settings.ESP or settings.Hitbox or settings.Aim or settings.Strafe) then
        fpsFrames, fpsTime = fpsFrames + 1, fpsTime + dt
        if fpsTime >= 1.5 then
            local fps = fpsFrames / fpsTime
            local nextReduced = reduced
            if fps < 28 then nextReduced = true elseif fps > 40 then nextReduced = false end
            if nextReduced ~= reduced then
                reduced = nextReduced
                budget = Shared.PerformanceBudget(profile, reduced)
            end
            fpsFrames, fpsTime = 0, 0
        end
    else
        fpsFrames, fpsTime = 0, 0
    end
    espTimer = espTimer + dt
    if espTimer < budget.espInterval then return end
    espTimer = 0
    if settings.ESP or settings.Hitbox or next(records) ~= nil then updateESP() end
    if ready then
        if panel.Visible then
            setProperty(status, "Text", profile.mobile and ("AIM — захват цели · v" .. Shared.Version)
                or ("Right Shift — меню · End — стоп · v" .. Shared.Version))
        elseif orbitTarget and settings.Strafe then
            setProperty(status, "Text", "Strafe: " .. orbitTarget.DisplayName)
        else
            setProperty(status, "Text", target and ("Цель: " .. target.DisplayName) or "ПКМ / L2 / AIM — захват цели")
        end
    end
end)

local function cleanup()
    if dead then return end
    dead = true
    RunService:UnbindFromRenderStep(rootName .. "Aim")
    RunService:UnbindFromRenderStep(rootName .. "Movement")
    CAS:UnbindAction(rootName .. "ToggleMenu")
    stopDrag()
    stopStrafe()
    hitboxes:Clear()
    for _, connection in ipairs(connections) do connection:Disconnect() end
    if cameraConnection then cameraConnection:Disconnect() end
    visuals:Destroy()
    -- Also restores server effects when the UI is manually removed during a Studio test.
    if ready and runtime.Parent then request:FireServer("Stop") end
end
gui.Destroying:Connect(cleanup)
script.Destroying:Connect(cleanup)

-- Retry handshake if a slow client joined while replication was still settling.
task.spawn(function()
    while not ready and not dead and runtime.Parent do
        request:FireServer("Sync")
        task.wait(1)
    end
end)
