            local distance = (root.Position - targetRoot.Position).Magnitude
            if distance > 7 then
                status(string.format("Attack: %.1f studs away; move within 7 studs", distance)) return
            end
            local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
            local knife
            for _, holder in ipairs({char, backpack}) do
                if holder then
                    for _, item in ipairs(holder:GetChildren()) do
                        if item:IsA("Tool") and item.Name:lower():find("knife", 1, true) then
                            knife = item break
                        end
                    end
                end
                if knife then break end
            end
            if not knife then status("Attack: knife not found") return end
            if knife.Parent ~= char then
