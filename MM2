local function unload()
    if state.unloaded then
        return
    end
    state.unloaded = true

    setSpeedToggle(false)
    setJumpToggle(false)
    setNoclipToggle(false)
    setFlyToggle(false)
    setInfiniteToggle(false)
    setFullBrightToggle(false)
    setGravityToggle(false)
    setSpinToggle(false)
    setBunnyToggle(false)
    setStrafeToggle(false)
    setESPToggle(false)
    setRoleESPToggle(false)
    setInnocentESPToggle(false)
    setESPLinesToggle(false)

    stopFly()
    restoreNoclip()
    clearESP()
    disableFullBright()
    Workspace.Gravity = savedGravity

    local humanoid = getHumanoid()
    if humanoid then
        humanoid.WalkSpeed = CONFIG.DefaultWalkSpeed
        humanoid.UseJumpPower = true
        humanoid.JumpPower = CONFIG.DefaultJumpPower
    end

    local camera = Workspace.CurrentCamera
    if camera then
        camera.FieldOfView = CONFIG.DefaultFOV
    end

    disconnectBucket(characterConnections)
    disconnectBucket(connections)

    if ESPOverlay then
        pcall(function()
            ESPOverlay:Destroy()
        end)
    end

    if ScriptMM2 then
        pcall(function()
            ScriptMM2:Destroy()
        end)
    end
end

