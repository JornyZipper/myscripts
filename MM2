    if not auto then
        auto = {}
        Silent.gunAuto = auto
        function auto.reset(resetLatency)
            auto.motion, auto.leadSeconds = nil, 0
            if resetLatency then auto.network = nil end
        end

        function auto.networkDelay(at)
            local network = auto.network
            if not network then
                network = {nextAt = 0, samples = {}}
                auto.network = network
            end
            if at >= network.nextAt then
                local dt = network.polledAt and math.max(0, at - network.polledAt) or 0
                network.polledAt, network.nextAt = at, at + 0.25
                local ok, rtt = pcall(function() return LocalPlayer:GetNetworkPing() end)
                if ok and type(rtt) == "number" and rtt == rtt and rtt >= 0 and rtt < math.huge then
                    -- LocalPlayer's API reports round-trip seconds; never multiply it by two.
                    -- Keep measurements above 200 ms; bound the resulting aim offset separately.
                    rtt = math.clamp(rtt, 0, 2)
                    local fresh = network.goodAt and at - network.goodAt <= 3
                    if not fresh then
                        table.clear(network.samples)
                        network.rtt, network.jitter = rtt, 0
                    end
                    network.latestRtt, network.pingMs = rtt, rtt * 1000
                    table.insert(network.samples, rtt)
                    if #network.samples > 3 then table.remove(network.samples, 1) end
                    local sorted = table.clone(network.samples)
                    table.sort(sorted)
                    -- One isolated spike cannot move the baseline; a sustained change can.
                    local median = sorted[math.ceil(#sorted / 2)]
                    if fresh then
                        network.rtt += (median - network.rtt) * (1 - math.exp(-dt / 0.30))
                        network.jitter += (math.abs(rtt - median) - network.jitter)
                            * (1 - math.exp(-dt / 0.60))
                    end
                    network.goodAt = at
