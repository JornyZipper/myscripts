UIRefs.reloadStop.Parent = UIRefs.ScriptMM2

--// Travel: explicit spawn markers only. Never choose a random floor or another player.
do
    local function normalized(name)
        return string.lower(name):gsub("[^%w]", "")
    end

    local mapContainerNames = {
        map = true, currentmap = true, activemap = true,
        roundmap = true, gamemap = true,
    }
    local lobbyContainerNames = {
        lobby = true, mainlobby = true, lobbymap = true,
    }
    local mapSpawnNames = {
        spawn = true, spawnpoint = true, playerspawn = true,
        playerspawnpoint = true, mapspawn = true, mapspawnpoint = true,
        gamespawn = true, roundspawn = true, spawnlocation = true,
    }
    local lobbySpawnNames = {
        lobbyspawn = true, lobbyspawnpoint = true,
        spawnlobby = true, lobbyspawnlocation = true,
        spawn = true, spawnpoint = true, playerspawn = true,
        playerspawnpoint = true, spawnlocation = true,
    }
    local spawnFolderNames = {
        spawns = true, spawnpoints = true, spawnlocations = true,
        playerspawns = true, playerspawnpoints = true,
    }
    local forbiddenSpawnNames = {
        coinspawn = true, gunspawn = true, knifespawn = true,
        itemspawn = true, weapons = true, weaponspawn = true,
        dropspawn = true, coins = true, spectator = true,
    }

    local function findTopLevel(names)
        for _, item in ipairs(Workspace:GetChildren()) do
            if (item:IsA("Model") or item:IsA("Folder")) and names[normalized(item.Name)] then
                return item
            end
        end
        return nil
    end

    local function isSpawnPart(part, kind, withinNamedContainer)
        if not part:IsA("BasePart") then return false end
        local partName = normalized(part.Name)
        if forbiddenSpawnNames[partName] then return false end
        if kind == "lobby" and not withinNamedContainer then
            -- Never select a generic Workspace.Spawn; it could belong to the map.
            return partName == "lobbyspawn" or partName == "lobbyspawnpoint"
                or partName == "spawnlobby" or partName == "lobbyspawnlocation"
        end
        local names = kind == "map" and mapSpawnNames or lobbySpawnNames
        if names[partName] then return true end
        -- Some maps use arbitrary numbered SpawnLocation parts or Spawn1, Spawn2.
        if part:IsA("SpawnLocation") then return true end
        if partName:match("^spawn%d+$") or partName:match("^playerspawn%d+$") then return true end
        return false
    end

    local function containerBounds(container)
        if not container then return nil, nil end
        if container:IsA("Model") then
            local ok, cf, size = pcall(function() return container:GetBoundingBox() end)
            if ok and cf and size then return cf, size end
        end
        local minV, maxV = nil, nil
        for _, part in ipairs(container:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                local half = part.Size * 0.5
                local lo, hi = part.Position - half, part.Position + half
                minV = minV and Vector3.new(math.min(minV.X, lo.X), math.min(minV.Y, lo.Y), math.min(minV.Z, lo.Z)) or lo
                maxV = maxV and Vector3.new(math.max(maxV.X, hi.X), math.max(maxV.Y, hi.Y), math.max(maxV.Z, hi.Z)) or hi
            end
        end
        if not minV or not maxV then return nil, nil end
        local size = maxV - minV
        return CFrame.new((minV + maxV) * 0.5), size
    end

    local function findSpawn(container, kind, withinNamedContainer)
        if not container then return nil end
        local boundsCF, boundsSize = containerBounds(container)
        local topY = boundsCF and boundsSize and (boundsCF.Position.Y + boundsSize.Y * 0.5) or nil
        local candidates = {}
        for _, part in ipairs(container:GetDescendants()) do
            if isSpawnPart(part, kind, withinNamedContainer) then
                -- Do not confuse a spawn in a nested Lobby with a round spawn.
                local nestedLobby, nestedMap, excludedGroup = false, false, false
                local ancestor = part.Parent
                while ancestor and ancestor ~= container do
                    local ancestorName = normalized(ancestor.Name)
                    if lobbyContainerNames[ancestorName] then nestedLobby = true end
                    if mapContainerNames[ancestorName] then nestedMap = true end
                    if forbiddenSpawnNames[ancestorName] then excludedGroup = true end
                    ancestor = ancestor.Parent
                end
                if not excludedGroup and not (kind == "map" and nestedLobby)
                    and not (kind == "lobby" and not withinNamedContainer and nestedMap) then
                    local name = normalized(part.Name)
                    local priority = part:IsA("SpawnLocation") and 0 or 1
                    if (kind == "map" and (name == "mapspawn" or name == "playerspawn"))
                        or (kind == "lobby" and (name == "lobbyspawn" or name == "lobbyspawnpoint")) then
                        priority = -2
                    end
                    -- Generic spawns sitting near the very top of a model are commonly roof/debug spawns.
                    local roofPenalty = 0
                    if topY and boundsSize and boundsSize.Y > 12 then
                        local roofBand = topY - math.max(3, boundsSize.Y * 0.12)
                        if part.Position.Y >= roofBand then roofPenalty = 50 end
                    end
                    table.insert(candidates, {
                        part = part, priority = priority + roofPenalty,
                        y = part.Position.Y, path = part:GetFullName()
                    })
                end
            end
        end
        table.sort(candidates, function(a, b)
            if a.priority ~= b.priority then return a.priority < b.priority end
            if math.abs(a.y - b.y) > 0.1 then return a.y < b.y end
            return a.path < b.path
        end)
        return candidates[1] and candidates[1].part or nil
    end

    local function resolveTravelSpawn(kind)
        if kind == "map" then
            local activeMap = findTopLevel(mapContainerNames)
            if not activeMap then return nil, nil, "TP Map: active map model not found" end
            -- A marker is preferred, but an interior-floor fallback is allowed if the map
            -- has no trustworthy spawn marker or its only marker is on a roof.
            return findSpawn(activeMap, "map", true), activeMap
        end

        local lobby = findTopLevel(lobbyContainerNames)
        if lobby then
            return findSpawn(lobby, "lobby", true), lobby
        end
        -- Explicit global lobby markers are still supported.
        local marker = findSpawn(Workspace, "lobby", false)
        if marker then return marker, nil end
        return nil, nil, "TP Lobby: lobby model/spawn not found"
    end

    local function standingHeight(root, hum)
        return hum.HipHeight + root.Size.Y * 0.5 + 1.25
    end

    local function isLikelyRoof(container, y)
        if not container then return false end
        local cf, size = containerBounds(container)
        if not cf or not size or size.Y < 12 then return false end
        local topY = cf.Position.Y + size.Y * 0.5
        return y >= topY - math.max(3, size.Y * 0.10)
    end

    local function spawnDestination(char, root, hum, marker, container)
        if not marker then return nil end
        local stand = standingHeight(root, hum)
        local center = marker.Position
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {char, marker}
        params.IgnoreWater = true
        local hit = Workspace:Raycast(center + Vector3.new(0, 10, 0),
            Vector3.new(0, -42, 0), params)
        if hit and hit.Instance and hit.Instance.CanCollide and hit.Normal.Y >= 0.72
            and hit.Position.Y <= center.Y + marker.Size.Y * 0.5 + 3
            and hit.Position.Y >= center.Y - 20
            and (not container or hit.Instance:IsDescendantOf(container)) then
            local y = hit.Position.Y + stand
            if not isLikelyRoof(container, y) then
                return Vector3.new(center.X, y, center.Z)
            end
        end
        if marker:IsA("SpawnLocation") and marker.CanCollide and marker.Anchored then
            local y = center.Y + marker.Size.Y * 0.5 + stand
            if not isLikelyRoof(container, y) then
                return Vector3.new(center.X, y, center.Z)
            end
        end
        return nil
    end

    -- Find a walkable floor INSIDE a map/lobby model. Raycasts begin around the
    -- vertical middle of the model, not above its roof, so roof geometry is skipped.
    local function interiorDestination(char, root, hum, container)
        if not container then return nil end
        local cf, size = containerBounds(container)
        if not cf or not size or size.X < 2 or size.Z < 2 then return nil end
        local stand = standingHeight(root, hum)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {char}
        params.IgnoreWater = true
        local offsets = {
            Vector2.new(0, 0), Vector2.new(0.18, 0), Vector2.new(-0.18, 0),
            Vector2.new(0, 0.18), Vector2.new(0, -0.18),
            Vector2.new(0.32, 0.22), Vector2.new(-0.32, 0.22),
            Vector2.new(0.32, -0.22), Vector2.new(-0.32, -0.22),
        }
        local topY = cf.Position.Y + size.Y * 0.5
        local startY = math.min(topY - 3, cf.Position.Y + math.max(2, size.Y * 0.12))
        for _, off in ipairs(offsets) do
            local x = cf.Position.X + off.X * size.X
            local z = cf.Position.Z + off.Y * size.Z
            local origin = Vector3.new(x, startY, z)
            local hit = Workspace:Raycast(origin, Vector3.new(0, -math.max(45, size.Y * 0.75), 0), params)
            if hit and hit.Instance and hit.Instance.CanCollide and hit.Normal.Y >= 0.72
                and hit.Instance:IsDescendantOf(container) then
                local destination = Vector3.new(x, hit.Position.Y + stand, z)
                if not isLikelyRoof(container, destination.Y) then
                    return destination
                end
            end
        end
        return nil
    end

    local function travel(kind)
        if state.unloaded then return end
        if teleportBusy or flingBusy or shootMurdererBusy then
            UIRefs.Status.Text = "TP: stop Fling / finish weapon action first"
            return
        end
        local char, root, hum = getCharacter(), getRoot(), getHumanoid()
        if not char or not root or not hum or hum.Health <= 0 or root.Anchored or hum.Sit then
            UIRefs.Status.Text = "TP: living character required"
            return
        end
        stopRegularSpin()
        teleportBusy = true
        local ok, err = pcall(function()
            local marker, container, reason = resolveTravelSpawn(kind)
            if marker and not marker.Parent then marker = nil end
            if not marker and not container then
                UIRefs.Status.Text = reason or "TP: destination not replicated"
                return
            end
            if state.unloaded or LocalPlayer.Character ~= char or hum.Health <= 0 then return end
            local destination = marker and spawnDestination(char, root, hum, marker, container) or nil
            -- If the named spawn is on a roof / invalid, fall back to a walkable
            -- floor found from inside the replicated map or lobby bounds.
            if not destination and container then
                destination = interiorDestination(char, root, hum, container)
            end
            if not destination then
                UIRefs.Status.Text = "TP " .. kind .. ": no safe interior floor found"
                return
            end
            -- Disable movement controllers only after finding an actual spawn and landing.
            if state.coinFarm and UIRefs.setCoinFarmToggle then UIRefs.setCoinFarmToggle(false) end
            if state.fly and UIRefs.setFlyToggle then UIRefs.setFlyToggle(false) end
            clearLongJump()
            local rootToPivot = root.CFrame:ToObjectSpace(char:GetPivot())
            local desiredRoot = CFrame.new(destination) * root.CFrame.Rotation
            pauseAntiFling()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            char:PivotTo(desiredRoot * rootToPivot)
            antiFlingGuard.safePivot = char:GetPivot()
            antiFlingGuard.teleportUntil = os.clock() + CONFIG.AntiFlingTeleportGrace
            UIRefs.Status.Text = kind == "map" and "TP Map: moved inside active map"
                or "TP Lobby: moved inside lobby"
        end)
        teleportBusy = false
        if not ok then
            UIRefs.Status.Text = "TP " .. kind .. " error: " .. tostring(err)
            warn("[ScriptMM2 TP] " .. tostring(err))
        end
    end
    -- One-shot client reposition near a selected live player. No server hitbox changes.
    UIRefs.teleportToPlayer = function(player)
        if state.unloaded then return end
        if teleportBusy or flingBusy or shootMurdererBusy then
            UIRefs.Status.Text = "TP Player: stop Fling / finish weapon action first"
            return
        end
        if not player or player == LocalPlayer or player.Parent ~= Players then
            UIRefs.Status.Text = "TP Player: player unavailable"
            return
        end
        local character, root, humanoid = getCharacter(), getRoot(), getHumanoid()
        local targetCharacter = player.Character
        local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
        local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
        if not character or not root or not humanoid or humanoid.Health <= 0 or humanoid.Sit or root.Anchored then
            UIRefs.Status.Text = "TP Player: your character is not ready"
            return
        end
        if not targetRoot or not targetRoot:IsA("BasePart") or not targetHumanoid or targetHumanoid.Health <= 0 then
            UIRefs.Status.Text = "TP Player: target is not alive / loaded"
            return
        end
        stopRegularSpin()
        teleportBusy = true
        local ok, err = pcall(function()
            if state.coinFarm and UIRefs.setCoinFarmToggle then UIRefs.setCoinFarmToggle(false) end
            local offset = targetRoot.CFrame.RightVector * 5
            local proposed = targetRoot.Position + offset
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = {character, targetCharacter}
            params.IgnoreWater = true
            local hit = Workspace:Raycast(proposed + Vector3.new(0, 15, 0), Vector3.new(0, -55, 0), params)
            if not hit or not hit.Instance or not hit.Instance.CanCollide then
                UIRefs.Status.Text = "TP Player: safe ground not found near " .. player.Name
                return
            end
            if state.unloaded or player.Parent ~= Players or targetRoot.Parent ~= targetCharacter
                or targetHumanoid.Health <= 0 or LocalPlayer.Character ~= character or humanoid.Health <= 0 then
                UIRefs.Status.Text = "TP Player: character changed; cancelled"
                return
            end
            local destination = Vector3.new(proposed.X, hit.Position.Y + humanoid.HipHeight + root.Size.Y + 1.5, proposed.Z)
            local rootToPivot = root.CFrame:ToObjectSpace(character:GetPivot())
            pauseAntiFling()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            character:PivotTo((CFrame.new(destination) * root.CFrame.Rotation) * rootToPivot)
            UIRefs.Status.Text = "TP Player: moved near " .. player.DisplayName
        end)
        teleportBusy = false
        if not ok then
            UIRefs.Status.Text = "TP Player error: " .. tostring(err)
            warn("[ScriptMM2 TP Player] " .. tostring(err))
        end
    end
    addConnection(UIRefs.teleportMapButton.MouseButton1Click:Connect(function()
        task.spawn(travel, "map")
    end))
    addConnection(UIRefs.teleportLobbyButton.MouseButton1Click:Connect(function()
        task.spawn(travel, "lobby")
    end))
end

