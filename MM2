    function brand.decode(encoded)
        local data = encoded:gsub("%s", "")
        assert(#data % 4 == 0, "Invalid embedded logo length")
        local alphabet, map = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", {}
        for index = 1, #alphabet do map[alphabet:byte(index)] = index - 1 end
        local chunks, part = {}, {}
        for index = 1, #data, 4 do
            if brand.stopped then return nil end
            local a, b, c, d = data:byte(index, index + 3)
            assert(map[a] and map[b] and (map[c] or c == 61) and (map[d] or d == 61),
                "Invalid embedded logo data")
            local value = map[a] * 262144 + map[b] * 4096 + (map[c] or 0) * 64 + (map[d] or 0)
            local first = math.floor(value / 65536) % 256
            local second = math.floor(value / 256) % 256
            local third = value % 256
            part[#part + 1] = c == 61 and string.char(first)
                or d == 61 and string.char(first, second) or string.char(first, second, third)
            if #part >= 8192 then
                chunks[#chunks + 1] = table.concat(part)
                table.clear(part)
                task.wait() -- decoding never holds up the menu's initialization
            end
        end
        if #part > 0 then chunks[#chunks + 1] = table.concat(part) end
        return table.concat(chunks)
    end

    local function refresh(view)
        if brand.stopped or not view.frame.Parent then return end
        local ready = view.image.Image ~= "" and view.image.IsLoaded == true
        view.image.Visible, view.fallback.Visible = ready, not ready
    end
    local function attach(view)
        if brand.stopped or not view.frame.Parent or not brand.asset then return end
        local ok = pcall(function() view.image.Image = brand.asset end)
        if ok then refresh(view) end
    end

    function brand.make(make, parent, properties)
        local frame = make("Frame", properties, parent)
        frame.ClipsDescendants = true
        local level = properties.ZIndex or 1
        local fallback = make("TextLabel", {Name = "LogoFallback", Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1, Text = "SH", Font = Enum.Font.GothamBlack,
            TextScaled = true, TextColor3 = Color3.fromRGB(96, 48, 246), TextTransparency = 0,
            BorderSizePixel = 0, Visible = true, ZIndex = level}, frame)
        make("UIPadding", {PaddingLeft = UDim.new(0.18, 0), PaddingRight = UDim.new(0.18, 0),
            PaddingTop = UDim.new(0.18, 0), PaddingBottom = UDim.new(0.18, 0)}, fallback)
        -- Clip the emblem from the transparent 1254px square image. Relative geometry also
        -- works if the renderer downsamples the texture; the lettering is drawn separately.
        local image = make("ImageLabel", {Name = "SYDJALogo", BackgroundTransparency = 1,
            Position = UDim2.fromScale(-351 / 550, -275 / 550),
            Size = UDim2.fromScale(1254 / 550, 1254 / 550), Image = "", ImageTransparency = 0,
            ImageColor3 = Color3.fromRGB(255, 255, 255), ScaleType = Enum.ScaleType.Stretch,
            BorderSizePixel = 0, Visible = false, ZIndex = level}, frame)
        local view = {frame = frame, image = image, fallback = fallback}
        view.connection = image:GetPropertyChangedSignal("IsLoaded"):Connect(function() refresh(view) end)
        table.insert(brand.views, view)
        attach(view)
        return frame
    end

    function brand.prepare()
        if brand.started or brand.stopped then return end
        brand.started = true
        local assetFn = type(getcustomasset) == "function" and getcustomasset
            or type(getsynasset) == "function" and getsynasset or nil
        if not assetFn then return end
        local ok, bytes = false, nil
        if type(readfile) == "function" then ok, bytes = pcall(readfile, brand.filename) end
        local cached = ok and type(bytes) == "string" and #bytes == brand.byteLength
            and bytes:sub(1, 8) == "\137PNG\13\10\26\10"
        if not cached then
            if type(writefile) ~= "function" then return end
            ok, bytes = pcall(brand.decode, encodedLogo)
            if brand.stopped or not ok or type(bytes) ~= "string" or #bytes ~= brand.byteLength then return end
            local saved = pcall(writefile, brand.filename, bytes)
            if not saved or brand.stopped then return end
        end
        if brand.stopped then return end
        local assetOK, asset = pcall(assetFn, brand.filename)
        if brand.stopped or not assetOK or type(asset) ~= "string" or asset == "" then return end
        brand.asset = asset
        for _, view in ipairs(brand.views) do attach(view) end
    end

    function brand.stop()
        brand.stopped = true
        for _, view in ipairs(brand.views) do pcall(function() view.connection:Disconnect() end) end
        table.clear(brand.views)
    end
end
