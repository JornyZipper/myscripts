local function findRevolverInWorkspace()
    local preferred = {
        "revolver",
        "sheriff",
        "pistol",
        "gun",
    }

    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("Tool") or object:IsA("BasePart") or object:IsA("Model") then
            local name = string.lower(object.Name)
            for _, keyword in ipairs(preferred) do
                if string.find(name, keyword, 1, true) then
                    if object:IsA("Tool") then
                        local handle = object:FindFirstChild("Handle")
                        if handle and handle:IsA("BasePart") then
                            return handle
                        end
                    elseif object:IsA("Model") then
                        local handle = object:FindFirstChild("Handle", true)
                        if handle and handle:IsA("BasePart") then
                            return handle
                        end
                        local primary = object.PrimaryPart
                        if primary then
                            return primary
                        end
                    elseif object:IsA("BasePart") then
                        return object
                    end
                end
            end
        end
    end

    return nil
end

local teleportBusy = false
local function teleportToRevolver()
    if state.unloaded or teleportBusy then
        return
    end

    teleportBusy = true

    local character = getCharacter()
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local target = findRevolverInWorkspace()

    if not root or not humanoid then
        Status.Text = "Teleport: character not ready"
        teleportBusy = false
        return
    end

    if not target then
        Status.Text = "Teleport: revolver not found"
        teleportBusy = false
        return
    end

    local targetPosition = target.Position + Vector3.new(0, 3.5, 0)

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {character, target.Parent}

    local floorHit = Workspace:Raycast(
        targetPosition + Vector3.new(0, 8, 0),
        Vector3.new(0, -20, 0),
        rayParams
    )

    if floorHit then
        targetPosition = floorHit.Position + Vector3.new(0, 3.5, 0)
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.Anchored = true
    root.CFrame = CFrame.new(targetPosition)
    task.wait(0.15)

    if root and root.Parent then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.Anchored = false

        if humanoid and humanoid.Parent then
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end

    Status.Text = "Teleported to revolver"
    teleportBusy = false
end

