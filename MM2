function Silent.isFiniteAimVector(value)
    if typeof(value) ~= "Vector3" then return false end
    local function finite(n) return n == n and n > -math.huge and n < math.huge end
    return finite(value.X) and finite(value.Y) and finite(value.Z)
end

function Silent.gunAimPosition(chest, motionPart)
    local position = chest.Position
    if not Silent.isFiniteAimVector(position) then return nil end
    if not state.silentAutoPredict then
        if Silent.gunAuto then Silent.gunAuto.reset(true) end
        local milliseconds = tonumber(values.silentLeadMs) or 0
        if milliseconds ~= milliseconds or math.abs(milliseconds) == math.huge then return position end
        local lead = math.clamp(milliseconds, 0, 200) / 1000
        if lead <= 0 then return position end
        -- OFF restores manual XZ prediction; zero uses the current chest directly.
        local velocity = motionPart.AssemblyLinearVelocity
        if not Silent.isFiniteAimVector(velocity) then return position end
        local horizontal = Vector3.new(math.clamp(velocity.X, -150, 150), 0,
            math.clamp(velocity.Z, -150, 150)) * lead
        if horizontal.Magnitude > 2 then horizontal = horizontal.Unit * 2 end
        return position + horizontal
    end
    -- ON follows personal ping independently of the retained manual slider value.
    -- Preview/Silent OFF/spectate cannot activate the sampler.
    if not state.silentGun or state.unloaded or state.spectateMurderer then
        if Silent.gunAuto then Silent.gunAuto.reset(true) end
        return position
    end
