    end

    function A.stop(preserveSetting)
        if preserveSetting then
            A.disposed = true -- a manual script reload preserves the saved preference
        else
            A.stopRequested = true
            A.setEnabled(false)
            -- A worker already saving ON finishes by writing the newest OFF request.
            if not A.busy then A.disposed = true end
        end
    end
end
