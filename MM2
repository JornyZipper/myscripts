-- Presentation aliases never change the role IDs used by gameplay logic.
local ROLE_SOURCES = {WAITING = "WAITING..."}
for _, english in ipairs({"MURDERER", "SHERIFF", "HERO", "INNOCENT", "PLAYER", "DEAD", "UNKNOWN", "WAITING..."}) do
    ROLE_SOURCES[english] = english
    for _, translated in pairs(TEXT_TRANSLATIONS[english] or {}) do
        ROLE_SOURCES[translated] = english
    end
end
function Localization.roleSource(role)
    if type(role) ~= "string" then return "UNKNOWN" end
    return ROLE_SOURCES[role] or ROLE_SOURCES[string.upper(role)] or "UNKNOWN"
end
local TEXT_FRAGMENTS = {}
for english, translations in pairs(TEXT_TRANSLATIONS) do
    if #english > 2 and (string.sub(english, 1, 1) == " " or string.sub(english, -1) == " "
        or string.sub(english, -1) == "=") then
        table.insert(TEXT_FRAGMENTS, {source = english, translated = translations})
    end
end
table.sort(TEXT_FRAGMENTS, function(left, right) return #left.source > #right.source end)
-- Keep canonical English even if an earlier translated label is copied or rewritten.
local ENGLISH_TEXT = {}
for english, translations in pairs(TEXT_TRANSLATIONS) do
    if english:sub(1, 1) ~= " " and english:sub(-1) ~= " " and english:sub(-1) ~= "=" then
        for _, translated in pairs(translations) do
            if translated ~= english and TEXT_TRANSLATIONS[translated] == nil then
                if ENGLISH_TEXT[translated] == nil then ENGLISH_TEXT[translated] = english
                elseif ENGLISH_TEXT[translated] ~= english then ENGLISH_TEXT[translated] = false end
            end
        end
    end
end
local LEGACY_LABELS = { ["Visualсек"] = "Visuals", ["Utilсек"] = "Utils",
    ["Settingсек"] = "Settings", ["Наблюдать"] = "Spectate" }
local SWITCH_SOURCES = {ON="ON", OFF="OFF", ["ВКЛ"]="ON", ["ВЫКЛ"]="OFF",
    ["УВІМК"]="ON", ["ВИМК"]="OFF", AN="ON", AUS="OFF"}
local function canonicalText(text)
    if type(text) ~= "string" then return text end
    if TEXT_TRANSLATIONS[text] then return text end
    local exact = LEGACY_LABELS[text] or ENGLISH_TEXT[text]
    if exact then return exact end
    local base, spacing, switch = text:match("^(.-)(%s+)%[(.-)%]$")
    if base and SWITCH_SOURCES[switch] then
        return (LEGACY_LABELS[base] or ENGLISH_TEXT[base] or base) .. spacing
            .. "[" .. SWITCH_SOURCES[switch] .. "]"
    end
    return text
end

local function translateText(source)
    if Localization.language == "en" or type(source) ~= "string" then return source end
    local lang = Localization.language
    local exact = TEXT_TRANSLATIONS[source]
    if exact then return exact[lang] or source end
    -- Dynamic labels: translate stable prefixes/suffixes, not usernames or numbers.
    local result = source
    local base, switch = string.match(source, "^(.-)(%s+%[ON%])$")
    if not base then base, switch = string.match(source, "^(.-)(%s+%[OFF%])$") end
    if base and TEXT_TRANSLATIONS[base] then
        result = (TEXT_TRANSLATIONS[base][lang] or base) .. switch
    end
    -- Dynamic role button labels retain their ON/OFF suffix and remain translatable.
    if result == source then
        for _, prefix in ipairs({"Spectate Murderer", "Spectate Sheriff", "Bring All"}) do
            if string.sub(source, 1, #prefix) == prefix and TEXT_TRANSLATIONS[prefix] then
                result = TEXT_TRANSLATIONS[prefix][lang] .. string.sub(source, #prefix + 1)
                break
            end
        end
    end
    for _, entry in ipairs(TEXT_FRAGMENTS) do
        local replacement = entry.translated[lang]
        if replacement then
            local from = 1
            while true do
                local first, last = string.find(result, entry.source, from, true)
                if not first then break end
                result = string.sub(result, 1, first - 1) .. replacement .. string.sub(result, last + 1)
                from = first + #replacement
            end
        end
    end
    return result
end
local function renderLocalized(object)
    if Localization.busy[object] then return end
    local original = canonicalText(Localization.sources[object])
    Localization.sources[object] = original
    if original == nil or not object.Parent then return end
    local translated = translateText(original)
    Localization.busy[object] = true
    Localization.rendered[object] = translated
    if object.Text ~= translated then object.Text = translated end
    Localization.busy[object] = nil
end
-- Dynamic role writers pass the English source explicitly. ESP cards live outside
-- the main ScreenGui, so they use this path without per-frame signal connections.
function Localization.setText(object, englishSource)
    if not object or type(englishSource) ~= "string" then return end
    Localization.sources[object] = canonicalText(englishSource)
    renderLocalized(object)
end
function Localization.copyText(destination, sourceObject)
    if not destination or not sourceObject then return end
    local current = sourceObject.Text
    local englishSource = current == Localization.rendered[sourceObject]
        and Localization.sources[sourceObject] or current
    Localization.setText(destination, englishSource or current)
end
function Localization.track(object)
    if not (object:IsA("TextLabel") or object:IsA("TextButton")) then return end
    if not UIRefs.ScriptMM2 or not object:IsDescendantOf(UIRefs.ScriptMM2) then return end
    if Localization.sources[object] ~= nil then return end
    Localization.sources[object] = canonicalText(object.Text)
    renderLocalized(object)
    addConnection(object:GetPropertyChangedSignal("Text"):Connect(function()
        if Localization.busy[object] then return end
        local current = object.Text
        if current == Localization.rendered[object] then return end
        Localization.sources[object] = canonicalText(current)
        renderLocalized(object)
    end))
end
function Localization.setLanguage(language)
    if language ~= "en" and language ~= "ru" and language ~= "uk" and language ~= "de" then return end
    Localization.language = language
    for object in pairs(Localization.sources) do renderLocalized(object) end
    if UIRefs.refreshPageLanguage then UIRefs.refreshPageLanguage() end
    if UIRefs.updateLanguageButtons then UIRefs.updateLanguageButtons() end
end

end
local function create(className, properties, parent)
    local object = Instance.new(className)
    for property, value in pairs(properties) do
        object[property] = value
    end
    object.Parent = parent
    -- The creation-time mapping lets existing frames, strokes and slider fills
    -- follow the selected accent without modifying role/ESP or FOV colors.
    local bindings = nil
    for property, value in pairs(properties) do
        if property == "BackgroundColor3" or property == "TextColor3" or property == "Color" then
            for key, color in pairs(UITheme) do
                if value == color then
                    bindings = bindings or {}
                    bindings[property] = key
                    break
                end
            end
        end
    end
    if bindings then UIStyling.colors[object] = bindings end
    Localization.track(object)
    return object
end

