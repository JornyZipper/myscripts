--// Bring adaptation: attempt to position ORIGINAL replicated models locally.
--// This does not create server hitboxes, take server ownership, or confirm replication.
do
    local bring = { target = nil, all = false,
        savedCollision = setmetatable({}, {__mode = "k"}) }
    local function setBringStatus(message)
        if UIRefs.bringStatus then UIRefs.bringStatus.Text = message end
        if not state.unloaded and UIRefs.Status then UIRefs.Status.Text = message end
    end
    local function restoreBringCollision()
        for part, wasCollidable in pairs(bring.savedCollision) do
            if part and part.Parent then
                pcall(function() part.CanCollide = wasCollidable end)
            end
            bring.savedCollision[part] = nil
        end
    end
    UIRefs.stopBring = function(reason)
        state.bringActive = false
        bring.target, bring.all = nil, false
        restoreBringCollision()
        if UIRefs.bringAllButton then UIRefs.bringAllButton.Text = "Bring All [OFF]" end
        setBringStatus(reason or "Bring OFF • local collision restored")
    end
    UIRefs.startBring = function(player)
        if state.unloaded then return end
        if teleportBusy or flingBusy or shootMurdererBusy or state.coinFarm then
            setBringStatus("Bring: stop TP / Fling / Coin Farm first")
            return
        end
        local me, root, hum = getCharacter(), getRoot(), getHumanoid()
        if not me or not root or not hum or hum.Health <= 0 then
            setBringStatus("Bring: your character is not ready")
            return
        end
        if player and (player == LocalPlayer or player.Parent ~= Players) then
            setBringStatus("Bring: target unavailable")
            return
        end
        if state.bringActive then UIRefs.stopBring() end
        state.bringActive = true
        bring.target, bring.all = player, player == nil
        UIRefs.bringAllButton.Text = bring.all and "Bring All [ON]" or "Bring All [OFF]"
        setBringStatus((bring.all and "Bring All" or ("Bring " .. player.DisplayName))
            .. " • LOCAL attempt; server/hits unverified")
    end
    addConnection(UIRefs.bringAllButton.MouseButton1Click:Connect(function()
        if state.bringActive and bring.all then
            UIRefs.stopBring()
        else
            UIRefs.startBring(nil)
        end
    end))
    addConnection(UIRefs.stopBringButton.MouseButton1Click:Connect(function()
        UIRefs.stopBring()
    end))
    addConnection(RunService.Heartbeat:Connect(function()
        if not state.bringActive or state.unloaded then return end
        if teleportBusy or flingBusy or shootMurdererBusy or state.coinFarm then
            UIRefs.stopBring("Bring stopped: conflicting movement action")
            return
        end
        local me, myRoot, hum = getCharacter(), getRoot(), getHumanoid()
        if not me or not myRoot or not hum or hum.Health <= 0 then
            UIRefs.stopBring("Bring stopped: character unavailable")
            return
        end
        if bring.target and bring.target.Parent ~= Players then
            UIRefs.stopBring("Bring stopped: target left")
            return
        end
        local destination = CFrame.new((myRoot.CFrame * CFrame.new(0, 0, -3)).Position)
        local targets = bring.all and Players:GetPlayers() or {bring.target}
        for _, player in ipairs(targets) do
            if player and player ~= LocalPlayer then
                local character = player.Character
                local otherRoot = character and (character:FindFirstChild("HumanoidRootPart")
                    or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso"))
                local otherHum = character and character:FindFirstChildOfClass("Humanoid")
                if otherRoot and otherRoot:IsA("BasePart") and otherHum and otherHum.Health > 0 then
                    for _, part in ipairs(character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            if bring.savedCollision[part] == nil then
                                bring.savedCollision[part] = part.CanCollide
                            end
                            part.CanCollide = false
                        end
                    end
                    otherRoot.CFrame = destination
                end
            end
        end
    end))
end

local function unload(reason)
    if state.unloaded then
        return
    end
    if UIRefs.Loading then UIRefs.Loading.destroy() end
    if UIRefs.Brand then UIRefs.Brand.stop() end
    if UIRefs.AutoRun then UIRefs.AutoRun.stop(reason == "reload") end
    if state.coinFarm and UIRefs.setCoinFarmToggle then UIRefs.setCoinFarmToggle(false) end
    if UIRefs.stopBring then UIRefs.stopBring() end
    if UIRefs.clearAttackSelection then UIRefs.clearAttackSelection() end
    state.unloaded = true
    if UIRefs.Watermark then UIRefs.Watermark.destroy() end
    if UIRefs.setAutoPredictionToggle then UIRefs.setAutoPredictionToggle(false) end
    Silent.stop()
    Silent.restoreXeno()
    finishMurdererShot()
    finishRevolverTrip()
    flingAllActive = false
    flingAllGeneration = flingAllGeneration + 1
    if UIRefs.flingSelectButton then paintSelectedFlingAction(false) end
    stopRoleFling()
    stopSpectateMurderer()

    UIRefs.setSpeedToggle(false)
    UIRefs.setJumpToggle(false)
    UIRefs.setNoclipToggle(false)
    UIRefs.setFlyToggle(false)
    UIRefs.setInfiniteToggle(false)
    UIRefs.setFullBrightToggle(false)
    UIRefs.setGravityToggle(false)
    UIRefs.setSpinToggle(false)
    UIRefs.setBunnyToggle(false)
    UIRefs.setStrafeToggle(false)
    if UIRefs.setUltraLongJumpToggle then UIRefs.setUltraLongJumpToggle(false) end
    if UIRefs.setLongJumpToggle then UIRefs.setLongJumpToggle(false) end
    UIRefs.setESPToggle(false)
    UIRefs.setRoleESPToggle(false)
    UIRefs.setInnocentESPToggle(false)
    UIRefs.setESPLinesToggle(false)
    UIRefs.setESPNamesToggle(false)
    UIRefs.setESPInfoCardsToggle(false)
    UIRefs.setAimLockToggle(false)
    if UIRefs.setFOVIndicatorToggle then UIRefs.setFOVIndicatorToggle(false) end
    UIRefs.setAntiFlingToggle(false)

    stopFly()
    restoreNoclip()
    clearESP()
    disableFullBright()
    restoreCameraFOV()
    if UIRefs.AimCircleGui then UIRefs.AimCircleGui:Destroy() end

    disconnectBucket(characterConnections)
    disconnectBucket(connections)

    if ESPOverlay then
        pcall(function()
            ESPOverlay:Destroy()
        end)
    end

    MenuAudio.unloaded = true
    for which, sound in pairs(MenuAudio.ready) do
        pcall(function() sound:Stop(); sound:Destroy() end)
        MenuAudio.ready[which] = nil
    end
    if UIRefs.ScriptMM2 then
        pcall(function()
            UIRefs.ScriptMM2:Destroy()
        end)
    end
end

