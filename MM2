local function addConnection(connection, bucket)
    bucket = bucket or connections
    table.insert(bucket, connection)
    return connection
end

local function disconnectBucket(bucket)
    for i = #bucket, 1, -1 do
        local connection = bucket[i]
        if connection and connection.Disconnect then
            pcall(function()
                connection:Disconnect()
            end)
        end
        bucket[i] = nil
    end
end

local function getCharacter()
    return LocalPlayer.Character
end

local function getHumanoid()
    local character = getCharacter()
    if not character then
        return nil
    end
    return character:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local character = getCharacter()
    if not character then
        return nil
    end
    return character:FindFirstChild("HumanoidRootPart")
end

local function stopRegularSpin()
    if spinState.root and spinState.root.Parent and not flingBusy then
        pcall(function() spinState.root.AssemblyAngularVelocity = spinState.velocity end)
    end
    spinState.root, spinState.velocity = nil, nil
end

local function isAliveCharacter(player)
    local character = player.Character
    if not character then
        return false
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    return humanoid ~= nil and humanoid.Health > 0
end

-- Save only properties a feature actually overrides, per character.
local function applyMovementSettings(humanoid)
    if not humanoid then return end
    local saved = movementSnapshots[humanoid]
    if state.speed or state.jump then
        saved = saved or {}
        movementSnapshots[humanoid] = saved
    end
    if state.speed then
        if saved.walkSpeed == nil then saved.walkSpeed = humanoid.WalkSpeed end
        humanoid.WalkSpeed = values.walkSpeed
    elseif saved and saved.walkSpeed ~= nil then
        humanoid.WalkSpeed = saved.walkSpeed
        saved.walkSpeed = nil
    end
    if state.jump then
        if saved.useJumpPower == nil then
            saved.useJumpPower = humanoid.UseJumpPower
            saved.jumpPower = humanoid.JumpPower
            saved.jumpHeight = humanoid.JumpHeight
        end
        humanoid.UseJumpPower = true
        humanoid.JumpPower = values.jumpPower
    elseif saved and saved.useJumpPower ~= nil then
        humanoid.JumpPower = saved.jumpPower
        humanoid.JumpHeight = saved.jumpHeight
        humanoid.UseJumpPower = saved.useJumpPower
        saved.useJumpPower, saved.jumpPower, saved.jumpHeight = nil, nil, nil
    end
    if saved and next(saved) == nil then movementSnapshots[humanoid] = nil end
end

local function applyCameraFOV()
    local camera = Workspace.CurrentCamera
    if state.unloaded or not fovState.active or not camera then return end
    if fovState.saved[camera] == nil then fovState.saved[camera] = camera.FieldOfView end
    camera.FieldOfView = values.fov
end

local function restoreCameraFOV()
    fovState.active = false
    for camera, value in pairs(fovState.saved) do
        pcall(function() camera.FieldOfView = value end)
    end
    table.clear(fovState.saved)
end

local function isPointerMove(input, source)
    return source and ((source.UserInputType == Enum.UserInputType.Touch and input == source)
        or (source.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement))
end

local function isPointerEnd(input, source)
    return source and ((source.UserInputType == Enum.UserInputType.Touch and input == source)
        or (source.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseButton1))
end

local function setButtonVisual(button, enabled)
    if enabled then
        button.TextColor3 = Color3.fromRGB(220, 255, 235)
        button.BackgroundColor3 = Color3.fromRGB(38, 115, 72)
    else
        button.TextColor3 = Color3.fromRGB(220, 220, 225)
        button.BackgroundColor3 = Color3.fromRGB(37, 37, 43)
    end
end

local function create(className, properties, parent)
    local object = Instance.new(className)
    for property, value in pairs(properties) do
        object[property] = value
    end
    object.Parent = parent
    return object
end

