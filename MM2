local dragStart = nil
local startPosition = nil
local draggingMain = false
local mainDragInput = nil

local function beginDrag(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end
    if mainDragInput then return end
    mainDragInput = input
    draggingMain = true
    dragStart = input.Position
    startPosition = Main.Position
end

local function updateDrag(input)
    if not draggingMain then
        return
    end
    if not isPointerMove(input, mainDragInput) then return end

    local delta = (input.Position - dragStart) / Scale.Scale
    Main.Position = UDim2.new(
        startPosition.X.Scale,
        startPosition.X.Offset + delta.X,
        startPosition.Y.Scale,
        startPosition.Y.Offset + delta.Y
    )
end

addConnection(dragHandle.InputBegan:Connect(beginDrag))
addConnection(UIS.InputChanged:Connect(updateDrag))
addConnection(UIS.InputEnded:Connect(function(input)
    if isPointerEnd(input, mainDragInput) then
        draggingMain = false
        mainDragInput = nil
    end
end))

--// Mobile floating MOD drag
local draggingReopen = false
local reopenDragStart = nil
local reopenStartPosition = nil
local reopenDragInput = nil

addConnection(reopen.InputBegan:Connect(function(input)
    if not IsMobile then
        return
    end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        if reopenDragInput then return end
        reopenDragInput = input
        draggingReopen = true
        reopenDragStart = input.Position
        reopenStartPosition = reopen.Position
    end
end))

addConnection(UIS.InputChanged:Connect(function(input)
    if not draggingReopen or not IsMobile then
        return
    end
    if not isPointerMove(input, reopenDragInput) then return end

    local camera = Workspace.CurrentCamera
    if not camera then
        return
    end

    local delta = (input.Position - reopenDragStart) / Scale.Scale
    local viewport = camera.ViewportSize / Scale.Scale
    local halfX = reopen.AbsoluteSize.X * 0.5 / Scale.Scale
    local halfY = reopen.AbsoluteSize.Y * 0.5 / Scale.Scale

    local newX = reopenStartPosition.X.Offset + delta.X
    local newY = reopenStartPosition.Y.Offset + delta.Y
    newX = math.clamp(newX, -viewport.X * 0.5 + halfX + 6, viewport.X * 0.5 - halfX - 6)
    newY = math.clamp(newY, -viewport.Y * 0.5 + halfY + 6, viewport.Y * 0.5 - halfY - 6)

    reopen.Position = UDim2.new(0.5, newX, 0.5, newY)
end))

addConnection(UIS.InputEnded:Connect(function(input)
    if isPointerEnd(input, reopenDragInput) then
        draggingReopen = false
        reopenDragInput = nil
    end
end))

