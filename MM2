--// Stop our earlier copy before its AntiFling/Fly callbacks can fight this one.
do
    for _, oldGui in ipairs(PlayerGui:GetChildren()) do
        if oldGui:IsA("ScreenGui") and oldGui.Name == "ModMenuFromZero" then
            if UIRefs.AutomaticLaunch then return end -- another loader already started the menu
            local previousUnload = oldGui:FindFirstChild("ScriptMM2Unload")
            if previousUnload and previousUnload:IsA("BindableFunction") then
                pcall(function() previousUnload:Invoke("reload") end)
            elseif type(getconnections) == "function" then
                -- Compatibility with V1.0/V1.0.1, which only expose an Unload button.
                local button = oldGui:FindFirstChild("Unload", true)
                if button and button:IsA("TextButton") then
                    local listOK, list = pcall(getconnections, button.MouseButton1Click)
                    if listOK and type(list) == "table" then
                        for _, connection in ipairs(list) do
                            local fnOK, callback = pcall(function() return connection.Function end)
                            if fnOK and type(callback) == "function" then pcall(callback) end
                            if not oldGui.Parent then break end
                        end
                    end
                end
            end
            if oldGui.Parent then
                local message = "Close the previous SYDJA HUB / ScriptMM2 menu with X, then run this file again."
                pcall(function()
                    game:GetService("StarterGui"):SetCore("SendNotification", {
                        Title = "SYDJA HUB", Text = message, Duration = 8,
                    })
                end)
                error(message, 0)
            end
        end
    end
end

