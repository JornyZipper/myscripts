local function paintSelectedFlingAction(active)
    if not UIRefs.flingSelectButton then return end
    UIRefs.flingSelectButton.Text = active and "Stop Fling Selected [ON]" or "YARHM Fling Selected [OFF]"
    setButtonVisual(UIRefs.flingSelectButton, active)
end

local function flingSelectedPlayer()
    if state.unloaded then return end
    if flingAllActive then
        flingAllActive = false
        flingAllGeneration += 1
        if flingBusy then stopRoleFling(true) end
        paintSelectedFlingAction(false)
        UIRefs.Status.Text = "Fling Selected: stopped • returned"
        if UIRefs.flingSelectStatus then UIRefs.flingSelectStatus.Text = "Stopped. Choose a target to retry." end
        return
    end
    if flingBusy or teleportBusy then
        UIRefs.Status.Text = "Fling Selected: stop current Fling / TP first"
        return
    end
    local player = UIRefs.selectedFlingPlayer
    if not player or player == LocalPlayer or player.Parent ~= Players then
        UIRefs.Status.Text = "Fling Selected: choose a player in SPECTATE first"
        if UIRefs.flingSelectStatus then Localization.copyText(UIRefs.flingSelectStatus, UIRefs.Status) end
        return
    end
    if not roleAlive(player.Name) then
        UIRefs.Status.Text = "Fling Selected: chosen player is not alive / available"
        if UIRefs.flingSelectStatus then Localization.copyText(UIRefs.flingSelectStatus, UIRefs.Status) end
        return
    end
    flingAllActive = true
    flingAllGeneration += 1
    local generation = flingAllGeneration
    paintSelectedFlingAction(true)
    UIRefs.Status.Text = "Fling Selected: " .. player.DisplayName .. " • local contact attempt"
    if UIRefs.flingSelectStatus then Localization.copyText(UIRefs.flingSelectStatus, UIRefs.Status) end
    task.spawn(function()
        if not flingAllActive or generation ~= flingAllGeneration or state.unloaded then return end
        flingRole("Player", player, generation)
        -- A stopped worker cannot clear a newer target/attempt.
        if generation ~= flingAllGeneration then return end
        flingAllActive = false
        if not state.unloaded then
            paintSelectedFlingAction(false)
            if UIRefs.flingSelectStatus then Localization.copyText(UIRefs.flingSelectStatus, UIRefs.Status) end
        end
    end)
end

local function getLocalRole()
    if LocalPlayer.Name == Murder then
        return "Murderer"
    elseif LocalPlayer.Name == Sheriff then
        return "Sheriff"
    elseif LocalPlayer.Name == Hero then
        return "Hero"
    end
    return "Innocent"
end

local function getRoleColor(role, alive)
    if not alive then
        return ESPColors.Dead
    end

    if role == "Murderer" then
        return ESPColors.Murderer
    elseif role == "Sheriff" then
        return ESPColors.Sheriff
    elseif role == "Hero" then
        return ESPColors.Hero
    elseif role == "Innocent" then
        return ESPColors.Innocent
    elseif role == "Unknown" then
        return ESPColors.Unknown
    end

    return ESPColors.Player
end

local function destroyESPForPlayer(player)
    local object = espObjects[player]
    if object then
        if object.highlight then
            object.highlight:Destroy()
        end
        if object.billboard then
            object.billboard:Destroy()
        end
        if object.tracer then
            object.tracer:Destroy()
        end
        espObjects[player] = nil
    end

    local character = player.Character
    if character then
        for _, child in ipairs(character:GetChildren()) do
            if child.Name == "ModMenuESP" or child.Name == "ModMenuESPInfo" then
                child:Destroy()
            end
        end
    end
end

