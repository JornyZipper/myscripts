    if not humanoid then
        return
    end

    humanoid.UseJumpPower = true
    if state.speed then
        humanoid.WalkSpeed = values.walkSpeed
    else
        humanoid.WalkSpeed = CONFIG.DefaultWalkSpeed
    end

    if state.jump then
