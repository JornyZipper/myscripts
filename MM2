end

local function findGetPlayerData()
    local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if remote and remote:IsA("RemoteFunction") then
        return remote
    end
    return nil
end

local roleRequestPending = false
local function clearRoles()
    roles, Murder, Sheriff, Hero = {}, "", "", ""
    rolesAvailable = false
    rolesUpdatedAt = -math.huge
end

local function refreshRoles()
    if state.unloaded then
        return false
    end
    if roleRequestPending then
        repeat RunService.Heartbeat:Wait() until not roleRequestPending or state.unloaded
        return not state.unloaded and rolesAvailable
    end

    local remote = findGetPlayerData()
    if not remote then
        clearRoles()
        UIRefs.Status.Text = "Role ESP: GetPlayerData not found"
        return false
    end

    roleRequestPending = true
    local success, result = pcall(function()
        return remote:InvokeServer()
    end)
    roleRequestPending = false

    if state.unloaded then
        return false
    end

    if not success or type(result) ~= "table" then
        clearRoles()
        UIRefs.Status.Text = "Role ESP: failed to read roles"
        return false
    end

    roles = result
    rolesAvailable = true
    rolesUpdatedAt = os.clock()
    Murder = ""
    Sheriff = ""
    Hero = ""

    for playerName, data in pairs(roles) do
        if type(data) == "table" then
            if data.Role == "Murderer" then
                Murder = playerName
            elseif data.Role == "Sheriff" then
                Sheriff = playerName
            elseif data.Role == "Hero" then
                Hero = playerName
            end
        end
    end


    if teleportBusy or flingBusy or shootMurdererBusy or state.spectateMurderer then return true end
    if LocalPlayer.Name == Murder then
        Localization.setText(UIRefs.Status, "Role: Murderer")
    elseif LocalPlayer.Name == Sheriff then
        Localization.setText(UIRefs.Status, "Role: Sheriff")
    elseif LocalPlayer.Name == Hero then
        Localization.setText(UIRefs.Status, "Role: Hero")
    else
        Localization.setText(UIRefs.Status, "Role: Innocent / unknown")
    end

    return true
end


--// Camera-only spectate: role targets and manually selected players.
--// The compatibility flag state.spectateMurderer means any spectate mode is active.
do
    local spectate = {
        mode = nil, player = nil, camera = nil, savedType = nil,
        savedSubject = nil, target = nil, targetPlayer = nil,
        previousRoleName = nil,
    }
    local function setSpectateStatus(message)
        if UIRefs.spectateStatus then UIRefs.spectateStatus.Text = message end
        if not state.unloaded and UIRefs.Status then UIRefs.Status.Text = message end
    end
    local function paintSpectateButtons()
        local murder = spectate.mode == "Murderer"
        local sheriff = spectate.mode == "Sheriff"
        UIRefs.spectateMurdererButton.Text = "Spectate Murderer " .. (murder and "[ON]" or "[OFF]")
        UIRefs.spectateSheriffButton.Text = "Spectate Sheriff " .. (sheriff and "[ON]" or "[OFF]")
        setButtonVisual(UIRefs.spectateMurdererButton, murder)
        setButtonVisual(UIRefs.spectateSheriffButton, sheriff)
        if UIRefs.spectatePlayerButtons then
            for player, button in pairs(UIRefs.spectatePlayerButtons) do
                if button and button.Parent then
                    local active = spectate.mode == "Player" and spectate.player == player
                    setButtonVisual(button, active)
                    button.Text = player.DisplayName .. "  (@" .. player.Name .. ")" .. (active and "  [WATCHING]" or "")
                end
            end
        end
    end
    stopSpectateMurderer = function(reason)
        if not state.spectateMurderer then return end
        state.spectateMurderer = false
        local camera = Workspace.CurrentCamera
        -- Restore the local camera, including when the previous target despawned.
        if camera and (camera == spectate.camera) and
            (camera.CameraSubject == spectate.target or not spectate.target or
                not spectate.target.Parent) then
            pcall(function()
                local ownHumanoid = getHumanoid()
                camera.CameraType = (spectate.savedType == Enum.CameraType.Scriptable)
                    and Enum.CameraType.Custom or (spectate.savedType or Enum.CameraType.Custom)
                camera.CameraSubject = (ownHumanoid and ownHumanoid.Parent and ownHumanoid)
                    or (spectate.savedSubject and spectate.savedSubject.Parent and spectate.savedSubject)
                    or camera.CameraSubject
            end)
        end
        spectate.mode, spectate.player, spectate.targetPlayer = nil, nil, nil
        spectate.camera, spectate.savedType, spectate.savedSubject = nil, nil, nil
        spectate.target, spectate.previousRoleName = nil, nil
        paintSpectateButtons()
        if reason then setSpectateStatus(reason) end
    end
    local function startSpectate(mode, player)
        if state.unloaded or shootMurdererBusy or teleportBusy then
            setSpectateStatus("Spectate: finish current camera action first")
            return
        end
        if mode == "Player" and (not player or player == LocalPlayer or player.Parent ~= Players) then
            setSpectateStatus("Spectate: choose another player")
            return
        end
        if state.spectateMurderer and spectate.mode == mode and spectate.player == player then
            stopSpectateMurderer("Spectate OFF • own camera")
            return
        end
        if state.spectateMurderer then stopSpectateMurderer() end
        local camera = Workspace.CurrentCamera
        if not camera or camera.CameraType == Enum.CameraType.Scriptable then
            setSpectateStatus("Spectate: camera is busy")
            return
        end
        spectate.mode, spectate.player = mode, player
        spectate.camera, spectate.savedType, spectate.savedSubject = camera, camera.CameraType, camera.CameraSubject
        spectate.target, spectate.targetPlayer = nil, nil
        spectate.previousRoleName = nil
        state.spectateMurderer = true
        if mode ~= "Player" then rolesAvailable = false end
        paintSpectateButtons()
        setSpectateStatus("Spectate: waiting for " .. (player and player.DisplayName or mode) .. "...")
    end
    toggleSpectateMurderer = function() startSpectate("Murderer") end
    UIRefs.toggleSpectateSheriff = function() startSpectate("Sheriff") end
    UIRefs.selectSpectatePlayer = function(player) startSpectate("Player", player) end
    UIRefs.stopSpectate = function() stopSpectateMurderer("Spectate OFF • own camera") end

    -- Recreate buttons only on join/leave/page open; transient buttons own their click links.
    UIRefs.rebuildSpectatorList = function()
        if state.unloaded or not UIRefs.spectatePlayerList then return end
        if UIRefs.spectatePlayerButtons then
            for _, button in pairs(UIRefs.spectatePlayerButtons) do button:Destroy() end
        end
        UIRefs.spectatePlayerButtons = {}
        if UIRefs.teleportPlayerButtons then
            for _, button in pairs(UIRefs.teleportPlayerButtons) do button:Destroy() end
        end
        UIRefs.teleportPlayerButtons = {}
        if UIRefs.bringPlayerButtons then
            for _, button in pairs(UIRefs.bringPlayerButtons) do button:Destroy() end
        end
        UIRefs.bringPlayerButtons = {}
        if UIRefs.attackPlayerButtons then
            for _, button in pairs(UIRefs.attackPlayerButtons) do button:Destroy() end
        end
        UIRefs.attackPlayerButtons = {}
        if UIRefs.flingPlayerButtons then
            for _, button in pairs(UIRefs.flingPlayerButtons) do button:Destroy() end
        end
        UIRefs.flingPlayerButtons = {}
        if UIRefs.selectedFlingPlayer and UIRefs.selectedFlingPlayer.Parent ~= Players then
            UIRefs.selectedFlingPlayer = nil
            if UIRefs.flingSelectStatus then UIRefs.flingSelectStatus.Text = "Selected player left. Choose another player." end
        end
        if UIRefs.selectedAttackPlayer and UIRefs.selectedAttackPlayer.Parent ~= Players then
            UIRefs.selectedAttackPlayer = nil
            UIRefs.attackStatus.Text = "Selected player left. Choose another player."
        end
        local players = Players:GetPlayers()
        table.sort(players, function(a, b) return a.Name:lower() < b.Name:lower() end)
        local order = 0
        for _, player in ipairs(players) do
            if player ~= LocalPlayer then
                order += 1
                local button = create("TextButton", {
                    Name = "Watch_" .. tostring(player.UserId),
                    Size = UDim2.new(1, -4, 0, 38),
                    BackgroundColor3 = UITheme.item, BorderSizePixel = 0,
                    Font = Enum.Font.GothamSemibold,
                    Text = player.DisplayName .. "  (@" .. player.Name .. ")",
                    TextColor3 = UITheme.text, TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
                    LayoutOrder = order,
                }, UIRefs.spectatePlayerList)
                create("UICorner", { CornerRadius = UDim.new(0, 8) }, button)
                UIRefs.spectatePlayerButtons[player] = button
                button.MouseButton1Click:Connect(function() UIRefs.selectSpectatePlayer(player) end)
                local tpButton = create("TextButton", {
                    Name = "TP_" .. tostring(player.UserId),
                    Size = UDim2.new(1, -4, 0, 38),
                    BackgroundColor3 = Color3.fromRGB(42, 66, 100), BorderSizePixel = 0,
                    Font = Enum.Font.GothamSemibold,
                    Text = "TP → " .. player.DisplayName .. "  (@" .. player.Name .. ")",
                    TextColor3 = Color3.fromRGB(235, 240, 255), TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
                    LayoutOrder = order,
                }, UIRefs.teleportPlayerList)
                create("UICorner", { CornerRadius = UDim.new(0, 8) }, tpButton)
                UIRefs.teleportPlayerButtons[player] = tpButton
                tpButton.MouseButton1Click:Connect(function()
                    if UIRefs.teleportToPlayer then task.spawn(UIRefs.teleportToPlayer, player) end
                end)
                local bringButton = create("TextButton", {
                    Name = "Bring_" .. tostring(player.UserId),
                    Size = UDim2.new(1, -4, 0, 38),
                    BackgroundColor3 = Color3.fromRGB(78, 59, 106), BorderSizePixel = 0,
                    Font = Enum.Font.GothamSemibold,
                    Text = "Bring → " .. player.DisplayName .. " (@" .. player.Name .. ")",
                    TextColor3 = Color3.fromRGB(245, 235, 255), TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
                    LayoutOrder = order,
                }, UIRefs.bringPlayerList)
                create("UICorner", { CornerRadius = UDim.new(0, 8) }, bringButton)
                UIRefs.bringPlayerButtons[player] = bringButton
                bringButton.MouseButton1Click:Connect(function()
                    if UIRefs.startBring then UIRefs.startBring(player) end
                end)
                local attackButton = create("TextButton", {
                    Name = "AttackSelect_" .. tostring(player.UserId),
                    Size = UDim2.new(1, -4, 0, 38),
                    BackgroundColor3 = Color3.fromRGB(65, 45, 49), BorderSizePixel = 0,
                    Font = Enum.Font.GothamSemibold,
                    Text = "Select → " .. player.DisplayName .. " (@" .. player.Name .. ")",
                    TextColor3 = Color3.fromRGB(245, 225, 225), TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
                    LayoutOrder = order,
                }, UIRefs.attackPlayerList)
                create("UICorner", { CornerRadius = UDim.new(0, 8) }, attackButton)
                UIRefs.attackPlayerButtons[player] = attackButton
                attackButton.MouseButton1Click:Connect(function()
                    UIRefs.selectedAttackPlayer = player
                    UIRefs.attackStatus.Text = "Selected: " .. player.DisplayName
                        .. " • Attack Selected or K (normal weapon attempt)"
                    if UIRefs.paintAttackSelection then UIRefs.paintAttackSelection() end
                end)

                local flingButton = create("TextButton", {
                    Name = "FlingSelect_" .. tostring(player.UserId),
                    Size = UDim2.new(1, -4, 0, 38),
                    BackgroundColor3 = Color3.fromRGB(74, 49, 83), BorderSizePixel = 0,
                    Font = Enum.Font.GothamSemibold,
                    Text = "Target → " .. player.DisplayName .. " (@" .. player.Name .. ")",
                    TextColor3 = Color3.fromRGB(245, 230, 255), TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
                    LayoutOrder = order,
                }, UIRefs.flingPlayerList)
                create("UICorner", {CornerRadius = UDim.new(0, 8)}, flingButton)
                UIRefs.flingPlayerButtons[player] = flingButton
                flingButton.MouseButton1Click:Connect(function()
                    if flingAllActive or flingBusy then
                        UIRefs.flingSelectStatus.Text = "Stop current fling before changing target."
                        return
                    end
                    UIRefs.selectedFlingPlayer = player
                    UIRefs.flingSelectStatus.Text = "Target: " .. player.DisplayName .. " (@" .. player.Name .. ")"
                    if UIRefs.paintFlingSelection then UIRefs.paintFlingSelection() end
                end)
            end
        end
        paintSpectateButtons()
        if UIRefs.paintAttackSelection then UIRefs.paintAttackSelection() end
        if UIRefs.paintFlingSelection then UIRefs.paintFlingSelection() end
    end

    local checkTimer = 0
    addConnection(RunService.Heartbeat:Connect(function(dt)
        if state.unloaded or not state.spectateMurderer then return end
        checkTimer += dt
        if checkTimer < 0.2 then return end
        checkTimer = 0
        if shootMurdererBusy then
            stopSpectateMurderer("Spectate stopped: shot camera in use")
            return
        end
        local player
        if spectate.mode == "Player" then
            player = spectate.player
            if not player or player.Parent ~= Players then
                stopSpectateMurderer("Spectate stopped: player left")
                return
            end
        else
            if not rolesAvailable then return end
            local roleName = (spectate.mode == "Murderer") and Murder or Sheriff
            if roleName == "" then
                if spectate.target then stopSpectateMurderer("Spectate stopped: round ended") end
                return
            end
            if spectate.previousRoleName and spectate.previousRoleName ~= roleName then
                stopSpectateMurderer("Spectate stopped: role changed")
                return
            end
            player = Players:FindFirstChild(roleName)
            spectate.previousRoleName = roleName
        end
        local character = player and player.Character
        local targetHumanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not player or player == LocalPlayer or not targetHumanoid or targetHumanoid.Health <= 0 then
            if spectate.target or spectate.mode == "Player" then
                stopSpectateMurderer("Spectate stopped: target unavailable / eliminated")
            end
            return
        end
        local camera = Workspace.CurrentCamera
        if not camera or camera.CameraType == Enum.CameraType.Scriptable then return end
        if spectate.target and spectate.target ~= targetHumanoid then
            stopSpectateMurderer("Spectate stopped: target respawned")
            return
        end
        spectate.target = targetHumanoid
        spectate.targetPlayer = player
        if camera ~= spectate.camera then
            spectate.camera = camera
        end
        if camera.CameraSubject ~= targetHumanoid then camera.CameraSubject = targetHumanoid end
        if camera.CameraType ~= Enum.CameraType.Custom then camera.CameraType = Enum.CameraType.Custom end
        if UIRefs.spectateStatus then
            UIRefs.spectateStatus.Text = "Watching " .. player.DisplayName .. " (@" .. player.Name .. ")"
                .. (spectate.mode == "Player" and "" or (" • " .. spectate.mode))
        end
    end))
end

--// X = shoot murderer with revolver.

findRevolver = function()
    local character = getCharacter()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

    local function check(container)
        if not container then
            return nil
        end

        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local name = string.lower(item.Name)
                if string.find(name, "revolver", 1, true)
                    or string.find(name, "sheriff", 1, true)
                    or string.find(name, "pistol", 1, true)
                    or name == "gun" then
                    return item
                end
            end
        end

        return nil
    end

    return check(character) or check(backpack)
end

local shootTrip = nil
local shootCooldownUntil = 0

finishMurdererShot = function()
    local trip = shootTrip
    if not trip or trip.finished then return end
    trip.finished = true
    if trip.activated and trip.tool then
        pcall(function() trip.tool:Deactivate() end)
    end
    if trip.cameraChanged then
        pcall(function()
            trip.camera.CFrame = trip.cameraCFrame
            trip.camera.CameraType = trip.cameraType
        end)
    end
    local previous = trip.previousTool
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if previous and previous.Parent and LocalPlayer.Character == trip.character and trip.humanoid.Health > 0
        and (previous.Parent == trip.character or previous.Parent == backpack) then
        pcall(function() trip.humanoid:EquipTool(previous) end)
    end
    shootTrip = nil
    shootMurdererBusy = false
    shootCooldownUntil = os.clock() + 0.25
end

local function shootMurderer()
    if state.unloaded or shootMurdererBusy or os.clock() < shootCooldownUntil then return end
    if state.spectateMurderer then stopSpectateMurderer("Spectate stopped for shot") end
    if teleportBusy or flingBusy then
        UIRefs.Status.Text = "Shoot: finish pickup / stop Fling first"
        return
    end
    local character, humanoid = getCharacter(), getHumanoid()
    if not character or not humanoid or humanoid.Health <= 0 then return end
    local trip = {character = character, humanoid = humanoid, finished = false}
    shootTrip = trip
    shootMurdererBusy = true
    local outcome = "Shoot: cancelled"
    local ok, err = pcall(function()
        if not refreshRoles() then outcome = "Shoot: roles unavailable"; return end
        if trip.finished or state.unloaded or LocalPlayer.Character ~= character or humanoid.Health <= 0 then return end
        local murderer = Murder ~= "" and Players:FindFirstChild(Murder) or nil
        if not murderer or not roleAlive(Murder) then outcome = "Shoot: no living murderer"; return end
        local targetCharacter = murderer.Character
        local targetPart = targetCharacter and (targetCharacter:FindFirstChild("UpperTorso")
            or targetCharacter:FindFirstChild("Torso")
            or targetCharacter:FindFirstChild("HumanoidRootPart")
            or targetCharacter:FindFirstChild("LowerTorso"))
        if not targetPart then outcome = "Shoot: no target part"; return end
        local tool = findRevolver()
        if not tool then outcome = "Shoot: revolver not found"; return end
        trip.tool = tool
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") and item ~= tool then trip.previousTool = item; break end
        end
        if tool.Parent ~= character then
            humanoid:EquipTool(tool)
            task.wait(0.05)
        end
        if trip.finished or state.unloaded or LocalPlayer.Character ~= character or humanoid.Health <= 0
            or tool.Parent ~= character or Murder ~= murderer.Name or murderer.Character ~= targetCharacter
            or not targetPart.Parent or not roleAlive(Murder) then return end
        local camera = Workspace.CurrentCamera
        if not camera then outcome = "Shoot: camera unavailable"; return end
        trip.camera, trip.cameraType, trip.cameraCFrame = camera, camera.CameraType, camera.CFrame
        trip.cameraChanged = true
        camera.CameraType = Enum.CameraType.Scriptable
        camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetPart.Position)
        trip.activated = true
        tool:Activate()
        task.wait(0.05)
        if not trip.finished and not state.unloaded then
            outcome = "Shoot: fired at " .. murderer.DisplayName
        end
    end)
    if trip.finished then return end
    finishMurdererShot()
    if not state.unloaded then UIRefs.Status.Text = ok and outcome or ("Shoot error: " .. tostring(err)) end
end

