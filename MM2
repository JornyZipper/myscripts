        if UIRefs.reopenDragInput then return end
        UIRefs.reopenDragInput = input
        UIRefs.draggingReopen = true
        UIRefs.reopenDragStart = input.Position
        UIRefs.reopenStartPosition = UIRefs.reopen.Position
