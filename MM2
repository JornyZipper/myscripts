            if not state.unloaded then
                updateESP()
            end
        end)
    end
end))

--// Smooth custom ESP renderer
local espTimer = 0
addConnection(RunService.RenderStepped:Connect(function(deltaTime)
    if state.unloaded then
        return
    end

    if state.esp or state.roleESP or state.innocentESP then
        espTimer = espTimer + deltaTime
        if espTimer >= 0.05 then
            espTimer = 0
            updateESP()
