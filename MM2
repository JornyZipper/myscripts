local function playMenuSound(which)
    if which == "toggleOn" or which == "toggleOff" then return end
    local sound = MenuAudio.ready[which]
    -- Never queue a late sound after the window's animation has finished.
    if not sound or not sound.Parent or not sound.IsLoaded then return end
    pcall(function()
        sound:Stop()
        sound.TimePosition = 0
        sound:Play()
    end)
end

local function setupMenuAudio()
    local assetFn = type(getcustomasset) == "function" and getcustomasset
        or type(getsynasset) == "function" and getsynasset or nil
    if type(writefile) ~= "function" or not assetFn then
        warn("[ScriptMM2 AUDIO] Local MP3 unavailable: requires writefile + getcustomasset/getsynasset; menu remains functional")
        return
    end
    for which, url in pairs(MenuAudio.urls) do
        task.spawn(function()
            if MenuAudio.unloaded then return end
            local filename = MenuAudio.files[which]
            local cached = false
            if type(isfile) == "function" then
                local ok, exists = pcall(isfile, filename)
                cached = ok and exists == true
            end
            if not cached then
                local ok, body = pcall(function() return game:HttpGet(url) end)
                if not ok or type(body) ~= "string" or #body < 128
                    or (body:sub(1, 3) ~= "ID3" and body:byte(1) ~= 255) then
                    warn("[ScriptMM2 AUDIO] Download failed: " .. which .. " (" .. tostring(body) .. ")")
                    return
                end
                local saved, err = pcall(writefile, filename, body)
                if not saved then
                    warn("[ScriptMM2 AUDIO] Cache write failed: " .. which .. " (" .. tostring(err) .. ")")
                    return
                end
            end
            local ok, assetId = pcall(assetFn, filename)
            if not ok or type(assetId) ~= "string" or assetId == "" then
                warn("[ScriptMM2 AUDIO] Local asset unavailable: " .. which .. " (" .. tostring(assetId) .. ")")
                return
            end
            if MenuAudio.unloaded then return end
            local sound = Instance.new("Sound")
            sound.Name = "ScriptMM2_UI_" .. which
            sound.SoundId = assetId
            sound.Volume = (MenuAudio.volumes[which] or 0.4) * MenuAudio.volumeFactor
            sound.Looped = false
            sound.Parent = SoundService
            -- Preload before publishing it to button handlers: on first click
            -- a not-yet-loaded MP3 must be skipped, not played after the tween.
            local preloadOK, preloadErr = pcall(function()
                ContentProvider:PreloadAsync({sound})
            end)
            if MenuAudio.unloaded then
                sound:Destroy()
                return
            end
            if not preloadOK or not sound.IsLoaded then
                warn("[ScriptMM2 AUDIO] Not preloaded: " .. which .. " (" .. tostring(preloadErr) .. ")")
                sound:Destroy()
                return
            end
            MenuAudio.ready[which] = sound
            print("[ScriptMM2 AUDIO] Preloaded: " .. which)
        end)
    end
end

