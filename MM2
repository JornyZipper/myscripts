        return
    end
    if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseMovement then
        return
    end

    local camera = Workspace.CurrentCamera
    if not camera then
        return
    end

    local delta = input.Position - reopenDragStart
    local viewport = camera.ViewportSize
    local halfX = reopen.AbsoluteSize.X * 0.5
    local halfY = reopen.AbsoluteSize.Y * 0.5

    local newX = reopenStartPosition.X.Offset + delta.X
    local newY = reopenStartPosition.Y.Offset + delta.Y
    newX = math.clamp(newX, -viewport.X * 0.5 + halfX + 6, viewport.X * 0.5 - halfX - 6)
    newY = math.clamp(newY, -viewport.Y * 0.5 + halfY + 6, viewport.Y * 0.5 - halfY - 6)

    reopen.Position = UDim2.new(0.5, newX, 0.5, newY)
end))

