--// V0.9.15: player-picked normal weapon attempt; no arbitrary server damage.
do
    local attackBusy, attackCooldownUntil = false, 0
    UIRefs.paintAttackSelection = function()
        for player, button in pairs(UIRefs.attackPlayerButtons or {}) do
            if button and button.Parent then
                setButtonVisual(button, player == UIRefs.selectedAttackPlayer)
            end
        end
    end
    UIRefs.clearAttackSelection = function()
        UIRefs.selectedAttackPlayer = nil
        if UIRefs.attackStatus then UIRefs.attackStatus.Text = "Select a player. Normal weapon only." end
        UIRefs.paintAttackSelection()
    end
    UIRefs.attackSelected = function()
        if state.unloaded or attackBusy or os.clock() < attackCooldownUntil then return end
        local target = UIRefs.selectedAttackPlayer
        local function status(message)
            if state.unloaded then return end
            UIRefs.attackStatus.Text = message
            UIRefs.Status.Text = message
        end
        if not target or target.Parent ~= Players or target == LocalPlayer then
            status("Attack: select an available player first") return
        end
        if state.bringActive then
            status("Attack: stop client-only Bring first; it cannot confirm server distance") return
        end
        if teleportBusy or flingBusy or shootMurdererBusy or state.coinFarm then
            status("Attack: finish TP / Fling / Shot / Coin Farm first") return
        end
        attackBusy = true
        attackCooldownUntil = os.clock() + 0.35
        local ok, err = pcall(function()
            if not refreshRoles() then status("Attack: roles unavailable") return end
            if not roleAlive(target.Name) then status("Attack: selected player is unavailable/dead") return end
            local myRole = getRoleName(LocalPlayer.Name)
            if myRole == "Sheriff" or myRole == "Hero" then
                if target.Name ~= Murder then
                    status("Attack: revolver may only target the current Murderer") return
                end
                status("Attack: attempting regular revolver shot at " .. target.DisplayName)
                shootMurderer()
                return
            end
            if myRole ~= "Murderer" then
                status("Attack: you need a knife (Murderer) or revolver (Sheriff/Hero)") return
            end
            local char, hum, root = getCharacter(), getHumanoid(), getRoot()
            local targetChar = target.Character
            local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
            if not char or not hum or hum.Health <= 0 or not root or not targetRoot then
                status("Attack: character/target part unavailable") return
            end
            -- Only attempt when positions are nearby in the replicated view; this is not server validation.
            local distance = (root.Position - targetRoot.Position).Magnitude
            if distance > 7 then
                status(string.format("Attack: %.1f studs away; move within 7 studs", distance)) return
            end
            local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
            local knife
            for _, holder in ipairs({char, backpack}) do
                if holder then
                    for _, item in ipairs(holder:GetChildren()) do
                        if item:IsA("Tool") and item.Name:lower():find("knife", 1, true) then
                            knife = item break
                        end
                    end
                end
                if knife then break end
            end
            if not knife then status("Attack: knife not found") return end
            if knife.Parent ~= char then
                hum:EquipTool(knife)
                task.wait(0.05)
            end
            if state.unloaded or LocalPlayer.Character ~= char or hum.Health <= 0
                or target.Character ~= targetChar or not roleAlive(target.Name) or knife.Parent ~= char then
                status("Attack: cancelled (weapon/target changed)") return
            end
            knife:Activate()
            status("Attack attempt: " .. target.DisplayName .. " • server damage unverified")
            task.delay(0.1, function() pcall(function() knife:Deactivate() end) end)
        end)
        attackBusy = false
        if not ok then status("Attack error: " .. tostring(err)) end
    end
    addConnection(UIRefs.attackButton.MouseButton1Click:Connect(function()
        task.spawn(UIRefs.attackSelected)
    end))
end

--// AimLock tracks only the living murderer from the shared role data.
local function getMurdererAimPart()
    if not rolesAvailable or Murder == "" or Murder == LocalPlayer.Name then
        return nil
    end

    local murderer = Players:FindFirstChild(Murder)
    if not murderer or not roleAlive(Murder) then
        return nil
    end

    local character = murderer.Character
    -- Body-only target: R15 UpperTorso, R6 Torso, then central body fallback.
    for _, name in ipairs({"UpperTorso", "Torso", "HumanoidRootPart", "LowerTorso"}) do
        local part = character and character:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            return part
        end
    end
    return nil
end

