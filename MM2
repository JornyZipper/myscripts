--// UI actions
-- Inflate on opening and gently deflate on minimizing. Tweens are event based:
-- no RenderStepped or Heartbeat animation workload, even while Coin Farm is ON.
local visibilityTween = nil
local visibilitySerial = 0
local function setMainVisible(visible, instant)
    if state.unloaded then return end
    visibilitySerial += 1
    local serial = visibilitySerial
    state.uiVisible = visible
    if visibilityTween then
        visibilityTween:Cancel()
        visibilityTween = nil
    end
    local scale = UIRefs.WindowScale
    local function tweenScale(value, duration, easing, direction, onDone)
        if serial ~= visibilitySerial or state.unloaded then return end
        local tween = TweenService:Create(scale,
            TweenInfo.new(duration, easing, direction), {Scale = value * (UIStyling.userScale * (UIRefs.desktopFit or 1))})
        visibilityTween = tween
        tween.Completed:Once(function(playback)
            if serial ~= visibilitySerial or state.unloaded then return end
            if playback ~= Enum.PlaybackState.Completed then return end
            visibilityTween = nil
            if onDone then onDone() end
        end)
        tween:Play()
    end
    if visible then
        UIRefs.reopen.Visible = false
        UIRefs.Main.Visible = true
        if instant then
            scale.Scale = (UIStyling.userScale * (UIRefs.desktopFit or 1))
        else
            playMenuSound("open")
            -- Sharp inflate: fast initial pop, visible overshoot and quick rebound.
            scale.Scale = 0.43 * (UIStyling.userScale * (UIRefs.desktopFit or 1))
            tweenScale(1.105, 0.135, Enum.EasingStyle.Back, Enum.EasingDirection.Out, function()
                tweenScale(0.975, 0.065, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, function()
                    tweenScale(1, 0.065, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                end)
            end)
        end
    elseif instant then
        UIRefs.Main.Visible = false
        UIRefs.reopen.Visible = false
        scale.Scale = (UIStyling.userScale * (UIRefs.desktopFit or 1))
    else
        playMenuSound("close")
        -- Short air release: brief recoil followed by a fast collapse.
        tweenScale(1.045, 0.045, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, function()
            tweenScale(0.25, 0.145, Enum.EasingStyle.Back, Enum.EasingDirection.In, function()
                UIRefs.Main.Visible = false
                UIRefs.reopen.Visible = false
                scale.Scale = (UIStyling.userScale * (UIRefs.desktopFit or 1))
            end)
        end)
    end
end

