            if wanted and not A.ready then
                if type(UIRefs.AutoRunSource) ~= "string" or #UIRefs.AutoRunSource < 128 then
                    ok, message = false, "Auto Run needs this complete .lua file."
                else
                    ok, message = save(sourcePath, UIRefs.AutoRunSource)
                    if ok and not A.disposed and revision == A.revision then
                        ok, message = save(loaderPath, A.bootstrap)
                    end
                    A.ready = ok and not A.disposed and revision == A.revision
                end
            end
            if A.disposed then break end
            if revision == A.revision then
                if ok then ok, message = save(settingsPath, wanted and "1" or "0") end
                if A.disposed then break end
                if revision == A.revision then
                    A.enabled = ok and wanted
                    runtime.enabled = A.enabled
                    if not ok then
                        A.status = message
                        warn("[ScriptMM2 AUTO] " .. tostring(message))
                    elseif not wanted then
                        A.status = "Auto Run is OFF. Future joins will skip this menu."
                    else
                        local queued = runtime.queued == A.bootstrap
                        if queue and not queued then
                            local queueOK, result = pcall(queue, A.bootstrap)
                            queued = queueOK and result ~= false
                            if queued then runtime.queued = A.bootstrap end
                        end
                        if A.disposed then break end
                        if revision == A.revision then
                            A.status = queued and "ON: server transfers are queued. Fresh joins need Autoexec."
                                or "ON: saved loader is ready. Put it in your executor's Autoexec."
                        end
                    end
                end
            end
