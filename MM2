--// Drop detection must never select a gun carried by a player or an NPC.
local function isInCharacter(object, characters)
    local ancestor = object
    while ancestor and ancestor ~= Workspace do
        if characters[ancestor]
            or (ancestor:IsA("Model") and ancestor:FindFirstChildOfClass("Humanoid")) then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end

local function getDropPart(object)
    if object:IsA("BasePart") then
        return object
    end
    if not (object:IsA("Tool") or object:IsA("Model") or object:IsA("Folder")) then
        return nil
    end

    -- Prefer the actual pickup trigger over the gun's decorative mesh.
    local touch = object:FindFirstChildWhichIsA("TouchTransmitter", true)
    if touch and touch.Parent and touch.Parent:IsA("BasePart") then
        return touch.Parent
    end

    local handle = object:FindFirstChild("Handle", true)
    if handle and handle:IsA("BasePart") then
        return handle
    end
    if object:IsA("Model") and object.PrimaryPart then
        return object.PrimaryPart
    end
    return object:FindFirstChildWhichIsA("BasePart", true)
end

local function findRevolverInWorkspace(origin)
    local dropNames = {
        gundrop = true, droppedgun = true, dropgun = true, gunpickup = true,
        revolverdrop = true, droppedrevolver = true, revolverpickup = true,
        pistoldrop = true, droppedpistol = true,
    }
    local weaponNames = {gun = true, revolver = true, pistol = true, sheriff = true}
    local characters = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            characters[player.Character] = true
        end
    end

    local bestPart, bestPriority, bestDistance = nil, -1, math.huge
    for _, object in ipairs(Workspace:GetDescendants()) do
        local name = string.lower(object.Name):gsub("[^%w]", "")
        local isDrop = dropNames[name]
        local isWeapon = weaponNames[name]
        if (isDrop or isWeapon) and not isInCharacter(object, characters) then
            local part = getDropPart(object)
            local isTool = object:IsA("Tool")
            local hasTouch = part and part:FindFirstChildOfClass("TouchTransmitter")
            if part and (isDrop or isTool or hasTouch) then
                local priority = isDrop and 100 or (isTool and 50 or 25)
                local distance = (part.Position - origin).Magnitude
                if priority > bestPriority or (priority == bestPriority and distance < bestDistance) then
                    bestPart, bestPriority, bestDistance = part, priority, distance
                end
            end
        end
    end
    return bestPart
end

local teleportBusy = false
local revolverTrip = nil

local function finishRevolverTrip()
    local trip = revolverTrip
    if not trip or trip.finished then
        return false
    end
    trip.finished = true
    if trip.stepConnection then
        trip.stepConnection:Disconnect()
    end
    -- Never move a new character after death/respawn during the pickup.
    local returned, returnError = false, nil
    if LocalPlayer.Character == trip.character and trip.character.Parent
        and trip.root.Parent and trip.humanoid.Health > 0 then
        local ok, err = pcall(function()
            trip.character:PivotTo(trip.returnPivot)
            trip.root.AssemblyLinearVelocity = Vector3.zero
            trip.root.AssemblyAngularVelocity = Vector3.zero
        end)
        returned, returnError = ok, err
    end

    -- Restore flight even if returning failed or the character was replaced.
    if trip.flyVelocity and trip.flyVelocity.Parent then
        trip.flyVelocity.MaxForce = trip.flyMaxForce
    end
    if trip.flyGyro and trip.flyGyro.Parent then
        trip.flyGyro.MaxTorque = trip.flyMaxTorque
    end

    revolverTrip = nil
    teleportBusy = false
    return returned, returnError
end

local function teleportToRevolver()
    if state.unloaded or teleportBusy or flingBusy then
        return
    end

    local character = getCharacter()
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 or root.Anchored then
        Status.Text = "Pickup: character not ready"
        return
    end
    if findRevolver() then
        Status.Text = "Pickup: you already have a revolver"
        return
    end

    -- Capture the point of the click before searching or waiting.
    local returnPivot = character:GetPivot()
    local returnRootCFrame = root.CFrame
    local deadline = os.clock() + CONFIG.RevolverPickupTimeout
    local target = findRevolverInWorkspace(root.Position)
    if not target then
        Status.Text = "Pickup: no dropped revolver found"
        return
    end

    local trip = {
        character = character, root = root, humanoid = humanoid,
        returnPivot = returnPivot, finished = false,
        flyVelocity = flyObjects.flyVelocity, flyGyro = flyObjects.flyGyro,
    }
    revolverTrip = trip
    teleportBusy = true
    local pickedUp = false
    Status.Text = "Pickup: collecting revolver..."

    local ok, err = pcall(function()
        if trip.flyVelocity and trip.flyVelocity.Parent then
            trip.flyMaxForce = trip.flyVelocity.MaxForce
            trip.flyVelocity.MaxForce = Vector3.zero
            trip.flyVelocity.Velocity = Vector3.zero
        end
        if trip.flyGyro and trip.flyGyro.Parent then
            trip.flyMaxTorque = trip.flyGyro.MaxTorque
            trip.flyGyro.MaxTorque = Vector3.zero
        end

        local standingHeight = humanoid.HipHeight + root.Size.Y * 0.5
        if humanoid.RigType == Enum.HumanoidRigType.R6 then
            local leg = character:FindFirstChild("Left Leg") or character:FindFirstChild("Right Leg")
            standingHeight = standingHeight + (leg and leg.Size.Y or 2)
        end
        local destination = target.Position + Vector3.new(0, standingHeight + target.Size.Y * 0.5 + 0.15, 0)
        local rootToPivot = returnRootCFrame:ToObjectSpace(returnPivot)
        local destinationRoot = CFrame.new(destination) * returnRootCFrame.Rotation

        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        character:PivotTo(destinationRoot * rootToPivot)

        -- Keep the character unanchored: a small physical movement is needed
        -- for touch pickups; changing CFrame alone does not fire Touched.
        trip.stepConnection = RunService.PreSimulation:Connect(function()
            if not trip.finished and not state.unloaded and LocalPlayer.Character == character
                and root.Parent and humanoid.Health > 0 then
                humanoid:Move(Vector3.zero, false)
                root.AssemblyLinearVelocity = Vector3.new(0, -3, 0)
                root.AssemblyAngularVelocity = Vector3.zero
            end
        end)

        repeat
            -- A vanished drop can mean another player took it. Only a Tool in
            -- our own Character/Backpack confirms that the pickup succeeded.
            pickedUp = findRevolver() ~= nil
            if pickedUp or trip.finished or state.unloaded or os.clock() >= deadline
                or LocalPlayer.Character ~= character or not root.Parent or humanoid.Health <= 0 then
                break
            end
            RunService.Heartbeat:Wait()
        until false
    end)

    if trip.finished then
        return
    end
    local returned, returnError = finishRevolverTrip()
    if state.unloaded then
        return
    end
    if not ok then
        Status.Text = "Pickup error: " .. tostring(err)
    elseif returnError then
        Status.Text = "Return error: " .. tostring(returnError)
    elseif not returned then
        Status.Text = "Pickup cancelled: character changed/dead"
    elseif pickedUp then
        Status.Text = "Revolver collected • returned to starting point"
    else
        Status.Text = "Returned • server did not confirm the pickup"
    end
end

