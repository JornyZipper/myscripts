            if vy * velocity.Y < 0 or math.abs(velocity.Y) < 2 then vy = velocity.Y end
            local gravity = tonumber(Workspace.Gravity) or 196.2
            if gravity ~= gravity or gravity < 0 or gravity > 500 then gravity = 196.2 end
            local horizon = math.min(delay, 0.08)
            local dy = (vy * horizon - 0.5 * gravity * horizon * horizon) * confidence
            local size = chest.Size
            local limit = Silent.isFiniteAimVector(size) and math.clamp(size.Y * 0.42, 0.35, 1.25) or 0.7
            return math.clamp(dy, -limit, limit)
        end

        function auto.offset(chest, part)
            local at = os.clock()
            local delay = auto.networkDelay(at)
            auto.leadSeconds = 0
            if not delay or delay <= 0 then return Vector3.zero end
            local motion = auto.sample(part, at)
            if not motion or at - motion.at > 0.12 then return Vector3.zero end
            local horizontal = Vector3.zero
            local speed = motion.velocity.Magnitude
            if at >= motion.holdUntil and speed >= 0.3 then
                local confidence = math.clamp(motion.steady / 0.07, 0, 1)
                if motion.turnConfirmed then confidence = math.max(0.4, confidence) end
                confidence *= math.clamp(1 - math.max(0, at - motion.movedAt - 0.05) / 0.05, 0, 1)
                local size = chest.Size
                local margin = Silent.isFiniteAimVector(size) and math.clamp(size.X * 0.45, 0.35, 1.25) or 0.7
                local lead = math.min(delay, margin / math.max(motion.error, 0.01), 4 / speed) * confidence
                horizontal, auto.leadSeconds = motion.velocity * lead, lead
            end
            local vertical = at >= motion.holdUntil and auto.verticalOffset(chest, part, motion, delay, at) or 0
            local result = horizontal + Vector3.new(0, vertical, 0)
            if not Silent.isFiniteAimVector(result) then return Vector3.zero end
            if result.Magnitude > 4 then result = result.Unit * 4 end
            return result
        end


        function auto.context()
            local character = LocalPlayer.Character
            local generation = Silent.xenoWatcherGeneration
            if auto.character ~= character or auto.generation ~= generation then
                auto.reset(true)
                auto.character, auto.generation = character, generation
            end
            return character
        end
        function auto.tick()
            if state.unloaded or not state.silentGun or not state.silentAutoPredict
                or state.spectateMurderer then
                auto.reset(true)
                return
            end
            local character = auto.context()
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local part = rolesAvailable and Murder ~= "" and Silent.target(Murder)
            if not humanoid or humanoid.Health <= 0 or not part then
                auto.reset(false)
                return
            end
            local at = os.clock()
            auto.networkDelay(at)
            auto.sample(part, at)
        end
        -- The existing unload/reload bucket calls Disconnect on this record.
        -- One sampler per script; toggles and repeated clicks never duplicate it.
        function auto:Disconnect()
            if self.connection then self.connection:Disconnect(); self.connection = nil end
            self.reset(true)
            self.character, self.generation = nil, nil
            if Silent.gunAuto == self then Silent.gunAuto = nil end
        end
        auto.connection = RunService.Heartbeat:Connect(auto.tick)
        table.insert(connections, auto)
    end
    auto.context()
    -- RTT is seconds. Unknown ping uses direct aim; no distance/speed guess.
    -- Horizontal direction follows fresh movement; verified airborne motion gets a short bounded Y lead.
    return position + auto.offset(chest, motionPart)
end

function Silent.cancelGunShot(reason)
    local message = reason == "Silent: target outside circle" and "Silent: shot cancelled; target outside circle"
        or reason == "Silent: path blocked" and "Silent: shot cancelled; path blocked"
        or reason == "Silent: aim data unavailable" and "Silent: shot cancelled; aim data unavailable"
        or "Silent: shot cancelled; target unavailable"
    Silent.lastShotMessage, Silent.lastShotAt = message, os.clock()
    if UIRefs.AimCircleStroke then UIRefs.AimCircleStroke.Color = Color3.fromRGB(150, 150, 150) end
    Silent.feedback(message)
end

-- The target's actual chest volume may intersect the circle while its center
-- leaves it during a jump. FOV acquisition uses the current body, never a lead point.
function Silent.bodyTouchesFOV(camera, part)
    if not camera or not part or not part:IsA("BasePart")
        or not Silent.isFiniteAimVector(part.Position) then return false end
    local viewport = camera.ViewportSize
    local centerX, centerY, radius = viewport.X * 0.5, viewport.Y * 0.5, values.aimRadius
    if viewport.X <= 0 or viewport.Y <= 0 then return false end
    local point, visible = camera:WorldToViewportPoint(part.Position)
    if Silent.isFiniteAimVector(point) and visible and point.Z > 0 then
        local dx, dy = point.X - centerX, point.Y - centerY
        if dx * dx + dy * dy <= radius * radius then return true end
    end
    local size = part.Size
    if not Silent.isFiniteAimVector(size) or size.X <= 0 or size.Y <= 0 or size.Z <= 0 then return false end
    local half = size * 0.5
    local minX, maxX, minY, maxY = math.huge, -math.huge, math.huge, -math.huge
    for x = -1, 1, 2 do
        for y = -1, 1, 2 do
            for z = -1, 1, 2 do
                local corner = part.CFrame:PointToWorldSpace(Vector3.new(half.X * x, half.Y * y, half.Z * z))
                if not Silent.isFiniteAimVector(corner) then return false end
                local screen = camera:WorldToViewportPoint(corner)
                -- Do not form enormous boxes across the camera's near plane.
                if not Silent.isFiniteAimVector(screen) or screen.Z <= 0 then return false end
                minX, maxX = math.min(minX, screen.X), math.max(maxX, screen.X)
                minY, maxY = math.min(minY, screen.Y), math.max(maxY, screen.Y)
            end
        end
    end
    -- Only the part of the body projection actually inside the viewport counts.
    minX, maxX = math.max(0, minX), math.min(viewport.X, maxX)
    minY, maxY = math.max(0, minY), math.min(viewport.Y, maxY)
    if minX > maxX or minY > maxY then return false end
    local dx = math.clamp(centerX, minX, maxX) - centerX
    local dy = math.clamp(centerY, minY, maxY) - centerY
    return dx * dx + dy * dy <= radius * radius
end

-- Both the circle and the click handler use this exact selector.
function Silent.selectGunTarget(origin)
    if state.unloaded or not rolesAvailable or Murder == "" then
        return nil, "Silent: target unavailable"
    end
    local camera, mine = Workspace.CurrentCamera, LocalPlayer.Character
    local target = Silent.target(Murder)
    local hum = mine and mine:FindFirstChildOfClass("Humanoid")
    if not camera or not mine or not target or not hum or hum.Health <= 0 then
        return nil, "Silent: target unavailable"
    end
    local chest = target.Parent:FindFirstChild("UpperTorso") or target.Parent:FindFirstChild("Torso")
    if not chest or not chest:IsA("BasePart") then chest = target end
    local predicted = Silent.gunAimPosition(chest, target)
    if not predicted then return nil, "Silent: aim data unavailable" end
    if not Silent.bodyTouchesFOV(camera, chest) then
        return nil, "Silent: target outside circle"
    end
    if state.aimVisibleOnly and not state.wallbang then
        local rayOrigin = typeof(origin) == "CFrame" and origin.Position or camera.CFrame.Position
        if not Silent.isFiniteAimVector(rayOrigin) then return nil, "Silent: aim data unavailable" end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {mine}
        params.IgnoreWater = true
        local hit = Workspace:Raycast(rayOrigin, predicted - rayOrigin, params)
        if hit and (not hit.Instance or not hit.Instance:IsDescendantOf(target.Parent)) then
            return nil, "Silent: path blocked"
        end
    end
    return CFrame.new(predicted), "Silent: target ready; hit unverified"
end

function Silent.shotContext()
    local char, gun = LocalPlayer.Character, Silent.xenoTool
    if state.unloaded or not state.silentGun then return nil, "Silent: OFF" end
    if not Silent.xenoInstalled or not gun then return nil, "Silent: waiting for revolver" end
    if not char or gun.Parent ~= char then return nil, "Silent: equip revolver" end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil, "Silent: weapon unavailable" end
    if not gun.Enabled then return nil, "Silent: weapon cooling down" end
    local root = char:FindFirstChild("HumanoidRootPart")
    local attachment = root and root:FindFirstChild("GunRaycastAttachment")
    if not attachment or not attachment:IsA("Attachment") then
        return nil, "Silent: shot attachment missing"
    end
    local remote = gun:FindFirstChild("Shoot")
    if not remote or not remote:IsA("RemoteEvent") then return nil, "Silent: weapon unavailable" end
    local origin = attachment.WorldCFrame
    if typeof(origin) ~= "CFrame" or not Silent.isFiniteAimVector(origin.Position) then
        return nil, "Silent: aim data unavailable"
    end
    return {gun = gun, remote = remote, origin = origin}
end

function Silent.xenoTargetCFrame(origin)
    if not state.silentGun then return nil, "Silent: OFF" end
    return Silent.selectGunTarget(origin)
end

function Silent.installXeno()
    if Silent.xenoInstalled then return true end
    if type(getconnections) ~= "function" then return false, "Xeno getconnections unavailable" end
    local char, bag = LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack")
    local gun = (char and char:FindFirstChild("Gun")) or (bag and bag:FindFirstChild("Gun"))
    if not gun or not gun:IsA("Tool") then return false, "Equip/pick up Gun first" end
    local client, remote = gun:FindFirstChild("GunClient"), gun:FindFirstChild("Shoot")
    if not client or not client:IsA("LocalScript") or not remote or not remote:IsA("RemoteEvent") then
        return false, "GunClient or Gun.Shoot RemoteEvent not found"
    end
    local okList, list = pcall(getconnections, gun.Activated)
    if not okList or type(list) ~= "table" then return false, "Cannot inspect Gun.Activated connections" end
    -- Xeno can expose the one activated callback while masking its `script`
    -- environment (`getfenv(fn).script == nil`). In a clean, single-script
    -- session the supplied GunClient source has exactly one Activated:Connect.
    -- Accept this narrow fallback ONLY for one visible, active callback and
    -- with the expected GunClient + Shoot objects present. More than one is
    -- ambiguous: refuse instead of disabling unrelated game/third-party code.
    if #list ~= 1 then
        return false, "Expected exactly 1 Gun.Activated handler; found " .. tostring(#list) .. " (restart Roblox; run only this version)"
    end
    local selected = list[1]
    local fnOK, fn = pcall(function() return selected.Function end)
    if not fnOK or type(fn) ~= "function" then
        return false, "Xeno did not expose the sole Gun.Activated function"
    end
    local ownerOK, ownerEnv = pcall(getfenv, fn)
    if ownerOK and type(ownerEnv) == "table" then
        local owner = rawget(ownerEnv, "script")
        if owner ~= nil and owner ~= client then
            return false, "Sole activation handler belongs to another script"
        end
    end
    if type(selected.Disable) ~= "function" or type(selected.Enable) ~= "function" then
        return false, "Xeno connection has no reversible Disable/Enable"
    end
    local enabledOK, wasEnabled = pcall(function() return selected.State end)
    if enabledOK and wasEnabled == false then
        return false, "Original activation handler is already disabled"
    end
    -- Install our replacement before disabling the game's own connection so a
    -- failed :Disable() cannot leave the weapon without a click handler.
    local okConnect, replacement = pcall(function()
        return gun.Activated:Connect(function()
            if state.unloaded or not state.silentGun or LocalPlayer.Character ~= gun.Parent then return end
            local context, contextReason = Silent.shotContext()
            if not context then
                Silent.lastShotMessage, Silent.lastShotAt = contextReason, os.clock()
                Silent.feedback(contextReason)
                return
            end
            local aim, targetReason = Silent.xenoTargetCFrame(context.origin)
            if typeof(aim) ~= "CFrame" then
                -- A jump can move the target out of FOV between preview and click.
                -- Do not replace a lost Silent target with mouse.Hit in the sky.
                Silent.cancelGunShot(targetReason)
                return
            end
            local okShot, shotError = pcall(function()
                context.remote:FireServer(context.origin, aim)
            end)
            local message = okShot and "Silent: shot sent; hit unverified"
                or "Silent: shot failed (see console)"
            Silent.lastShotMessage, Silent.lastShotAt = message, os.clock()
            Silent.feedback(message)
            if not okShot then warn("[ScriptMM2] Gun shot failed: " .. tostring(shotError)) end
        end)
    end)
    if not okConnect or not replacement then return false, "Cannot attach replacement activation: " .. tostring(replacement) end
    local okDisable, disableError = pcall(function() selected:Disable() end)
    if not okDisable then
        replacement:Disconnect()
        return false, "Cannot disable original GunClient: " .. tostring(disableError)
    end
    local stateOK, stateValue = pcall(function() return selected.State end)
    if stateOK and stateValue == true then
        replacement:Disconnect()
        pcall(function() selected:Enable() end)
        return false, "GunClient remained active; refusing a possible double shot"
    end
    Silent.xenoOriginalConnection, Silent.xenoActivation = selected, replacement
    Silent.xenoTool, Silent.xenoInstalled = gun, true
    Silent.xenoAncestry = gun.AncestryChanged:Connect(function(_, parent)
        if not parent and Silent.xenoTool == gun then
            -- Weapon was destroyed/removed at round transition. Preserve user ON preference.
            Silent.restoreXeno(true)
            if not state.unloaded and state.silentGun then
                Silent.xenoStatusKey = nil -- let the retry worker publish WAITING
            end
        end
    end)
    return true
end

local function addConnection(connection, bucket)
    bucket = bucket or connections
    table.insert(bucket, connection)
    return connection
end

local function disconnectBucket(bucket)
    for i = #bucket, 1, -1 do
        local connection = bucket[i]
        if connection and connection.Disconnect then
            pcall(function()
                connection:Disconnect()
            end)
        end
        bucket[i] = nil
    end
end

local function getCharacter()
    return LocalPlayer.Character
end

local function getHumanoid()
    local character = getCharacter()
    if not character then
        return nil
    end
    return character:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local character = getCharacter()
    if not character then
        return nil
    end
    return character:FindFirstChild("HumanoidRootPart")
end

local function stopRegularSpin()
    local root, humanoid = spinState.root, spinState.humanoid
    local anotherOwner = flingBusy or (flyObjects.active and flyObjects.humanoid == humanoid)
    if not anotherOwner then
        if root and root.Parent and spinState.velocity then
            pcall(function() root.AssemblyAngularVelocity = spinState.velocity end)
        end
        if humanoid and humanoid.Parent and humanoid.AutoRotate == false then
            pcall(function() humanoid.AutoRotate = spinState.autoRotate end)
        end
    end
    spinState.root, spinState.humanoid, spinState.velocity = nil, nil, nil
    spinState.autoRotate, spinState.yaw = nil, nil
end

function UIRefs.stepRegularSpin(deltaTime)
    if not state.spin or state.unloaded or state.fly or state.coinFarm or teleportBusy or flingBusy then
        stopRegularSpin()
        return
    end
    local root, humanoid = getRoot(), getHumanoid()
    if not root or not humanoid or humanoid.Health <= 0 or root.Anchored
        or humanoid.Sit or humanoid.PlatformStand then
        stopRegularSpin()
        return
    end
    if spinState.root ~= root or spinState.humanoid ~= humanoid then
        stopRegularSpin()
        local look = root.CFrame.LookVector
        spinState.root, spinState.humanoid = root, humanoid
        spinState.velocity, spinState.autoRotate = root.AssemblyAngularVelocity, humanoid.AutoRotate
        spinState.yaw = math.atan2(-look.X, -look.Z)
    end
    -- Keep an absolute yaw: Shift Lock can replace the root orientation earlier
    -- in this frame. Multiplying its CFrame by a small delta would never accumulate.
    humanoid.AutoRotate = false
    local dt = math.clamp(tonumber(deltaTime) or 0, 0, 0.1)
    local speed = math.clamp(values.spinSpeed, CONFIG.MinSpinSpeed, CONFIG.MaxSpinSpeed)
    spinState.yaw = (spinState.yaw + math.rad(speed) * dt) % (math.pi * 2)
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, spinState.yaw, 0)
    -- Position and linear velocity belong to walking/jumping, never to Spin.
end

function UIRefs.setSpinBinding(enabled)
    if not enabled then
        if spinState.bound then
            pcall(function() RunService:UnbindFromRenderStep(spinState.bindingName) end)
            spinState.bound = false
        end
        stopRegularSpin()
        return true
    end
    if spinState.bound then return true end
    local ok, err = pcall(function()
        RunService:BindToRenderStep(spinState.bindingName, Enum.RenderPriority.Character.Value + 1, function(dt)
            local stepped, stepError = pcall(UIRefs.stepRegularSpin, dt)
            if not stepped then
                if UIRefs.setSpinToggle then UIRefs.setSpinToggle(false) else
                    state.spin = false
                    UIRefs.setSpinBinding(false)
                end
                warn("[ScriptMM2] Spin stopped: " .. tostring(stepError))
                if UIRefs.Status then UIRefs.Status.Text = "Spin stopped: see console" end
            end
        end)
    end)
    if not ok then
        stopRegularSpin()
        return false, err
    end
    spinState.bound = true
    return true
end

local function isAliveCharacter(player)
    local character = player.Character
    if not character then
        return false
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    return humanoid ~= nil and humanoid.Health > 0
end

-- Save only properties a feature actually overrides, per character.
local function applyMovementSettings(humanoid)
    if not humanoid then return end
    local saved = movementSnapshots[humanoid]
    if state.speed or state.jump then
        saved = saved or {}
        movementSnapshots[humanoid] = saved
    end
    if state.speed then
        if saved.walkSpeed == nil then saved.walkSpeed = humanoid.WalkSpeed end
        humanoid.WalkSpeed = values.walkSpeed
    elseif saved and saved.walkSpeed ~= nil then
        humanoid.WalkSpeed = saved.walkSpeed
        saved.walkSpeed = nil
    end
    if state.jump then
        if saved.useJumpPower == nil then
            saved.useJumpPower = humanoid.UseJumpPower
            saved.jumpPower = humanoid.JumpPower
            saved.jumpHeight = humanoid.JumpHeight
        end
        humanoid.UseJumpPower = true
        humanoid.JumpPower = values.jumpPower
    elseif saved and saved.useJumpPower ~= nil then
        humanoid.JumpPower = saved.jumpPower
        humanoid.JumpHeight = saved.jumpHeight
        humanoid.UseJumpPower = saved.useJumpPower
        saved.useJumpPower, saved.jumpPower, saved.jumpHeight = nil, nil, nil
    end
    if saved and next(saved) == nil then movementSnapshots[humanoid] = nil end
end

local function applyCameraFOV()
    local camera = Workspace.CurrentCamera
    if state.unloaded or not fovState.active or not camera then return end
    if fovState.saved[camera] == nil then fovState.saved[camera] = camera.FieldOfView end
    camera.FieldOfView = values.fov
end

local function restoreCameraFOV()
    fovState.active = false
    for camera, value in pairs(fovState.saved) do
        pcall(function() camera.FieldOfView = value end)
    end
    table.clear(fovState.saved)
end

local function isPointerMove(input, source)
    return source and source.UserInputType == Enum.UserInputType.MouseButton1
        and input.UserInputType == Enum.UserInputType.MouseMovement
end

local function isPointerEnd(input, source)
    return source and source.UserInputType == Enum.UserInputType.MouseButton1
        and input.UserInputType == Enum.UserInputType.MouseButton1
end

