--// AimLock tracks only the living murderer from the shared role data.
local function getMurdererAimPart()
    if not rolesAvailable or Murder == "" or Murder == LocalPlayer.Name then
        return nil
    end

    local murderer = Players:FindFirstChild(Murder)
    if not murderer or not roleAlive(Murder) then
        return nil
    end

    local character = murderer.Character
    local head = character and character:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        return head
    end

    local root = character and character:FindFirstChild("HumanoidRootPart")
    return root and root:IsA("BasePart") and root or nil
end

updateAimLock = function()
    if state.unloaded or flingBusy or not state.aimLock or UIS:GetFocusedTextBox() then
        return
    end

    local humanoid = getHumanoid()
    local camera = Workspace.CurrentCamera
    if not humanoid or humanoid.Health <= 0 or not camera then
        return
    end

    -- Leave scripted cameras (including the existing X shot) in control.
    if camera.CameraType == Enum.CameraType.Scriptable then
        return
    end

    local targetPart = getMurdererAimPart()
    if not targetPart then
        return
    end

    local cameraPosition = camera.CFrame.Position
    local targetPosition = targetPart.Position
    if (targetPosition - cameraPosition).Magnitude > 0.001 then
        camera.CFrame = CFrame.lookAt(cameraPosition, targetPosition)
    end
end

--// Infer the active map from nearby anchored, collidable geometry. Characters,
--// loose items, oversized backgrounds, and the whole Workspace are excluded.
local function getFlingMapBounds(position)
    local candidates, nearbyParts, characters = {}, {}, {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then characters[player.Character] = true end
    end

    local function isGeometry(part)
        return part:IsA("BasePart") and part.Anchored and part.CanCollide
            and math.max(part.Size.X, part.Size.Y, part.Size.Z) <= CONFIG.FlingMapMaxSpan
            and not isInCharacter(part, characters)
    end
    for _, part in ipairs(Workspace:GetDescendants()) do
        if isGeometry(part) and (part.Position - position).Magnitude
            <= CONFIG.FlingMapSearchRadius + part.Size.Magnitude * 0.5 then
            table.insert(nearbyParts, part)
            local ancestor = part.Parent
            while ancestor and ancestor ~= Workspace do
                if ancestor:IsA("Model") or ancestor:IsA("Folder") then
                    candidates[ancestor] = (candidates[ancestor] or 0) + 1
                end
                ancestor = ancestor.Parent
            end
        end
    end

    local function measure(parts, skipPositionCheck)
        local low, high, count = nil, nil, 0
        for _, part in ipairs(parts) do
            if isGeometry(part) then
                local half = part.Size * 0.5
                local right, up, look = part.CFrame.RightVector, part.CFrame.UpVector, part.CFrame.LookVector
                local extent = Vector3.new(
                    math.abs(right.X) * half.X + math.abs(up.X) * half.Y + math.abs(look.X) * half.Z,
                    math.abs(right.Y) * half.X + math.abs(up.Y) * half.Y + math.abs(look.Y) * half.Z,
                    math.abs(right.Z) * half.X + math.abs(up.Z) * half.Y + math.abs(look.Z) * half.Z
                )
                local a, b = part.Position - extent, part.Position + extent
                low = low and Vector3.new(math.min(low.X, a.X), math.min(low.Y, a.Y), math.min(low.Z, a.Z)) or a
                high = high and Vector3.new(math.max(high.X, b.X), math.max(high.Y, b.Y), math.max(high.Z, b.Z)) or b
                count = count + 1
            end
        end
        if not low then return nil end
        local size = high - low
        if size.X < 8 or size.Z < 8 or size.X + size.Z < 60
            or math.max(size.X, size.Z) > CONFIG.FlingMapMaxSpan or size.Y > 1024 then
            return nil
        end
        if not skipPositionCheck and (position.X < low.X - 32 or position.X > high.X + 32
            or position.Z < low.Z - 32 or position.Z > high.Z + 32
            or position.Y < low.Y - 32 or position.Y > high.Y + 32) then
            return nil
        end
        return {low = low, high = high, count = count}
    end

    local ranked = {}
    local names = {map = true, currentmap = true, activemap = true, normal = true, roundmap = true}
    for container, hits in pairs(candidates) do
        local name = string.lower(container.Name):gsub("[^%w]", "")
        table.insert(ranked, {
            container = container,
            score = hits + (names[name] and 500 or 0) + (container:IsA("Model") and 10 or 0),
        })
    end
    table.sort(ranked, function(a, b) return a.score > b.score end)
    for index = 1, math.min(8, #ranked) do
        local candidate = ranked[index]
        local bounds = measure(candidate.container:GetDescendants())
        if bounds then
            bounds.name = candidate.container.Name
            bounds.estimated = Workspace.StreamingEnabled == true
            if bounds.estimated then
                bounds.refresh = function()
                    if not candidate.container.Parent then return end
                    local updated = measure(candidate.container:GetDescendants(), true)
                    if updated then
                        -- New streamed sections can expand the bounds, but
                        -- unloading old sections must never shrink them.
                        bounds.low = Vector3.new(math.min(bounds.low.X, updated.low.X),
                            math.min(bounds.low.Y, updated.low.Y), math.min(bounds.low.Z, updated.low.Z))
                        bounds.high = Vector3.new(math.max(bounds.high.X, updated.high.X),
                            math.max(bounds.high.Y, updated.high.Y), math.max(bounds.high.Z, updated.high.Z))
                    end
                end
            end
            return bounds
        end
    end
    local fallback = measure(nearbyParts)
    if fallback then
        fallback.name = "nearby map geometry"
        fallback.estimated = true
    end
    return fallback
end

local function getFlingExitDirection(bounds, position)
    local exits = {
        {distance = math.abs(position.X - bounds.low.X), direction = Vector3.new(-1, 0, 0)},
        {distance = math.abs(bounds.high.X - position.X), direction = Vector3.new(1, 0, 0)},
        {distance = math.abs(position.Z - bounds.low.Z), direction = Vector3.new(0, 0, -1)},
        {distance = math.abs(bounds.high.Z - position.Z), direction = Vector3.new(0, 0, 1)},
    }
    table.sort(exits, function(a, b) return a.distance < b.distance end)
    return exits[1].direction
end

local function isOutsideFlingMap(bounds, position)
    local margin = CONFIG.FlingExitMargin
    -- Height and speed alone do not mean the murderer left the map.
    return position.X < bounds.low.X - margin or position.X > bounds.high.X + margin
        or position.Z < bounds.low.Z - margin or position.Z > bounds.high.Z + margin
end

--// Murderer fling: spin inside the target until the user presses Stop Fling.
--// Server collision rules/network ownership can prevent the target moving.
stopMurdererFling = function()
    local trip = flingTrip
    if not trip or trip.finished then
        return
    end
    trip.finished = true
    if trip.stepConnection then
        trip.stepConnection:Disconnect()
    end
    if trip.contactConnection then
        trip.contactConnection:Disconnect()
    end
    if trip.spinConstraint then
        pcall(function() trip.spinConstraint:Destroy() end)
    end
    if trip.spinAttachment then
        pcall(function() trip.spinAttachment:Destroy() end)
    end

    local returned, returnError = false, nil
    if trip.active then
        for part, saved in pairs(trip.collisions) do
            if part.Parent then
                pcall(function()
                    part.CanCollide = saved
                end)
                if originalCollisions[part] ~= nil then
                    originalCollisions[part] = saved
                end
            end
        end

        if trip.root.Parent then
            pcall(function()
                trip.root.AssemblyLinearVelocity = Vector3.zero
                trip.root.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        if LocalPlayer.Character == trip.character and trip.character.Parent
            and trip.root.Parent and trip.humanoid.Health > 0 then
            local ok, err = pcall(function()
                trip.character:PivotTo(trip.returnPivot)
                if state.fly then
                    trip.humanoid.PlatformStand = true
                    trip.humanoid.AutoRotate = false
                elseif trip.startedFlying then
                    trip.humanoid.PlatformStand = false
                    trip.humanoid.AutoRotate = true
                else
                    trip.humanoid.PlatformStand = trip.platformStand
                    trip.humanoid.AutoRotate = trip.autoRotate
                end
                if not trip.humanoid.PlatformStand then
                    trip.humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end)
            returned, returnError = ok, err
        end

        if trip.flyVelocity and trip.flyVelocity.Parent and trip.flyMaxForce then
            trip.flyVelocity.MaxForce = trip.flyMaxForce
        end
        if trip.flyGyro and trip.flyGyro.Parent and trip.flyMaxTorque then
            trip.flyGyro.MaxTorque = trip.flyMaxTorque
        end
    end

    flingTrip = nil
    flingBusy = false
    if state.noclip then applyNoclip() else restoreNoclip() end
    if not state.unloaded then
        flingMurdererButton.Text = "Fling Murderer"
        setButtonVisual(flingMurdererButton, false)
    end
    return returned, returnError
end

local function flingMurderer()
    if state.unloaded then return end
    if flingBusy then
        local trip = flingTrip
        local returned, returnError = stopMurdererFling()
        if returnError then
            Status.Text = "Fling return error: " .. tostring(returnError)
        elseif trip and trip.active and not returned then
            Status.Text = "Fling stopped: character changed/dead"
        else
            Status.Text = returned and "Fling stopped • returned" or "Fling stopped"
        end
        return
    end
    if teleportBusy then
        Status.Text = "Fling: wait for the revolver pickup to finish"
        return
    end

    local character = getCharacter()
    local root = getRoot()
    local humanoid = getHumanoid()
    if not character or not root or not humanoid or humanoid.Health <= 0
        or root.Anchored or humanoid.Sit then
        Status.Text = "Fling: character not ready / leave the seat first"
        return
    end

    local trip = {
        character = character, root = root, humanoid = humanoid,
        returnPivot = character:GetPivot(), rootCFrame = root.CFrame,
        platformStand = humanoid.PlatformStand, autoRotate = humanoid.AutoRotate,
        startedFlying = state.fly, collisions = {}, active = false, finished = false,
        flyVelocity = flyObjects.flyVelocity, flyGyro = flyObjects.flyGyro,
    }
    flingTrip = trip
    flingBusy = true
    flingMurdererButton.Text = "Stop Fling [ON]"
    setButtonVisual(flingMurdererButton, true)
    Status.Text = "Fling: checking murderer..."

    local outcome = "Fling stopped • returned"
    local ok, err = pcall(function()
        if not refreshRoles() then
            outcome = "Fling: roles unavailable"
            return
        end
        if trip.finished or state.unloaded then
            return
        end
        local murderer = Murder ~= "" and Players:FindFirstChild(Murder) or nil
        if not murderer or murderer == LocalPlayer or not roleAlive(Murder) then
            outcome = "Fling: no living murderer found"
            return
        end

        local targetCharacter = murderer.Character
        local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
        if not targetRoot or targetRoot.Anchored then
            outcome = "Fling: target is unavailable / anchored"
            return
        end
        if LocalPlayer.Character ~= character or not root.Parent or humanoid.Health <= 0 then
            outcome = "Fling cancelled: character changed/dead"
            return
        end

        local bounds = getFlingMapBounds(targetRoot.Position)
        local direction
        if bounds then
            direction = getFlingExitDirection(bounds, targetRoot.Position)
        else
            -- Spinning remains available outside the map or before its geometry
            -- streams in. Without bounds, do not claim a confirmed map exit.
            local forward = targetRoot.CFrame.LookVector
            local horizontal = Vector3.new(forward.X, 0, forward.Z)
            direction = horizontal.Magnitude > 0.001 and horizontal.Unit or Vector3.new(1, 0, 0)
        end
        local rootToPivot = trip.rootCFrame:ToObjectSpace(trip.returnPivot)
        local boundsRefreshTime = os.clock()
        local outsideSince = nil
        local outsideConfirmed = false
        local runningStatus = bounds and "Fling: fast spin toward " .. bounds.name .. " edge • Stop Fling = return"
            or "Fling: fast spin • Stop Fling = return"
        -- Role lookup can yield while the user changes Fly. Capture the current
        -- controllers immediately before pausing them, not before that request.
        trip.flyVelocity, trip.flyGyro = flyObjects.flyVelocity, flyObjects.flyGyro
        trip.startedFlying = state.fly
        trip.platformStand, trip.autoRotate = humanoid.PlatformStand, humanoid.AutoRotate
        trip.active = true
        Status.Text = runningStatus

        for _, part in ipairs(character:GetChildren()) do
            if part:IsA("BasePart") then
                local saved = originalCollisions[part]
                if saved == nil then saved = part.CanCollide end
                trip.collisions[part] = saved
                part.CanCollide = true
            end
        end
        if trip.flyVelocity and trip.flyVelocity.Parent then
            trip.flyMaxForce = trip.flyVelocity.MaxForce
            trip.flyVelocity.MaxForce = Vector3.zero
            trip.flyVelocity.Velocity = Vector3.zero
        end
        if trip.flyGyro and trip.flyGyro.Parent then
            trip.flyMaxTorque = trip.flyGyro.MaxTorque
            trip.flyGyro.MaxTorque = Vector3.zero
        end
        humanoid.PlatformStand = true
        humanoid.AutoRotate = false

        local spinVelocity = Vector3.new(CONFIG.FlingSpinSpeed, CONFIG.FlingSpinSpeed, CONFIG.FlingSpinSpeed)
        -- Keep applying torque throughout the attempt, rather than giving
        -- one angular impulse that collisions can slow down.
        trip.spinAttachment = Instance.new("Attachment")
        trip.spinAttachment.Name = "ScriptMM2FlingSpinAttachment"
        trip.spinAttachment.Parent = root
        trip.spinConstraint = Instance.new("AngularVelocity")
        trip.spinConstraint.Name = "ScriptMM2FlingSpin"
        trip.spinConstraint.Attachment0 = trip.spinAttachment
        trip.spinConstraint.RelativeTo = Enum.ActuatorRelativeTo.World
        trip.spinConstraint.AngularVelocity = spinVelocity
        trip.spinConstraint.MaxTorque = CONFIG.FlingSpinTorque
        trip.spinConstraint.ReactionTorqueEnabled = false
        trip.spinConstraint.Enabled = true
        trip.spinConstraint.Parent = root

        local function canMaintainContact()
            return not trip.finished and not trip.error and not state.unloaded
                and LocalPlayer.Character == character and murderer.Character == targetCharacter
                and root.Parent and targetRoot.Parent and humanoid.Health > 0
                and not targetRoot.Anchored and rolesAvailable
                and Murder == murderer.Name and roleAlive(murderer.Name)
        end
        local function alignWithMurderer()
            -- Match only the target's position. Keep our physics rotation so
            -- centering inside the target never cancels the rapid spin.
            local contact = CFrame.new(targetRoot.Position) * root.CFrame.Rotation
            character:PivotTo(contact * rootToPivot)
        end

        trip.stepConnection = RunService.PreSimulation:Connect(function()
            if not canMaintainContact() then return end
            local stepOK, stepError = pcall(function()
                local aboveRoof = not bounds or targetRoot.Position.Y > bounds.high.Y + CONFIG.FlingRoofMargin
                local launch = direction * (CONFIG.FlingSpeed * (aboveRoof and 1 or 0.65))
                    + Vector3.new(0, CONFIG.FlingSpeed * (aboveRoof and 0.12 or 0.9), 0)
                humanoid:Move(Vector3.zero, false)
                alignWithMurderer()
                root.AssemblyLinearVelocity = launch
                root.AssemblyAngularVelocity = spinVelocity
            end)
            if not stepOK then trip.error = stepError end
        end)
        trip.contactConnection = RunService.PostSimulation:Connect(function()
            if not canMaintainContact() then return end
            local contactOK, contactError = pcall(function()
                -- Correct upward drift after physics without resetting rotation.
                alignWithMurderer()
            end)
            if not contactOK then trip.error = contactError end
        end)

        repeat
            if trip.finished or state.unloaded or trip.error then break end
            if LocalPlayer.Character ~= character or not root.Parent or humanoid.Health <= 0 then
                outcome = "Fling cancelled: character changed/dead"
                break
            end
            if not rolesAvailable or Murder ~= murderer.Name then
                outcome = "Fling: murderer role changed / roles unavailable"
                break
            end
            if murderer.Character ~= targetCharacter or not targetRoot.Parent or not roleAlive(murderer.Name) then
                outcome = "Fling: target left / died"
                break
            end
            if targetRoot.Anchored then
                outcome = "Fling: target became anchored"
                break
            end
            local currentTime = os.clock()
            if bounds and bounds.refresh and currentTime - boundsRefreshTime >= 0.15 then
                bounds.refresh()
                boundsRefreshTime = currentTime
            end
            if bounds and isOutsideFlingMap(bounds, targetRoot.Position) then
                outsideSince = outsideSince or currentTime
                if not outsideConfirmed and currentTime - outsideSince >= CONFIG.FlingExitConfirmTime then
                    outsideConfirmed = true
                    Status.Text = bounds.estimated and "Fling: outside estimated map bounds • Stop Fling = return"
                        or "Fling: target outside map bounds • Stop Fling = return"
                end
            else
                outsideSince = nil
                if outsideConfirmed then
                    outsideConfirmed = false
                    Status.Text = runningStatus
                end
            end
            RunService.Heartbeat:Wait()
        until false
        if trip.error then error(trip.error) end
    end)

    if trip.finished then return end
    local returned, returnError = stopMurdererFling()
    if state.unloaded then return end
    if not ok then
        Status.Text = "Fling error: " .. tostring(err)
    elseif returnError then
        Status.Text = "Fling return error: " .. tostring(returnError)
    elseif trip.active and not returned then
        Status.Text = "Fling cancelled: character changed/dead"
    else
        Status.Text = outcome
    end
end

local function getLocalRole()
    if LocalPlayer.Name == Murder then
        return "Murderer"
    elseif LocalPlayer.Name == Sheriff then
        return "Sheriff"
    elseif LocalPlayer.Name == Hero then
        return "Hero"
    end
    return "Innocent"
end

local function getRoleColor(role, alive)
    if not alive then
        return ESPColors.Dead
    end

    if role == "Murderer" then
        return ESPColors.Murderer
    elseif role == "Sheriff" then
        return ESPColors.Sheriff
    elseif role == "Hero" then
        return ESPColors.Hero
    elseif role == "Innocent" then
        return ESPColors.Innocent
    elseif role == "Unknown" then
        return ESPColors.Unknown
    end

    return ESPColors.Player
end

local function destroyESPForPlayer(player)
    local object = espObjects[player]
    if object then
        if object.highlight then
            object.highlight:Destroy()
        end
        if object.billboard then
            object.billboard:Destroy()
        end
        if object.tracer then
            object.tracer:Destroy()
        end
        espObjects[player] = nil
    end

    local character = player.Character
    if character then
        for _, child in ipairs(character:GetChildren()) do
            if child.Name == "ModMenuESP" or child.Name == "ModMenuESPInfo" then
                child:Destroy()
            end
        end
    end
end

