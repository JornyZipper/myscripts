local function setTracer(tracer, startPoint, endPoint, color, visible)
    if not tracer then
        return
    end

    tracer.Visible = visible
    if not visible then
        return
    end

    local delta = endPoint - startPoint
    local length = delta.Magnitude
    if length < 1 then
        tracer.Visible = false
        return
    end

    tracer.Position = UDim2.fromOffset((startPoint.X + endPoint.X) * 0.5, (startPoint.Y + endPoint.Y) * 0.5)
    tracer.Size = UDim2.fromOffset(math.max(1.5, math.min(3, 240 / math.max(length, 1))), length)
    tracer.Rotation = math.deg(math.atan2(delta.Y, delta.X)) + 90
    tracer.BackgroundColor3 = color
end

local function updateESP()
    local anyESP = state.esp or state.roleESP or state.innocentESP
    if not anyESP then
        clearESP()
        return
    end

    local camera = Workspace.CurrentCamera
    local localRoot = getRoot()
    local localRole = getLocalRole()
    local viewport = camera and camera.ViewportSize or Vector2.new(0, 0)
    local tracerStart = Vector2.new(viewport.X * 0.5, viewport.Y - 28)

    for _, player in ipairs(Players:GetPlayers()) do
        local isLocal = player == LocalPlayer
        if not isLocal or state.roleESP then
            local role = getRoleName(player.Name)
            local data = roles[player.Name]
            local alive = isLocal and isAliveCharacter(player)
                and not (type(data) == "table" and (data.Killed or data.Dead)) or roleAlive(player.Name)
            local isInnocent = role == "Innocent"
            local show = true

            if state.innocentESP and not state.esp and not state.roleESP then
                show = (localRole == "Murderer" or localRole == "Sheriff" or localRole == "Hero") and isInnocent and alive
            end

            local object = show and createESPForPlayer(player) or nil
            if object then
                local character = player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                local root = character and character:FindFirstChild("HumanoidRootPart")
                local targetRole = role
                local color = state.roleESP and getRoleColor(role, alive) or ESPColors.Player

                if state.innocentESP and not state.esp and not state.roleESP then
                    targetRole = "Innocent"
                    color = ESPColors.Innocent
                end

                if not alive then
                    color = ESPColors.Dead
                end

                object.highlight.FillColor = color
                object.highlight.OutlineColor = color
                object.highlight.FillTransparency = alive and 0.94 or 0.97
                object.highlight.OutlineTransparency = alive and 0.03 or 0.45

                object.billboard.Enabled = state.espInfoCards and not isLocal
                object.cardStroke.Color = color
                object.accent.BackgroundColor3 = color
                object.nameLabel.Text = "@" .. player.Name
                object.nameLabel.Visible = state.espNames
                object.roleLabel.Position = state.espNames and UDim2.fromOffset(13, 22) or UDim2.fromOffset(13, 11)

                local roleText = targetRole == "Unknown" and "PLAYER" or Localization.roleSource(targetRole)
                if state.roleESP or state.innocentESP then
                    Localization.setText(object.roleLabel, roleText)
                else
                    Localization.setText(object.roleLabel, "PLAYER")
                end

                object.roleLabel.TextColor3 = color

                if camera and root and localRoot then
                    local distance = (root.Position - localRoot.Position).Magnitude
                    object.distanceLabel.Text = string.format("%dm", math.floor(distance + 0.5))

                    local screenPoint, onScreen = camera:WorldToViewportPoint(root.Position + Vector3.new(0, 1.6, 0))
                    setTracer(
                        object.tracer,
                        tracerStart,
                        Vector2.new(screenPoint.X, screenPoint.Y),
                        color,
                        not isLocal and state.espLines and alive and onScreen and distance <= 1200
                    )
                else
                    object.distanceLabel.Text = "--"
                    object.tracer.Visible = false
                end
            else
                destroyESPForPlayer(player)
            end
        else
            -- Role ESP OFF must remove our own outline even if ordinary ESP stays ON.
            destroyESPForPlayer(player)
        end
    end
end

clearESP = function()
    local playersToClear = {}
    for player in pairs(espObjects) do
        table.insert(playersToClear, player)
    end

    for _, player in ipairs(playersToClear) do
        destroyESPForPlayer(player)
    end

    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        if character then
            local oldHighlight = character:FindFirstChild("ModMenuESP")
            if oldHighlight then
                oldHighlight:Destroy()
            end
            local oldInfo = character:FindFirstChild("ModMenuESPInfo")
            if oldInfo then
                oldInfo:Destroy()
            end
        end
    end

    for _, child in ipairs(ESPOverlay:GetChildren()) do
        child:Destroy()
    end
end

--// V1.0 PC AntiFling: YARHM-inspired two independent heartbeat guards.
--// Ordinary character collisions are untouched, so standing on players still works.
--// No anchoring: only abnormal motion is neutralized. Server results are unverified.
local antiFlingGuard = {
    character = nil, root = nil, humanoid = nil,
    remoteParts = setmetatable({}, {__mode = "k"}),
    suspiciousUntil = setmetatable({}, {__mode = "k"}),
    safePivot = nil, teleportUntil = 0, jumpUntil = 0,
    lastSafeAt = 0, lastLogAt = -math.huge,
}

local function antiFlingLog(message)
    local g = antiFlingGuard
    if os.clock() - g.lastLogAt < 0.7 then return end
    g.lastLogAt = os.clock()
    warn("[ScriptMM2 AntiFling] " .. message)
end

local function restoreAntiFlingRemoteParts()
    local g = antiFlingGuard
    for part, original in pairs(g.remoteParts) do
        if part and part.Parent then
            pcall(function() part.CanCollide = original end)
        end
        g.remoteParts[part] = nil
    end
end

pauseAntiFling = function()
    restoreAntiFlingRemoteParts()
    local g = antiFlingGuard
    g.character, g.root, g.humanoid, g.safePivot = nil, nil, nil, nil
    g.lastSafeAt = 0
    g.suspiciousUntil = setmetatable({}, {__mode = "k"})
    g.teleportUntil = 0
end

local function antiFlingAvailable()
    return state.antiFling and not state.unloaded and not flingBusy
end

-- YARHM detector: inspect all other characters for excessive linear/angular motion.
-- Only offenders lose their collisions. Ordinary players remain solid/standable.
updateAntiFling = function()
    if not antiFlingAvailable() then
        if antiFlingGuard.character or next(antiFlingGuard.remoteParts) then pauseAntiFling() end
        return
    end
    local g = antiFlingGuard
    local char, root, humanoid = getCharacter(), getRoot(), getHumanoid()
    if not char or not root or not humanoid or humanoid.Health <= 0 then
        if g.character then pauseAntiFling() end
        return
    end
    if char ~= g.character or root ~= g.root then
        pauseAntiFling()
        g.character, g.root, g.humanoid = char, root, humanoid
        g.safePivot = char:GetPivot()
        g.lastSafeAt = os.clock()
    end
    local wanted = {}
    local now = os.clock()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character ~= char then
            local other = player.Character
            local otherRoot = other and other:FindFirstChild("HumanoidRootPart")
            local otherHum = other and other:FindFirstChildOfClass("Humanoid")
            if other and otherRoot and otherRoot:IsA("BasePart") and otherHum
                and otherHum.Health > 0 and other:IsDescendantOf(Workspace) then
                local linear = otherRoot.AssemblyLinearVelocity.Magnitude
                local angular = otherRoot.AssemblyAngularVelocity.Magnitude
                if linear > 100 or angular > 50 then
                    if not g.suspiciousUntil[other] or g.suspiciousUntil[other] < now then
                        antiFlingLog("Suspected flinger: " .. player.Name .. " (linear=" .. math.floor(linear)
                            .. ", angular=" .. math.floor(angular) .. ")")
                    end
                    g.suspiciousUntil[other] = now + 0.45
                end
                if (g.suspiciousUntil[other] or 0) > now then
                    for _, part in ipairs(other:GetDescendants()) do
                        if part:IsA("BasePart") then
                            wanted[part] = true
                            if g.remoteParts[part] == nil then g.remoteParts[part] = part.CanCollide end
                            -- As in the public YARHM backup, neutralize suspicious
                            -- character physics locally (network ownership may limit effect).
                            pcall(function()
                                part.CanCollide = false
                                part.AssemblyLinearVelocity = Vector3.zero
                                part.AssemblyAngularVelocity = Vector3.zero
                            end)
                        end
                    end
                end
            end
        end
    end
    for part, original in pairs(g.remoteParts) do
        if not wanted[part] then
            if part and part.Parent then pcall(function() part.CanCollide = original end) end
            g.remoteParts[part] = nil
        end
    end
end

-- Independent self-protection: never rely on detecting a nearby attacker first.
-- The public YARHM backup uses 250 studs/s or 250 rad/s on the local root.
guardAntiFling = function()
    if not antiFlingAvailable() then return end
    local g = antiFlingGuard
    local char, root, humanoid = g.character, g.root, g.humanoid
    if not char or char ~= LocalPlayer.Character or not root or not root.Parent
        or not humanoid or humanoid.Health <= 0 or humanoid.Sit or root.Anchored then return end
    -- Do not fight intentional movement features or scripted round/TP transitions.
    if teleportBusy or flingBusy or state.fly or state.coinFarm or state.strafe
        or longJumpState.active or os.clock() < g.teleportUntil then return end
    local linear, angular = root.AssemblyLinearVelocity, root.AssemblyAngularVelocity
    local now = os.clock()
    local excessive = linear.Magnitude > 250 or angular.Magnitude > 250
    if excessive then
        local prior = g.safePivot
        -- Do not keep a contaminated, already-flung position as the safe point.
        -- Only recover from a recent valid sample, and never freeze/anchor the root.
        if prior and now - g.lastSafeAt <= 6 then
            pcall(function() char:PivotTo(prior) end)
        end
        local move = humanoid.MoveDirection
        local horizontal = Vector3.new(move.X, 0, move.Z)
        if horizontal.Magnitude > 1 then horizontal = horizontal.Unit end
        horizontal *= humanoid.WalkSpeed
        root.AssemblyLinearVelocity = Vector3.new(horizontal.X, 0, horizontal.Z)
        root.AssemblyAngularVelocity = Vector3.zero
        antiFlingLog("Neutralized own extreme physics (linear=" .. math.floor(linear.Magnitude)
            .. ", angular=" .. math.floor(angular.Magnitude) .. ")")
        return
    end
    -- Update safe position only during ordinary movement, not while already being thrown.
    if linear.Magnitude < 100 and angular.Magnitude < 50
        and (humanoid.FloorMaterial ~= Enum.Material.Air or not g.safePivot) then
        g.safePivot = char:GetPivot()
        g.lastSafeAt = now
    end
end

--// Air steering preserves vertical motion and existing momentum above the cap.
local function calculateStrafeVelocity(velocity, moveDirection, maxSpeed, deltaTime)
    local wish = Vector3.new(moveDirection.X, 0, moveDirection.Z)
    if wish.Magnitude <= 0.05 then return velocity end
    wish = wish.Unit
    local horizontal = Vector3.new(velocity.X, 0, velocity.Z)
    local speed = horizontal.Magnitude
    if speed > maxSpeed + 0.001 then return velocity end
    local dt = math.clamp(deltaTime, 0, 0.1)
    local angle = math.atan2(wish.Z, wish.X)
    if speed > 0.001 then
        local currentAngle = math.atan2(horizontal.Z, horizontal.X)
        local difference = math.atan2(math.sin(angle - currentAngle), math.cos(angle - currentAngle))
        angle = currentAngle + difference * (1 - math.exp(-CONFIG.StrafeTurnRate * dt))
    end
    speed = math.min(maxSpeed, speed + CONFIG.StrafeAcceleration * dt)
    return Vector3.new(math.cos(angle) * speed, velocity.Y, math.sin(angle) * speed)
end

--// Physics movement runs after input, before the simulation.
local function updateMovement(deltaTime)
    if state.coinFarm and UIRefs.refreshCoinFarm then UIRefs.refreshCoinFarm() end
    if state.unloaded or teleportBusy or (flingTrip and flingTrip.active) then
        clearLongJump()
        return
    end
    if state.fly or state.coinFarm or not state.longJump then clearLongJump() end

    local humanoid = getHumanoid()
    local root = getRoot()

    applyMovementSettings(humanoid)
    local canMove = humanoid and root and humanoid.Health > 0 and not root.Anchored
        and not humanoid.Sit and not humanoid.PlatformStand and not state.fly
        and windowFocused and not UIS:GetFocusedTextBox()
    local movementState = humanoid and humanoid:GetState()
    local grounded = humanoid and humanoid.FloorMaterial ~= Enum.Material.Air
    if canMove then
        if state.bunnyHop and grounded and humanoid.MoveDirection.Magnitude > 0.05
            and (movementState == Enum.HumanoidStateType.Running
                or movementState == Enum.HumanoidStateType.RunningNoPhysics
                or movementState == Enum.HumanoidStateType.Landed) then
            humanoid.Jump = true
        end
        -- A genuine jump request arms one bounded horizontal boost; never triggers on its own.
        -- Preserve Y velocity so game gravity and the normal jump arc still apply.
        local now = os.clock()
        if longJumpState.character ~= getCharacter() then clearLongJump() end
        if not state.longJump or state.coinFarm then
            clearLongJump()
        elseif grounded then
            if longJumpState.active then clearLongJump() end
            if now > longJumpState.pendingUntil then longJumpState.pendingUntil = 0 end
        elseif (movementState == Enum.HumanoidStateType.Jumping
            or movementState == Enum.HumanoidStateType.Freefall) then
            if not longJumpState.active and now <= longJumpState.pendingUntil then
                longJumpState.active = true
                longJumpState.startedAt = now
                longJumpState.startPosition = root.Position
                local wish = humanoid.MoveDirection
                if wish.Magnitude < 0.05 then wish = root.CFrame.LookVector end
                wish = Vector3.new(wish.X, 0, wish.Z)
                longJumpState.direction = wish.Magnitude > 0.05 and wish.Unit or Vector3.new(0, 0, -1)
                longJumpState.pendingUntil = 0
            end
            if longJumpState.active then
                local ultra = state.ultraLongJump
                local duration = ultra and CONFIG.UltraJumpDuration or CONFIG.LongJumpDuration
                local distance = longJumpState.startPosition and (root.Position - longJumpState.startPosition).Magnitude or 0
                if now - longJumpState.startedAt <= duration
                    and (not ultra or distance < CONFIG.UltraJumpMaxDistance) then
                    local wish = humanoid.MoveDirection
                    wish = Vector3.new(wish.X, 0, wish.Z)
                    if wish.Magnitude > 0.05 then
                        local blended = longJumpState.direction:Lerp(wish.Unit, math.clamp(deltaTime * 3, 0, 0.25))
                        if blended.Magnitude > 0.05 then longJumpState.direction = blended.Unit end
                    end
                    local v = root.AssemblyLinearVelocity
                    local dir = longJumpState.direction
                    local speed = ultra and CONFIG.UltraJumpSpeed or values.longJumpSpeed
                    -- Keep the ultra boost airborne; ordinary Long Jump preserves normal gravity.
                    local vertical = ultra and math.max(v.Y, 8) or v.Y
                    root.AssemblyLinearVelocity = Vector3.new(dir.X * speed, vertical, dir.Z * speed)
                else
                    longJumpState.active = false
                end
            end
        end
        if state.strafe and not longJumpState.active and not grounded and (movementState == Enum.HumanoidStateType.Jumping
            or movementState == Enum.HumanoidStateType.Freefall) then
            root.AssemblyLinearVelocity = calculateStrafeVelocity(root.AssemblyLinearVelocity,
                humanoid.MoveDirection, values.strafeSpeed, deltaTime)
        end
    end

    if state.noclip and not (state.coinFarm and coinFarm.paused) then
        applyNoclip()
    else
        -- Restore collisions while coin farming waits between rounds.
        if next(originalCollisions) ~= nil then
            restoreNoclip()
        end
    end

    if state.lowGravity then
        Workspace.Gravity = 60
    end

    if state.fly and not (state.coinFarm and coinFarm.paused) then
        if not flyObjects.active
            or not flyObjects.flyVelocity
            or not flyObjects.flyVelocity.Parent
            or not flyObjects.flyGyro
            or not flyObjects.flyGyro.Parent then
            startFly()
        end

        local currentHumanoid = getHumanoid()
        local currentRoot = getRoot()
        local camera = Workspace.CurrentCamera
        local flyVelocity = flyObjects.flyVelocity
        local flyGyro = flyObjects.flyGyro

        if currentHumanoid and currentHumanoid.Health > 0 and currentRoot and not currentRoot.Anchored
            and not currentHumanoid.Sit and camera and flyVelocity and flyGyro and flyObjects.active then
            currentHumanoid.PlatformStand = true
            currentHumanoid.AutoRotate = false

            local movement = Vector3.zero
            local look = camera.CFrame.LookVector
            local right = camera.CFrame.RightVector

            if windowFocused and not UIS:GetFocusedTextBox() then
                local moveDirection = currentHumanoid.MoveDirection
                local flatLook = Vector3.new(look.X, 0, look.Z)

                if flatLook.Magnitude > 0.001 then
                    flatLook = flatLook.Unit
                else
                    local flatRight = Vector3.new(right.X, 0, right.Z)
                    flatLook = flatRight.Magnitude > 0.001
                        and Vector3.new(flatRight.Unit.Z, 0, -flatRight.Unit.X) or Vector3.new(0, 0, -1)
                end
                local flatRight = Vector3.new(-flatLook.Z, 0, flatLook.X)

                if moveDirection.Magnitude > 0.001 then
                    movement += look * moveDirection:Dot(flatLook)
                    movement += right * moveDirection:Dot(flatRight)
                end
                if UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) or flyObjects.up then
                    movement += Vector3.new(0, 1, 0)
                end
                if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.Q) or flyObjects.down then
                    movement -= Vector3.new(0, 1, 0)
                end
            end

            if movement.Magnitude > 0.001 then
                movement = movement.Unit * values.flySpeed
            else
                movement = Vector3.zero
            end

            if state.coinFarm and UIRefs.coinFarmVelocity then
                movement = UIRefs.coinFarmVelocity(currentRoot)
            end
            flyVelocity.Velocity = movement

            if look.Magnitude > 0.001 then
                flyGyro.CFrame = CFrame.lookAt(currentRoot.Position, currentRoot.Position + look)
            end
        elseif flyObjects.active then
            stopFly()
        end
    elseif flyObjects.active then
        stopFly()
    end

end
