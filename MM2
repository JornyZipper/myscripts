    for _, child in ipairs(ESPOverlay:GetChildren()) do
        child:Destroy()
    end
end

--// AntiFling changes only our collision pairs. Map collisions remain active.
local antiFlingGuard = {pairs = {}, scanTime = -math.huge, jumpUntil = 0, teleportUntil = 0}

local function releaseAntiFlingHold(preserveVelocity)
    local guard = antiFlingGuard
    if guard.holding and guard.root and guard.root.Parent and not preserveVelocity then
        guard.root.AssemblyLinearVelocity = Vector3.zero
        guard.root.AssemblyAngularVelocity = Vector3.zero
    end
    guard.holding = false
    guard.idlePivot = nil
end

pauseAntiFling = function()
    releaseAntiFlingHold()
    for _, targets in pairs(antiFlingGuard.pairs) do
        for _, constraint in pairs(targets) do
            pcall(function() constraint:Destroy() end)
        end
    end
    if antiFlingGuard.folder then
        pcall(function() antiFlingGuard.folder:Destroy() end)
    end
    antiFlingGuard.pairs = {}
    antiFlingGuard.folder = nil
    antiFlingGuard.character, antiFlingGuard.root, antiFlingGuard.humanoid = nil, nil, nil
    antiFlingGuard.safePivot = nil
    antiFlingGuard.scanTime = -math.huge
    antiFlingGuard.teleportUntil = 0
end

-- Accept a discrete relocation with ordinary velocity before restoring any
-- held position. This is a teleport heuristic, not proof of server authority.
-- Player contact remains blocked throughout the short landing grace period.
local function acceptAntiFlingTeleport()
    local guard = antiFlingGuard
    local baseline = guard.idlePivot or guard.safePivot
    if not baseline or not guard.character or not guard.root or guard.root.Anchored then return false end
    local current = guard.character:GetPivot()
    if (current.Position - baseline.Position).Magnitude < CONFIG.AntiFlingTeleportDistance then return false end
    local velocity = guard.root.AssemblyLinearVelocity
    local horizontal = Vector3.new(velocity.X, 0, velocity.Z)
    if horizontal.Magnitude > math.max(80, guard.humanoid.WalkSpeed * 2)
        or math.abs(velocity.Y) > 100 or guard.root.AssemblyAngularVelocity.Magnitude > 80 then return false end
    releaseAntiFlingHold(true)
    guard.safePivot = current
    guard.teleportUntil = os.clock() + CONFIG.AntiFlingTeleportGrace
    return true
end

local function refreshAntiFlingPairs(character)
    local guard = antiFlingGuard
    if not guard.folder then
        guard.folder = Instance.new("Folder")
        guard.folder.Name = "ScriptMM2AntiFling"
        guard.folder.Parent = character
    end
    local wanted, body = {}, {}
    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") and part.CanCollide then table.insert(body, part) end
    end
    local ownRoot = character:FindFirstChild("HumanoidRootPart")
    for _, player in ipairs(Players:GetPlayers()) do
        local theirCharacter = player.Character
        local theirRoot = theirCharacter and theirCharacter:FindFirstChild("HumanoidRootPart")
        if player ~= LocalPlayer and theirRoot and ownRoot
            and (theirRoot.Position - ownRoot.Position).Magnitude <= CONFIG.AntiFlingNearbyRadius then
            for _, targetPart in ipairs(theirCharacter:GetChildren()) do
                if targetPart:IsA("BasePart") and targetPart.CanCollide then
                    for _, part in ipairs(body) do
                        wanted[part] = wanted[part] or {}
                        wanted[part][targetPart] = true
                        guard.pairs[part] = guard.pairs[part] or {}
                        local constraint = guard.pairs[part][targetPart]
                        if not constraint or not constraint.Parent then
                            constraint = Instance.new("NoCollisionConstraint")
                            constraint.Name = "AntiFlingPlayerContact"
                            constraint.Part0, constraint.Part1 = part, targetPart
                            constraint.Enabled = true
                            constraint.Parent = guard.folder
                            guard.pairs[part][targetPart] = constraint
                        end
                    end
                end
            end
        end
    end
    for part, targets in pairs(guard.pairs) do
        for targetPart, constraint in pairs(targets) do
            if not wanted[part] or not wanted[part][targetPart] then
                constraint:Destroy()
                targets[targetPart] = nil
            end
        end
        if not next(targets) then guard.pairs[part] = nil end
    end
end

updateAntiFling = function()
    if state.unloaded or not state.antiFling or teleportBusy or flingBusy then
        if antiFlingGuard.character then pauseAntiFling() end
        return
    end
    local character, root, humanoid = getCharacter(), getRoot(), getHumanoid()
    if not character or not root or not humanoid or humanoid.Health <= 0 or humanoid.Sit then
        pauseAntiFling()
        return
    end
    if antiFlingGuard.character ~= character or antiFlingGuard.root ~= root then
        pauseAntiFling()
        if root.Anchored then return end
        antiFlingGuard.character, antiFlingGuard.root, antiFlingGuard.humanoid = character, root, humanoid
        antiFlingGuard.safePivot = character:GetPivot()
    end
    if root.Anchored then
        pauseAntiFling()
        return
    end
    if os.clock() - antiFlingGuard.scanTime >= CONFIG.AntiFlingScanInterval then
        refreshAntiFlingPairs(character)
        antiFlingGuard.scanTime = os.clock()
    end
    -- A saved-pivot idle lock used to undo normal server round teleports.
    -- Never PivotTo an old position as part of AntiFling. Contact protection
    -- stays active and the character remains under the game's movement code.
    antiFlingGuard.safePivot = character:GetPivot()
end

guardAntiFling = function()
    local guard = antiFlingGuard
    if not state.antiFling or state.unloaded or teleportBusy or flingBusy
        or not guard.character or LocalPlayer.Character ~= guard.character
        or not guard.root.Parent or guard.humanoid.Health <= 0 then return end
    if guard.root.Anchored or guard.humanoid.Sit then return end

    -- Detect relocation rather than fighting it. Even high-velocity server
    -- teleports must not be snapped back to the previous spawn/lobby point.
    local current = guard.character:GetPivot()
    local previous = guard.safePivot
    guard.safePivot = current
    if previous and (current.Position - previous.Position).Magnitude >= CONFIG.AntiFlingTeleportDistance then
        local lv = guard.root.AssemblyLinearVelocity.Magnitude
        local av = guard.root.AssemblyAngularVelocity.Magnitude
        local permittedTeleport = state.fly and math.max(180, values.coinFarmSpeed * 2.5, values.flySpeed * 2.5)
            or math.max(110, guard.humanoid.WalkSpeed * 4, (longJumpState.active and (state.ultraLongJump and CONFIG.UltraJumpSpeed or values.longJumpSpeed) * 1.35 or 0))
        if lv <= permittedTeleport and av <= 160 then
            guard.teleportUntil = os.clock() + CONFIG.AntiFlingTeleportGrace
            return
        end
        -- Suspicious physics fling: fall through to recovery below.
    end
    if os.clock() < guard.teleportUntil then return end

    -- AntiFling must remain operational while Coin Farm owns Fly/NoClip.
    -- Respect the configured movement speed and ignore discrete normal-speed
    -- game teleports (handled by the teleport-grace branch above).
    local velocity = guard.root.AssemblyLinearVelocity
    local angular = guard.root.AssemblyAngularVelocity
    local permitted = state.fly and math.max(180, values.coinFarmSpeed * 2.5, values.flySpeed * 2.5)
        or math.max(110, guard.humanoid.WalkSpeed * 4, (longJumpState.active and (state.ultraLongJump and CONFIG.UltraJumpSpeed or values.longJumpSpeed) * 1.35 or 0))
    local abnormal = velocity.Magnitude > permitted or angular.Magnitude > 160
    if abnormal then
        guard.root.AssemblyAngularVelocity = Vector3.zero
        if previous and (current.Position - previous.Position).Magnitude > 12 then
            -- Recover only a high-velocity physics launch, not a normal teleport.
            pcall(function() guard.character:PivotTo(previous) end)
            guard.safePivot = previous
            guard.root.AssemblyLinearVelocity = Vector3.zero
        elseif velocity.Magnitude > permitted then
            guard.root.AssemblyLinearVelocity = velocity.Unit * math.min(permitted * 0.5, 65)
        end
    end
end

--// Air steering preserves vertical motion and existing momentum above the cap.
local function calculateStrafeVelocity(velocity, moveDirection, maxSpeed, deltaTime)
    local wish = Vector3.new(moveDirection.X, 0, moveDirection.Z)
    if wish.Magnitude <= 0.05 then return velocity end
    wish = wish.Unit
    local horizontal = Vector3.new(velocity.X, 0, velocity.Z)
    local speed = horizontal.Magnitude
    if speed > maxSpeed + 0.001 then return velocity end
    local dt = math.clamp(deltaTime, 0, 0.1)
    local angle = math.atan2(wish.Z, wish.X)
    if speed > 0.001 then
        local currentAngle = math.atan2(horizontal.Z, horizontal.X)
        local difference = math.atan2(math.sin(angle - currentAngle), math.cos(angle - currentAngle))
        angle = currentAngle + difference * (1 - math.exp(-CONFIG.StrafeTurnRate * dt))
    end
    speed = math.min(maxSpeed, speed + CONFIG.StrafeAcceleration * dt)
    return Vector3.new(math.cos(angle) * speed, velocity.Y, math.sin(angle) * speed)
end

--// Physics movement runs after input, before the simulation.
local function updateMovement(deltaTime)
    if state.coinFarm and UIRefs.refreshCoinFarm then UIRefs.refreshCoinFarm() end
    if state.unloaded or teleportBusy or (flingTrip and flingTrip.active) then
        clearLongJump()
        return
    end
    if state.fly or state.coinFarm or not state.longJump then clearLongJump() end

    local humanoid = getHumanoid()
    local root = getRoot()

    applyMovementSettings(humanoid)
    local canMove = humanoid and root and humanoid.Health > 0 and not root.Anchored
        and not humanoid.Sit and not humanoid.PlatformStand and not state.fly
        and windowFocused and not UIS:GetFocusedTextBox()
    local movementState = humanoid and humanoid:GetState()
    local grounded = humanoid and humanoid.FloorMaterial ~= Enum.Material.Air
    if canMove then
        if state.bunnyHop and grounded and humanoid.MoveDirection.Magnitude > 0.05
            and (movementState == Enum.HumanoidStateType.Running
                or movementState == Enum.HumanoidStateType.RunningNoPhysics
                or movementState == Enum.HumanoidStateType.Landed) then
            humanoid.Jump = true
        end
        -- A genuine jump request arms one bounded horizontal boost; never triggers on its own.
        -- Preserve Y velocity so game gravity and the normal jump arc still apply.
        local now = os.clock()
        if longJumpState.character ~= getCharacter() then clearLongJump() end
        if not state.longJump or state.coinFarm then
            clearLongJump()
        elseif grounded then
            if longJumpState.active then clearLongJump() end
            if now > longJumpState.pendingUntil then longJumpState.pendingUntil = 0 end
        elseif (movementState == Enum.HumanoidStateType.Jumping
            or movementState == Enum.HumanoidStateType.Freefall) then
            if not longJumpState.active and now <= longJumpState.pendingUntil then
                longJumpState.active = true
                longJumpState.startedAt = now
                longJumpState.startPosition = root.Position
                local wish = humanoid.MoveDirection
                if wish.Magnitude < 0.05 then wish = root.CFrame.LookVector end
                wish = Vector3.new(wish.X, 0, wish.Z)
                longJumpState.direction = wish.Magnitude > 0.05 and wish.Unit or Vector3.new(0, 0, -1)
                longJumpState.pendingUntil = 0
            end
            if longJumpState.active then
                local ultra = state.ultraLongJump
                local duration = ultra and CONFIG.UltraJumpDuration or CONFIG.LongJumpDuration
                local distance = longJumpState.startPosition and (root.Position - longJumpState.startPosition).Magnitude or 0
                if now - longJumpState.startedAt <= duration
                    and (not ultra or distance < CONFIG.UltraJumpMaxDistance) then
                    local wish = humanoid.MoveDirection
                    wish = Vector3.new(wish.X, 0, wish.Z)
                    if wish.Magnitude > 0.05 then
                        local blended = longJumpState.direction:Lerp(wish.Unit, math.clamp(deltaTime * 3, 0, 0.25))
                        if blended.Magnitude > 0.05 then longJumpState.direction = blended.Unit end
                    end
                    local v = root.AssemblyLinearVelocity
                    local dir = longJumpState.direction
                    local speed = ultra and CONFIG.UltraJumpSpeed or values.longJumpSpeed
                    -- Keep the ultra boost airborne; ordinary Long Jump preserves normal gravity.
                    local vertical = ultra and math.max(v.Y, 8) or v.Y
                    root.AssemblyLinearVelocity = Vector3.new(dir.X * speed, vertical, dir.Z * speed)
                else
                    longJumpState.active = false
                end
            end
        end
        if state.strafe and not longJumpState.active and not grounded and (movementState == Enum.HumanoidStateType.Jumping
            or movementState == Enum.HumanoidStateType.Freefall) then
            root.AssemblyLinearVelocity = calculateStrafeVelocity(root.AssemblyLinearVelocity,
                humanoid.MoveDirection, values.strafeSpeed, deltaTime)
        end
    end

    if state.noclip and not (state.coinFarm and coinFarm.paused) then
        applyNoclip()
    else
        -- Restore collisions while coin farming waits between rounds.
        if next(originalCollisions) ~= nil then
            restoreNoclip()
        end
    end

    if state.lowGravity then
        Workspace.Gravity = 60
    end

    if root and humanoid and humanoid.Health > 0 and not root.Anchored and state.spin and not state.fly then
        if spinState.root ~= root then
            stopRegularSpin()
            spinState.root, spinState.velocity = root, root.AssemblyAngularVelocity
        end
        root.AssemblyAngularVelocity = Vector3.new(0, 12, 0)
    elseif spinState.root then
        stopRegularSpin()
    end

    if state.fly and not (state.coinFarm and coinFarm.paused) then
        if not flyObjects.active
            or not flyObjects.flyVelocity
            or not flyObjects.flyVelocity.Parent
            or not flyObjects.flyGyro
            or not flyObjects.flyGyro.Parent then
            startFly()
        end

        local currentHumanoid = getHumanoid()
        local currentRoot = getRoot()
        local camera = Workspace.CurrentCamera
        local flyVelocity = flyObjects.flyVelocity
        local flyGyro = flyObjects.flyGyro

        if currentHumanoid and currentHumanoid.Health > 0 and currentRoot and not currentRoot.Anchored
            and not currentHumanoid.Sit and camera and flyVelocity and flyGyro and flyObjects.active then
            currentHumanoid.PlatformStand = true
            currentHumanoid.AutoRotate = false

            local movement = Vector3.zero
            local look = camera.CFrame.LookVector
            local right = camera.CFrame.RightVector

            if windowFocused and not UIS:GetFocusedTextBox() then
                local moveDirection = currentHumanoid.MoveDirection
                local flatLook = Vector3.new(look.X, 0, look.Z)

                if flatLook.Magnitude > 0.001 then
                    flatLook = flatLook.Unit
                else
                    local flatRight = Vector3.new(right.X, 0, right.Z)
                    flatLook = flatRight.Magnitude > 0.001
                        and Vector3.new(flatRight.Unit.Z, 0, -flatRight.Unit.X) or Vector3.new(0, 0, -1)
                end
                local flatRight = Vector3.new(-flatLook.Z, 0, flatLook.X)

                if moveDirection.Magnitude > 0.001 then
                    movement += look * moveDirection:Dot(flatLook)
                    movement += right * moveDirection:Dot(flatRight)
                end
                if UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) or flyObjects.up then
                    movement += Vector3.new(0, 1, 0)
                end
                if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.Q) or flyObjects.down then
                    movement -= Vector3.new(0, 1, 0)
                end
            end

            if movement.Magnitude > 0.001 then
                movement = movement.Unit * values.flySpeed
            else
                movement = Vector3.zero
            end

            if state.coinFarm and UIRefs.coinFarmVelocity then
                movement = UIRefs.coinFarmVelocity(currentRoot)
            end
            flyVelocity.Velocity = movement

            if look.Magnitude > 0.001 then
                flyGyro.CFrame = CFrame.lookAt(currentRoot.Position, currentRoot.Position + look)
            end
        elseif flyObjects.active then
            stopFly()
        end
    elseif flyObjects.active then
        stopFly()
    end

end
