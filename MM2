local roleRefreshPending = false
addConnection(RunService.Heartbeat:Connect(function(deltaTime)
    if state.unloaded then
        return
    end

    roleTimer = roleTimer + deltaTime
    if roleTimer < 0.35 then
        return
    end
    roleTimer = 0

    if (state.roleESP or state.innocentESP or state.aimLock or flingBusy) and not roleRefreshPending then
        -- Network requests must not run inside the camera callback or overlap
        -- on every Heartbeat while a previous role request is still waiting.
        roleRefreshPending = true
        task.spawn(function()
            if not state.unloaded then
                refreshRoles()
            end
            roleRefreshPending = false
        end)
    end

end))

