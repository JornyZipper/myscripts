--// Respawn handler
local function onCharacterAdded(character)
    disconnectBucket(characterConnections)

    local humanoid = character:WaitForChild("Humanoid", 10)
    local root = character:WaitForChild("HumanoidRootPart", 10)

    if not humanoid or not root or state.unloaded then
        return
    end

    setCharacterMovement()

    if state.fly then
        startFly()
    end

    if state.noclip then
        task.wait(0.1)
        applyNoclip()
    end
end

addConnection(LocalPlayer.CharacterAdded:Connect(onCharacterAdded))
if LocalPlayer.Character then
    task.spawn(function()
        onCharacterAdded(LocalPlayer.Character)
    end)
end

--// Role refresh and ESP update
local roleTimer = 0
addConnection(RunService.Heartbeat:Connect(function(deltaTime)
    if state.unloaded then
        return
    end

    roleTimer = roleTimer + deltaTime
    if roleTimer < 0.35 then
        return
    end
    roleTimer = 0

    if state.roleESP or state.innocentESP then
        refreshRoles()
    end

    if state.esp or state.roleESP or state.innocentESP then
        updateESP()
    end
end))

