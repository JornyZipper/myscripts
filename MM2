--// Experimental remote-argument Silent Aim based on the supplied readable MM2 script.
--// Does not turn the camera, fire weapons automatically, or promise server acceptance.
local Silent = {installed = false, old = nil, error = nil, rawMeta = nil, wrapper = nil}
function Silent.target(name)
    local player = name and Players:FindFirstChild(name)
    local char = player and player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local part = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
    if player ~= LocalPlayer and hum and hum.Health > 0 and part and part:IsA("BasePart") then
        return part
    end
    return nil
end
function Silent.closest()
    local mine = LocalPlayer.Character
    local root = mine and mine:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, distance = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local part = Silent.target(player.Name)
            if part then
                local d = (part.Position - root.Position).Magnitude
                if d < distance then best, distance = part, d end
            end
        end
    end
    return best, distance
end
function Silent.redirect(object, method, args)
    if state.unloaded then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChildOfClass("Humanoid") then return end
    -- Only modify an expected Vector3 aim coordinate. Unknown remote signatures pass untouched.
    if typeof(args[2]) ~= "Vector3" then return end
    if state.silentGun and method == "InvokeServer" and object:IsA("RemoteFunction") and object.Name == "ShootGun" then
        local target = rolesAvailable and Murder ~= "" and Silent.target(Murder)
        if target then
            local velocity = target.AssemblyLinearVelocity
            args[2] = target.Position + Vector3.new(velocity.X, 0, velocity.Z) / 40
        end
    elseif state.silentKnife and method == "FireServer" and object:IsA("RemoteEvent") and object.Name == "Throw" then
        local target, distance = Silent.closest()
        if target then
            local velocity = target.AssemblyLinearVelocity
            -- Short lead rather than the source's long 0.5*distance/100 lead;
            -- projectile velocity is unverified, so this is only an experiment.
            local lead = math.clamp(distance / 180, 0.035, 0.22)
            args[2] = target.Position + Vector3.new(velocity.X, 0, velocity.Z) * lead
        end
    end
end
function Silent.install()
    if Silent.installed then return true end
    if type(getnamecallmethod) ~= "function" or type(newcclosure) ~= "function" then
        return false, "Xeno: getnamecallmethod/newcclosure unavailable"
    end
    if type(hookmetamethod) == "function" then
        local old
        local wrapper = newcclosure(function(object, ...)
            local args = {...}
            if not (type(checkcaller) == "function" and checkcaller()) then
                pcall(Silent.redirect, object, getnamecallmethod(), args)
            end
            return old(object, (table.unpack or unpack)(args))
        end)
        local ok, result = pcall(function() return hookmetamethod(game, "__namecall", wrapper) end)
        if not ok or type(result) ~= "function" then return false, "hookmetamethod failed" end
        old = result
        Silent.wrapper, Silent.old, Silent.installed = wrapper, old, true
        return true
    end
    if type(getrawmetatable) ~= "function" or type(setreadonly) ~= "function" then
        return false, "Xeno: __namecall hook API unavailable"
    end
    local ok, result = pcall(function()
        local meta = getrawmetatable(game)
        local old = meta.__namecall
        local wrapper = newcclosure(function(object, ...)
            local args = {...}
            if not (type(checkcaller) == "function" and checkcaller()) then
                pcall(Silent.redirect, object, getnamecallmethod(), args)
            end
            return old(object, (table.unpack or unpack)(args))
        end)
        setreadonly(meta, false)
        meta.__namecall = wrapper
        setreadonly(meta, true)
        Silent.rawMeta, Silent.wrapper, Silent.old = meta, wrapper, old
    end)
    if not ok then return false, "__namecall installation failed: " .. tostring(result) end
    Silent.installed = true
    return true
end
function Silent.stop()
    state.silentGun, state.silentKnife = false, false
    -- Leave hook inert. Restoring a shared metatable would risk overwriting another script's hook.
end

local function addConnection(connection, bucket)
    bucket = bucket or connections
    table.insert(bucket, connection)
    return connection
end

local function disconnectBucket(bucket)
    for i = #bucket, 1, -1 do
        local connection = bucket[i]
        if connection and connection.Disconnect then
            pcall(function()
                connection:Disconnect()
            end)
        end
        bucket[i] = nil
    end
end

