    if not UIRefs.draggingReopen or not IsMobile then
        return
    end
    if not isPointerMove(input, UIRefs.reopenDragInput) then return end

    local camera = Workspace.CurrentCamera
    if not camera then
        return
    end

    local delta = (input.Position - UIRefs.reopenDragStart) / Scale.Scale
    local viewport = camera.ViewportSize / Scale.Scale
    local halfX = UIRefs.reopen.AbsoluteSize.X * 0.5 / Scale.Scale
    local halfY = UIRefs.reopen.AbsoluteSize.Y * 0.5 / Scale.Scale

    local newX = UIRefs.reopenStartPosition.X.Offset + delta.X
    local newY = UIRefs.reopenStartPosition.Y.Offset + delta.Y
    newX = math.clamp(newX, -viewport.X * 0.5 + halfX + 6, viewport.X * 0.5 - halfX - 6)
    newY = math.clamp(newY, -viewport.Y * 0.5 + halfY + 6, viewport.Y * 0.5 - halfY - 6)

    UIRefs.reopen.Position = UDim2.new(0.5, newX, 0.5, newY)
end))

