    watermark.ping = label("PingValue", "-- ms", 12, false)

    local function widthOf(object)
        local ok, bounds = pcall(function()
            return textService:GetTextSize(object.Text, object.TextSize, object.Font, Vector2.new(10000, 100))
        end)
        return math.ceil(ok and bounds.X or #object.Text * object.TextSize * 0.72) + 3
    end
    function watermark.fit()
        if state.unloaded or not watermark.gui.Parent then return end
        local viewport = watermark.gui.AbsoluteSize
        if viewport.X <= 0 or viewport.Y <= 0 then
            local camera = Workspace.CurrentCamera
            viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
        end
        local factor = math.clamp(math.min((viewport.X - 24) / watermark.width,
            (viewport.Y - 24) / watermark.height), 0.01, 1)
        watermark.scale.Scale = factor
        local position = watermark.card.Position
        local x = position.X.Scale * viewport.X + position.X.Offset
        local y = position.Y.Scale * viewport.Y + position.Y.Offset
        watermark.card.Position = UDim2.fromOffset(
            math.clamp(x, 12, math.max(12, viewport.X - watermark.width * factor - 12)),
            math.clamp(y, 12, math.max(12, viewport.Y - watermark.height * factor - 12)))
    end
    function watermark.layout()
        local x = 53
        watermark.dividers[1].Position = UDim2.fromOffset(x, 13)
        x = 61
        watermark.brand.Size = UDim2.fromOffset(widthOf(watermark.brand), 16)
        x += math.max(widthOf(watermark.brand), 70) + 15
        local fields = {{watermark.id, watermark.name}, {watermark.fpsTitle, watermark.fps},
            {watermark.pingTitle, watermark.ping}}
        for index, pair in ipairs(fields) do
            watermark.dividers[index + 1].Position = UDim2.fromOffset(x, 13)
            x += 14
            for part, object in ipairs(pair) do
                local width = widthOf(object)
                object.Position = UDim2.fromOffset(x, 16)
                object.Size = UDim2.fromOffset(width, 20)
                x += width + (part == 1 and 12 or 14)
            end
        end
        watermark.width = x + 4
        watermark.card.Size = UDim2.fromOffset(watermark.width, watermark.height)
        watermark.fit()
    end
    function watermark.refreshPing()
        local ok, ping = pcall(function() return LocalPlayer:GetNetworkPing() end)
        local milliseconds = ok and type(ping) == "number" and ping * 1000 or nil
        watermark.ping.Text = milliseconds and milliseconds == milliseconds
            and milliseconds >= 0 and milliseconds < math.huge
            and string.format("%.0f ms", milliseconds) or "-- ms"
    end
    function watermark.setVisible(enabled)
        state.watermark = enabled
        watermark.card.Visible = enabled
        watermark.dragging, chrome.elapsed, chrome.frames = nil, 0, 0
        if enabled then watermark.fps.Text = "--"; watermark.refreshPing(); watermark.layout() end
    end
    function watermark.destroy()
        watermark.dragging = nil
        if watermark.gui then watermark.gui:Destroy() end
    end
    addConnection(watermark.gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(watermark.fit))
    addConnection(watermark.card.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 or state.unloaded then return end
        watermark.dragging, watermark.dragStart, watermark.startPosition = input, input.Position, watermark.card.Position
    end))
    addConnection(UIS.InputChanged:Connect(function(input)
        if not watermark.dragging or not isPointerMove(input, watermark.dragging) then return end
        local delta = input.Position - watermark.dragStart
        watermark.card.Position = UDim2.fromOffset(watermark.startPosition.X.Offset + delta.X,
            watermark.startPosition.Y.Offset + delta.Y)
        watermark.fit()
    end))
    addConnection(UIS.InputEnded:Connect(function(input)
        if isPointerEnd(input, watermark.dragging) then watermark.dragging = nil end
    end))
    addConnection(UIS.WindowFocusReleased:Connect(function() watermark.dragging = nil end))

    UIRefs.watermarkButton, UIRefs.setWatermarkToggle = addToggle("Watermark", 32, watermark.setVisible)
    UIRefs.watermarkButton.Parent = UIRefs.CategoryPages.utilities
    UIRefs.setWatermarkToggle(state.watermark)
    addConnection(RunService.RenderStepped:Connect(function(dt)
        if state.unloaded then return end
        if UIRefs.Main.Visible or state.watermark then
            chrome.phase = ((os.clock() - chrome.started) / 3.6) % 1
            local offset = Vector2.new(chrome.phase * 2.4 - 1.2, 0)
            for _, gradient in ipairs(chrome.gradients) do
                if gradient.Parent then gradient.Offset = offset end
            end
        end
        if not state.watermark or type(dt) ~= "number" or dt ~= dt or dt <= 0 or dt == math.huge then return end
        chrome.frames += 1
        chrome.elapsed += dt
        if chrome.elapsed >= 0.5 then
            watermark.fps.Text = tostring(math.floor(chrome.frames / chrome.elapsed + 0.5))
            chrome.frames, chrome.elapsed = 0, 0
            watermark.refreshPing()
            watermark.layout()
        end
    end))
end
