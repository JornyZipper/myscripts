            -- Never invent latency when the API is unavailable or its last result is stale.
            if not network.goodAt or at - network.goodAt > 3 then return nil end
            -- Uncertain latency shortens lead slightly instead of amplifying ping spikes.
            -- The motion model still limits errors and keeps every offset within four studs.
            local uncertainty = math.min((network.jitter or 0) * 0.5, network.rtt * 0.20)
            network.delaySeconds = math.clamp(network.rtt - uncertainty, 0, 0.35)
