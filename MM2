local function findGetPlayerData()
    local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if remote and remote:IsA("RemoteFunction") then
        return remote
    end
    return nil
end

local function refreshRoles()
    local remote = findGetPlayerData()
    if not remote then
        Status.Text = "Role ESP: GetPlayerData not found"
        return false
    end

    local success, result = pcall(function()
        return remote:InvokeServer()
    end)

    if not success or type(result) ~= "table" then
        Status.Text = "Role ESP: failed to read roles"
        return false
    end

    roles = result
    Murder = ""
    Sheriff = ""
    Hero = ""

    for playerName, data in pairs(roles) do
        if type(data) == "table" then
            if data.Role == "Murderer" then
                Murder = playerName
            elseif data.Role == "Sheriff" then
                Sheriff = playerName
            elseif data.Role == "Hero" then
                Hero = playerName
            end
        end
    end

    if LocalPlayer.Name == Murder then
        Status.Text = "Role: Murderer"
    elseif LocalPlayer.Name == Sheriff then
        Status.Text = "Role: Sheriff"
    elseif LocalPlayer.Name == Hero then
        Status.Text = "Role: Hero"
    else
        Status.Text = "Role: Innocent / unknown"
    end

    return true
end


--// X = shoot murderer with revolver (own game)
local shootMurdererBusy = false

local function findRevolver()
    local character = getCharacter()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

    local function check(container)
        if not container then
            return nil
        end

        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local name = string.lower(item.Name)
                if string.find(name, "revolver", 1, true)
                    or string.find(name, "sheriff", 1, true)
                    or string.find(name, "pistol", 1, true)
                    or name == "gun" then
                    return item
                end
            end
        end

        return nil
    end

    return check(character) or check(backpack)
end

local function shootMurderer()
    if state.unloaded or shootMurdererBusy then
        return
    end

    shootMurdererBusy = true

    local ok, err = pcall(function()
        -- Refresh role data even when ESP is disabled.
        if not refreshRoles() then
            Status.Text = "Shoot: roles unavailable"
            return
        end

        if Murder == "" then
            Status.Text = "Shoot: murderer not found"
            return
        end

        local murderer = Players:FindFirstChild(Murder)
        if not murderer or not isAliveCharacter(murderer) then
            Status.Text = "Shoot: murderer is dead/not found"
            return
        end

        local targetCharacter = murderer.Character
        local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
        local targetHead = targetCharacter and targetCharacter:FindFirstChild("Head")
        local targetPart = targetHead or targetRoot
        if not targetPart then
            Status.Text = "Shoot: no target part"
            return
        end

        local tool = findRevolver()
        if not tool then
            Status.Text = "Shoot: revolver not found"
            return
        end

        local humanoid = getHumanoid()
        if not humanoid then
            Status.Text = "Shoot: humanoid not found"
            return
        end

        local previousTool = nil
        for _, item in ipairs(humanoid.Parent:GetChildren()) do
            if item:IsA("Tool") and item ~= tool then
                previousTool = item
                break
            end
        end

        if tool.Parent ~= humanoid.Parent then
            humanoid:EquipTool(tool)
            task.wait(0.05)
        end

        local camera = Workspace.CurrentCamera
        if not camera then
            return
        end

        -- Aim the camera at the murderer for weapon implementations
        -- that calculate the shot direction from the camera.
        local oldCameraType = camera.CameraType
        local oldCameraCFrame = camera.CFrame
        camera.CameraType = Enum.CameraType.Scriptable
        camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetPart.Position)

        tool:Activate()
        task.wait(0.05)
        pcall(function()
            tool:Deactivate()
        end)

        camera.CFrame = oldCameraCFrame
        camera.CameraType = oldCameraType

        if previousTool and previousTool.Parent == humanoid.Parent then
            humanoid:EquipTool(previousTool)
        end

        Status.Text = "Shoot: fired at " .. murderer.DisplayName
    end)

    if not ok then
        Status.Text = "Shoot error: " .. tostring(err)
    end

    task.delay(0.25, function()
        shootMurdererBusy = false
    end)
end

