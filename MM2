            -- Fling/teleport physics must not become a large prediction offset.
            return horizontal.Magnitude <= 90 and horizontal or nil
        end

        function auto.sample(part, at)
            local position = part.Position
            if not Silent.isFiniteAimVector(position) then auto.reset(false); return nil end
            local reported = auto.readVelocity(part)
            local raw = part.AssemblyLinearVelocity
            local rawY = Silent.isFiniteAimVector(raw) and math.abs(raw.Y) <= 90 and raw.Y or nil
