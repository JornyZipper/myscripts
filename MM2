--// Travel locations: use verified replicated landmarks/players, never fixed map coordinates.
do
    local function normalized(name)
        return string.lower(name):gsub("[^%w]", "")
    end

    local function safeSurface(part)
        return part and part:IsA("BasePart") and part.CanCollide
            and part.Anchored and part.CFrame.UpVector.Y > 0.91
            and part.Size.X >= 5 and part.Size.Z >= 5
    end

    local function bestLandmark(container)
        -- Prefer an actual spawn, then a stable horizontal floor. Never use
        -- arbitrary decorations or roofs as travel destinations.
        local floor, area = nil, 0
        for _, part in ipairs(container:GetDescendants()) do
            if part:IsA("SpawnLocation") and safeSurface(part) then return part end
            if safeSurface(part) and part.Size.Y <= 18 then
                local footprint = part.Size.X * part.Size.Z
                if footprint > area and footprint >= 100 then
                    floor, area = part, footprint
                end
            end
        end
        return floor
    end

    local function lobbySpawn()
        for _, child in ipairs(Workspace:GetChildren()) do
            local name = normalized(child.Name)
            if (child:IsA("Model") or child:IsA("Folder")) and
                (name == "lobby" or name == "mainlobby" or name == "lobbymap") then
                local part = bestLandmark(child)
                if part then return part end
            end
        end
        for _, part in ipairs(Workspace:GetDescendants()) do
            if safeSurface(part) then
                local name = normalized(part.Name)
                if name == "lobbyspawn" or name == "lobbyspawnpoint"
                    or name == "spawnlobby" then return part end
            end
        end
        return nil
    end

    local function activeMapLandmark()
        -- Replicated map models provide a fallback when role remotes are stale.
        -- Explicit current-map names are preferred to any guessed coordinates.
        for _, child in ipairs(Workspace:GetChildren()) do
            local name = normalized(child.Name)
            if (child:IsA("Model") or child:IsA("Folder")) and
                (name == "map" or name == "currentmap" or name == "activemap"
                    or name == "roundmap" or name == "gamemap") then
                local part = bestLandmark(child)
                if part then return part end
            end
        end
        return nil
    end

    local function mapPlayer()
        -- Prefer a real participant in the active round, but never jump to our
        -- own lobby character when roles have not replicated.
        if not refreshRoles() or not rolesAvailable then return nil end
        local names = {Murder, Sheriff, Hero}
        for playerName, data in pairs(roles) do
            if type(data) == "table" and data.Role and data.Role ~= "Spectator" then
                table.insert(names, playerName)
            end
        end
        for _, name in ipairs(names) do
            if type(name) == "string" and name ~= "" and name ~= LocalPlayer.Name
                and roleAlive(name) then
                local player = Players:FindFirstChild(name)
                local char = player and player.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root and not root.Anchored then return root end
            end
        end
        return nil
    end

    local function groundedDestination(char, root, hum, landmark, isPlayer)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local exclusions = {char}
        if isPlayer then table.insert(exclusions, landmark.Parent) end
        params.FilterDescendantsInstances = exclusions
        params.IgnoreWater = true
        local samples = isPlayer and {
            Vector3.new(5, 0, 0), Vector3.new(-5, 0, 0),
            Vector3.new(0, 0, 5), Vector3.new(0, 0, -5),
        } or {Vector3.zero, Vector3.new(4, 0, 0), Vector3.new(-4, 0, 0)}
        for _, offset in ipairs(samples) do
            local proposed = landmark.Position + offset
            local ground = Workspace:Raycast(proposed + Vector3.new(0, 18, 0),
                Vector3.new(0, -65, 0), params)
            if ground and ground.Instance and ground.Instance.CanCollide and ground.Normal.Y >= 0.75 then
                if not isPlayer and ground.Instance ~= landmark
                    and not ground.Instance:IsDescendantOf(landmark.Parent) then
                    -- Do not accidentally land outside the identified map/lobby.
                    continue
                end
                local standingHeight = hum.HipHeight + root.Size.Y * 0.5 + 1.25
                return Vector3.new(proposed.X, ground.Position.Y + standingHeight, proposed.Z)
            end
        end
        -- SpawnLocations may have a transparent/no-query top face; the explicit
        -- landmark is still a reasonable fallback if it is a verified floor.
        if not isPlayer and safeSurface(landmark) then
            return landmark.Position + Vector3.new(0,
                landmark.Size.Y * 0.5 + hum.HipHeight + root.Size.Y * 0.5 + 1.25, 0)
        end
        return nil
    end

    local function travel(kind)
        if state.unloaded then return end
        if teleportBusy or flingBusy or shootMurdererBusy then
            UIRefs.Status.Text = "TP: stop Fling / finish weapon action first"
            return
        end
        local char, root, hum = getCharacter(), getRoot(), getHumanoid()
        if not char or not root or not hum or hum.Health <= 0 or root.Anchored or hum.Sit then
            UIRefs.Status.Text = "TP: living character required"
            return
        end
        teleportBusy = true
        local ok, err = pcall(function()
            local target, targetIsPlayer
            if kind == "map" then
                target = mapPlayer()
                targetIsPlayer = target ~= nil
                if not target then target = activeMapLandmark() end
            else
                target = lobbySpawn()
                targetIsPlayer = false
            end
            if not target or not target.Parent then
                UIRefs.Status.Text = kind == "map" and "TP Map: round map / player not replicated"
                    or "TP Lobby: lobby spawn not replicated"
                return
            end
            if state.unloaded or LocalPlayer.Character ~= char or hum.Health <= 0 then return end
            local destination = groundedDestination(char, root, hum, target, targetIsPlayer)
            if not destination then
                UIRefs.Status.Text = "TP " .. kind .. ": no safe landing surface"
                return
            end
            -- Stop the farm only after a valid landing point was found.
            if state.coinFarm and UIRefs.setCoinFarmToggle then UIRefs.setCoinFarmToggle(false) end
            -- Do not let an existing Fly body mover drag the character away.
            if state.fly and UIRefs.setFlyToggle then UIRefs.setFlyToggle(false) end
            clearLongJump()
            local rootToPivot = root.CFrame:ToObjectSpace(char:GetPivot())
            local desiredRoot = CFrame.new(destination) * root.CFrame.Rotation
            pauseAntiFling()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            char:PivotTo(desiredRoot * rootToPivot)
            antiFlingGuard.safePivot = char:GetPivot()
            antiFlingGuard.teleportUntil = os.clock() + CONFIG.AntiFlingTeleportGrace
            UIRefs.Status.Text = kind == "map" and (targetIsPlayer and "TP Map: landed near round player" or "TP Map: landed on active map")
                or "TP Lobby: landed at lobby"
        end)
        teleportBusy = false
        if not ok then
            UIRefs.Status.Text = "TP " .. kind .. " error: " .. tostring(err)
            warn("[ScriptMM2 TP] " .. tostring(err))
        end
    end
    -- One-shot client reposition near a selected live player. No server hitbox changes.
    UIRefs.teleportToPlayer = function(player)
        if state.unloaded then return end
        if teleportBusy or flingBusy or shootMurdererBusy then
            UIRefs.Status.Text = "TP Player: stop Fling / finish weapon action first"
            return
        end
        if not player or player == LocalPlayer or player.Parent ~= Players then
            UIRefs.Status.Text = "TP Player: player unavailable"
            return
        end
        local character, root, humanoid = getCharacter(), getRoot(), getHumanoid()
        local targetCharacter = player.Character
        local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
        local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
        if not character or not root or not humanoid or humanoid.Health <= 0 or humanoid.Sit or root.Anchored then
            UIRefs.Status.Text = "TP Player: your character is not ready"
            return
        end
        if not targetRoot or not targetRoot:IsA("BasePart") or not targetHumanoid or targetHumanoid.Health <= 0 then
            UIRefs.Status.Text = "TP Player: target is not alive / loaded"
            return
        end
        teleportBusy = true
        local ok, err = pcall(function()
            if state.coinFarm and UIRefs.setCoinFarmToggle then UIRefs.setCoinFarmToggle(false) end
            local offset = targetRoot.CFrame.RightVector * 5
            local proposed = targetRoot.Position + offset
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = {character, targetCharacter}
            params.IgnoreWater = true
            local hit = Workspace:Raycast(proposed + Vector3.new(0, 15, 0), Vector3.new(0, -55, 0), params)
            if not hit or not hit.Instance or not hit.Instance.CanCollide then
                UIRefs.Status.Text = "TP Player: safe ground not found near " .. player.Name
                return
            end
            if state.unloaded or player.Parent ~= Players or targetRoot.Parent ~= targetCharacter
                or targetHumanoid.Health <= 0 or LocalPlayer.Character ~= character or humanoid.Health <= 0 then
                UIRefs.Status.Text = "TP Player: character changed; cancelled"
                return
            end
            local destination = Vector3.new(proposed.X, hit.Position.Y + humanoid.HipHeight + root.Size.Y + 1.5, proposed.Z)
            local rootToPivot = root.CFrame:ToObjectSpace(character:GetPivot())
            pauseAntiFling()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            character:PivotTo((CFrame.new(destination) * root.CFrame.Rotation) * rootToPivot)
            UIRefs.Status.Text = "TP Player: moved near " .. player.DisplayName
        end)
        teleportBusy = false
        if not ok then
            UIRefs.Status.Text = "TP Player error: " .. tostring(err)
            warn("[ScriptMM2 TP Player] " .. tostring(err))
        end
    end
    addConnection(UIRefs.teleportMapButton.MouseButton1Click:Connect(function()
        task.spawn(travel, "map")
    end))
    addConnection(UIRefs.teleportLobbyButton.MouseButton1Click:Connect(function()
        task.spawn(travel, "lobby")
    end))
end

