local function findGetPlayerData()
    local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if remote and remote:IsA("RemoteFunction") then
        return remote
    end
    return nil
end

local roleRequestPending = false
local function clearRoles()
    roles, Murder, Sheriff, Hero = {}, "", "", ""
    rolesAvailable = false
end

local function refreshRoles()
    if state.unloaded then
        return false
    end
    if roleRequestPending then
        repeat RunService.Heartbeat:Wait() until not roleRequestPending or state.unloaded
        return not state.unloaded and rolesAvailable
    end

    local remote = findGetPlayerData()
    if not remote then
        clearRoles()
        Status.Text = "Role ESP: GetPlayerData not found"
        return false
    end

    roleRequestPending = true
    local success, result = pcall(function()
        return remote:InvokeServer()
    end)
    roleRequestPending = false

    if state.unloaded then
        return false
    end

    if not success or type(result) ~= "table" then
        clearRoles()
        Status.Text = "Role ESP: failed to read roles"
        return false
    end

    roles = result
    rolesAvailable = true
    Murder = ""
    Sheriff = ""
    Hero = ""

    for playerName, data in pairs(roles) do
        if type(data) == "table" then
            if data.Role == "Murderer" then
                Murder = playerName
            elseif data.Role == "Sheriff" then
                Sheriff = playerName
            elseif data.Role == "Hero" then
                Hero = playerName
            end
        end
    end

    if teleportBusy or flingBusy or shootMurdererBusy then return true end
    if LocalPlayer.Name == Murder then
        Status.Text = "Role: Murderer"
    elseif LocalPlayer.Name == Sheriff then
        Status.Text = "Role: Sheriff"
    elseif LocalPlayer.Name == Hero then
        Status.Text = "Role: Hero"
    else
        Status.Text = "Role: Innocent / unknown"
    end

    return true
end


--// X = shoot murderer with revolver.

findRevolver = function()
    local character = getCharacter()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

    local function check(container)
        if not container then
            return nil
        end

        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local name = string.lower(item.Name)
                if string.find(name, "revolver", 1, true)
                    or string.find(name, "sheriff", 1, true)
                    or string.find(name, "pistol", 1, true)
                    or name == "gun" then
                    return item
                end
            end
        end

        return nil
    end

    return check(character) or check(backpack)
end

local shootTrip = nil
local shootCooldownUntil = 0

finishMurdererShot = function()
    local trip = shootTrip
    if not trip or trip.finished then return end
    trip.finished = true
    if trip.activated and trip.tool then
        pcall(function() trip.tool:Deactivate() end)
    end
    if trip.cameraChanged then
        pcall(function()
            trip.camera.CFrame = trip.cameraCFrame
            trip.camera.CameraType = trip.cameraType
        end)
    end
    local previous = trip.previousTool
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if previous and previous.Parent and LocalPlayer.Character == trip.character and trip.humanoid.Health > 0
        and (previous.Parent == trip.character or previous.Parent == backpack) then
        pcall(function() trip.humanoid:EquipTool(previous) end)
    end
    shootTrip = nil
    shootMurdererBusy = false
    shootCooldownUntil = os.clock() + 0.25
end

local function shootMurderer()
    if state.unloaded or shootMurdererBusy or os.clock() < shootCooldownUntil then return end
    if teleportBusy or flingBusy then
        Status.Text = "Shoot: finish pickup / stop Fling first"
        return
    end
    local character, humanoid = getCharacter(), getHumanoid()
    if not character or not humanoid or humanoid.Health <= 0 then return end
    local trip = {character = character, humanoid = humanoid, finished = false}
    shootTrip = trip
    shootMurdererBusy = true
    local outcome = "Shoot: cancelled"
    local ok, err = pcall(function()
        if not refreshRoles() then outcome = "Shoot: roles unavailable"; return end
        if trip.finished or state.unloaded or LocalPlayer.Character ~= character or humanoid.Health <= 0 then return end
        local murderer = Murder ~= "" and Players:FindFirstChild(Murder) or nil
        if not murderer or not roleAlive(Murder) then outcome = "Shoot: no living murderer"; return end
        local targetCharacter = murderer.Character
        local targetPart = targetCharacter and (targetCharacter:FindFirstChild("Head")
            or targetCharacter:FindFirstChild("HumanoidRootPart"))
        if not targetPart then outcome = "Shoot: no target part"; return end
        local tool = findRevolver()
        if not tool then outcome = "Shoot: revolver not found"; return end
        trip.tool = tool
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") and item ~= tool then trip.previousTool = item; break end
        end
        if tool.Parent ~= character then
            humanoid:EquipTool(tool)
            task.wait(0.05)
        end
        if trip.finished or state.unloaded or LocalPlayer.Character ~= character or humanoid.Health <= 0
            or tool.Parent ~= character or Murder ~= murderer.Name or murderer.Character ~= targetCharacter
            or not targetPart.Parent or not roleAlive(Murder) then return end
        local camera = Workspace.CurrentCamera
        if not camera then outcome = "Shoot: camera unavailable"; return end
        trip.camera, trip.cameraType, trip.cameraCFrame = camera, camera.CameraType, camera.CFrame
        trip.cameraChanged = true
        camera.CameraType = Enum.CameraType.Scriptable
        camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetPart.Position)
        trip.activated = true
        tool:Activate()
        task.wait(0.05)
        if not trip.finished and not state.unloaded then outcome = "Shoot: fired at " .. murderer.DisplayName end
    end)
    if trip.finished then return end
    finishMurdererShot()
    if not state.unloaded then Status.Text = ok and outcome or ("Shoot error: " .. tostring(err)) end
end

