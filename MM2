--// Respawn handler
local function onCharacterAdded(character)
    if state.unloaded or not character or LocalPlayer.Character ~= character then return end
    if Silent.xenoInstalled then
        -- Respawning is a temporary pause, NOT a request to switch the toggle OFF.
        Silent.restoreXeno(true)
        Silent.xenoStatusKey = nil
    end
    disconnectBucket(characterConnections)
    clearLongJump()
    if UIRefs.stopBring then UIRefs.stopBring("Bring stopped: respawn") end
    finishMurdererShot()
    finishRevolverTrip()
    -- Respawn is not an explicit OFF action: suspend the route and keep the toggle ON.
    if state.coinFarm then
        -- Respawn/round transition is never permission to start flying.
        coinFarm.paused = true
        if UIRefs.armCoinFarmWaiting then UIRefs.armCoinFarmWaiting() end
    end
    flingAllActive = false
    flingAllGeneration = flingAllGeneration + 1
    if UIRefs.flingSelectButton then paintSelectedFlingAction(false) end
    stopRoleFling()
    stopRegularSpin()
    stopFly()
    pauseAntiFling()

    local humanoid = character:WaitForChild("Humanoid", 10)
    local root = character:WaitForChild("HumanoidRootPart", 10)

    if not humanoid or not root or state.unloaded or LocalPlayer.Character ~= character then
        return
    end
    -- Listen on the character itself: changing Health to zero must pause the
    -- route immediately, rather than waiting for the next coin scan.
    addConnection(humanoid.Died:Connect(function()
        if UIRefs.pauseCoinFarmOnDeath then UIRefs.pauseCoinFarmOnDeath(character) end
    end), characterConnections)
    addConnection(humanoid.HealthChanged:Connect(function(health)
        if health <= 0 and UIRefs.pauseCoinFarmOnDeath then UIRefs.pauseCoinFarmOnDeath(character) end
    end), characterConnections)
    if humanoid.Health <= 0 and UIRefs.pauseCoinFarmOnDeath then
        UIRefs.pauseCoinFarmOnDeath(character)
    end
    stopSpectateMurderer()
    setCharacterMovement()

    if state.fly and not (state.coinFarm and coinFarm.paused)
        and not teleportBusy and not flingBusy then
        startFly()
    end

    if state.noclip and not (state.coinFarm and coinFarm.paused) then
        task.wait(0.1)
        if not state.unloaded and LocalPlayer.Character == character then applyNoclip() end
    end
end

