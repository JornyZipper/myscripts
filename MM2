local function addToggle(name, order, callback)
    local button = create("TextButton", {
        Name = name,
        Size = UDim2.new(1, -4, 0, 38),
        BackgroundColor3 = Color3.fromRGB(37, 37, 43),
        BorderSizePixel = 0,
        Font = Enum.Font.GothamSemibold,
        Text = name .. "  [OFF]",
        TextColor3 = Color3.fromRGB(220, 220, 225),
        TextSize = 13,
        AutoButtonColor = false,
        LayoutOrder = order,
    }, UIRefs.Content)

    create("UICorner", {
        CornerRadius = UDim.new(0, 8),
    }, button)

    local enabled = false
    local function setEnabled(value)
        enabled = value
        button.Text = name .. (enabled and "  [ON]" or "  [OFF]")
        setButtonVisual(button, enabled)
        callback(enabled)
    end

    addConnection(button.MouseButton1Click:Connect(function()
        setEnabled(not enabled)
    end))

    return button, setEnabled
end

local function addSlider(name, minValue, maxValue, defaultValue, order, callback)
    local holder = create("Frame", {
        Name = name .. "Slider",
        Size = UDim2.new(1, -4, 0, 57),
        BackgroundColor3 = Color3.fromRGB(31, 31, 37),
        BorderSizePixel = 0,
        LayoutOrder = order,
    }, UIRefs.Content)

    create("UICorner", {
        CornerRadius = UDim.new(0, 8),
    }, holder)

    local label = create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 6),
        Size = UDim2.new(1, -80, 0, 18),
        Font = Enum.Font.GothamSemibold,
        Text = name,
        TextColor3 = Color3.fromRGB(225, 225, 230),
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, holder)

    local valueLabel = create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -65, 0, 6),
        Size = UDim2.fromOffset(55, 18),
        Font = Enum.Font.GothamBold,
        Text = tostring(defaultValue),
        TextColor3 = Color3.fromRGB(170, 240, 200),
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, holder)

    local bar = create("Frame", {
        Position = UDim2.fromOffset(10, 35),
        Size = UDim2.new(1, -20, 0, 8),
        BackgroundColor3 = Color3.fromRGB(55, 55, 62),
        BorderSizePixel = 0,
        Active = true,
    }, holder)

    create("UICorner", {
        CornerRadius = UDim.new(1, 0),
    }, bar)

    local fill = create("Frame", {
        Size = UDim2.fromScale((defaultValue - minValue) / (maxValue - minValue), 1),
        BackgroundColor3 = Color3.fromRGB(72, 170, 105),
        BorderSizePixel = 0,
    }, bar)

    create("UICorner", {
        CornerRadius = UDim.new(1, 0),
    }, fill)

    local dragInput = nil
    local function setValue(value, silent)
        value = math.clamp(math.floor(value + 0.5), minValue, maxValue)
        local alpha = (value - minValue) / (maxValue - minValue)
        fill.Size = UDim2.fromScale(alpha, 1)
        valueLabel.Text = tostring(value)
        if not silent then callback(value) end
    end

    local function valueFromX(x)
        local left = bar.AbsolutePosition.X
        local width = bar.AbsoluteSize.X
        if width <= 0 then
            return defaultValue
        end
        local alpha = math.clamp((x - left) / width, 0, 1)
        return minValue + (maxValue - minValue) * alpha
    end

    addConnection(bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragInput then return end
            dragInput = input
            setValue(valueFromX(input.Position.X))
        end
    end))

    addConnection(UIS.InputChanged:Connect(function(input)
        if isPointerMove(input, dragInput) then
            setValue(valueFromX(input.Position.X))
        end
    end))

    addConnection(UIS.InputEnded:Connect(function(input)
        if isPointerEnd(input, dragInput) then dragInput = nil end
    end))
    addConnection(UIS.WindowFocusReleased:Connect(function() dragInput = nil end))

    return holder, setValue
end

