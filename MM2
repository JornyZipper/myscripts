        if A.stopRequested then A.disposed = true end
        paint()
    end

    function A.start()
        local ok, saved = false, nil
        if type(readfile) == "function" then ok, saved = pcall(readfile, settingsPath) end
        local wanted = ok and saved == "1"
        if not ok and type(isfile) == "function" then
            local existsOK, exists = pcall(isfile, settingsPath)
            wanted = existsOK and exists == false -- first run defaults to ON
        end
