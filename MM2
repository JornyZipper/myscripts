local function setTracer(tracer, startPoint, endPoint, color, visible)
    if not tracer then
        return
    end

    tracer.Visible = visible
    if not visible then
        return
    end

    local delta = endPoint - startPoint
    local length = delta.Magnitude
    if length < 1 then
        tracer.Visible = false
        return
    end

    tracer.Position = UDim2.fromOffset((startPoint.X + endPoint.X) * 0.5, (startPoint.Y + endPoint.Y) * 0.5)
    tracer.Size = UDim2.fromOffset(math.max(1.5, math.min(3, 240 / math.max(length, 1))), length)
    tracer.Rotation = math.deg(math.atan2(delta.Y, delta.X)) + 90
    tracer.BackgroundColor3 = color
end

local clearESP

local function updateESP()
    local anyESP = state.esp or state.roleESP or state.innocentESP
    if not anyESP then
        clearESP()
        return
    end

    local camera = Workspace.CurrentCamera
    local localRoot = getRoot()
    local localRole = getLocalRole()
    local viewport = camera and camera.ViewportSize or Vector2.new(0, 0)
    local tracerStart = Vector2.new(viewport.X * 0.5, viewport.Y - 28)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local role = getRoleName(player.Name)
            local alive = roleAlive(player.Name)
            local isInnocent = role == "Innocent"
            local show = true

            if state.innocentESP and not state.esp and not state.roleESP then
                show = (localRole == "Murderer" or localRole == "Sheriff") and isInnocent and alive
            end

            local object = show and createESPForPlayer(player) or nil
            if object then
                local character = player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                local root = character and character:FindFirstChild("HumanoidRootPart")
                local targetRole = role
                local color = state.roleESP and getRoleColor(role, alive) or ESPColors.Player

                if state.innocentESP and not state.esp and not state.roleESP then
                    targetRole = "Innocent"
                    color = ESPColors.Innocent
                end

                if not alive then
                    color = ESPColors.Dead
                end

                object.highlight.FillColor = color
                object.highlight.OutlineColor = color
                object.highlight.FillTransparency = alive and 0.94 or 0.97
                object.highlight.OutlineTransparency = alive and 0.03 or 0.45

                object.cardStroke.Color = color
                object.accent.BackgroundColor3 = color
                object.nameLabel.Text = player.DisplayName ~= player.Name
                    and (player.DisplayName .. "  •  @" .. player.Name)
                    or ("@" .. player.Name)

                local roleText = targetRole
                if targetRole == "Murderer" then
                    roleText = "MURDERER"
                elseif targetRole == "Sheriff" then
                    roleText = "SHERIFF"
                elseif targetRole == "Hero" then
                    roleText = "HERO"
                elseif targetRole == "Innocent" then
                    roleText = "INNOCENT"
                elseif targetRole == "Unknown" then
                    roleText = "PLAYER"
                end

                if state.roleESP or state.innocentESP then
                    object.roleLabel.Text = roleText
                else
                    object.roleLabel.Text = "PLAYER"
                end

                object.roleLabel.TextColor3 = color

                if camera and root and localRoot then
                    local distance = (root.Position - localRoot.Position).Magnitude
                    object.distanceLabel.Text = string.format("%dm", math.floor(distance + 0.5))

                    local screenPoint, onScreen = camera:WorldToViewportPoint(root.Position + Vector3.new(0, 1.6, 0))
                    setTracer(
                        object.tracer,
                        tracerStart,
                        Vector2.new(screenPoint.X, screenPoint.Y),
                        color,
                        state.espLines and alive and onScreen and distance <= 1200
                    )
                else
                    object.distanceLabel.Text = "--"
                    object.tracer.Visible = false
                end
            else
                destroyESPForPlayer(player)
            end
        end
    end
end

clearESP = function()
    local playersToClear = {}
    for player in pairs(espObjects) do
        table.insert(playersToClear, player)
    end

    for _, player in ipairs(playersToClear) do
        destroyESPForPlayer(player)
    end

    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        if character then
            local oldHighlight = character:FindFirstChild("ModMenuESP")
            if oldHighlight then
                oldHighlight:Destroy()
            end
            local oldInfo = character:FindFirstChild("ModMenuESPInfo")
            if oldInfo then
                oldInfo:Destroy()
            end
        end
    end

    for _, child in ipairs(ESPOverlay:GetChildren()) do
        child:Destroy()
    end
end

--// Main runtime loop
addConnection(RunService.RenderStepped:Connect(function()
    if state.unloaded then
        return
    end

    local humanoid = getHumanoid()
    local root = getRoot()

    if humanoid then
        if state.speed then
            humanoid.WalkSpeed = values.walkSpeed
        end
        if state.jump then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = values.jumpPower
        end

        if state.bunnyHop and humanoid.MoveDirection.Magnitude > 0.05 then
            humanoid.Jump = true
        end
    end

    if state.noclip then
        applyNoclip()
    end

    if state.lowGravity then
        Workspace.Gravity = 60
    end

    if root and state.spin and not state.fly then
        root.AssemblyAngularVelocity = Vector3.new(0, 12, 0)
    elseif root and not state.spin and not state.fly then
        root.AssemblyAngularVelocity = Vector3.zero
    end

    if root and state.strafe and not state.fly then
        local move = humanoid and humanoid.MoveDirection or Vector3.zero
        if move.Magnitude > 0.05 then
            local velocity = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(move.X * values.walkSpeed, velocity.Y, move.Z * values.walkSpeed)
        end
    end

    if state.fly then
        if not flyObjects.active
            or not flyObjects.flyVelocity
            or not flyObjects.flyVelocity.Parent
            or not flyObjects.flyGyro
            or not flyObjects.flyGyro.Parent then
            startFly()
        end

        local currentHumanoid = getHumanoid()
        local currentRoot = getRoot()
        local camera = Workspace.CurrentCamera
        local flyVelocity = flyObjects.flyVelocity
        local flyGyro = flyObjects.flyGyro

        if currentHumanoid and currentRoot and camera and flyVelocity and flyGyro and flyObjects.active then
            currentHumanoid.PlatformStand = true
            currentHumanoid.AutoRotate = false

            local movement = Vector3.zero
            local look = camera.CFrame.LookVector
            local right = camera.CFrame.RightVector

            if IsMobile then
                local moveDirection = currentHumanoid.MoveDirection
                local flatLook = Vector3.new(look.X, 0, look.Z)
                local flatRight = Vector3.new(right.X, 0, right.Z)

                if flatLook.Magnitude > 0.001 then
                    flatLook = flatLook.Unit
                else
                    flatLook = Vector3.zero
                end

                if flatRight.Magnitude > 0.001 then
                    flatRight = flatRight.Unit
                else
                    flatRight = Vector3.zero
                end

                if moveDirection.Magnitude > 0.001 then
                    movement += flatLook * moveDirection:Dot(flatLook)
                    movement += flatRight * moveDirection:Dot(flatRight)
                end
            else
                if UIS:IsKeyDown(Enum.KeyCode.W) then
                    movement += look
                end
                if UIS:IsKeyDown(Enum.KeyCode.S) then
                    movement -= look
                end
                if UIS:IsKeyDown(Enum.KeyCode.A) then
                    movement -= right
                end
                if UIS:IsKeyDown(Enum.KeyCode.D) then
                    movement += right
                end
            end

            if UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) or flyObjects.up then
                movement += Vector3.new(0, 1, 0)
            end

            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.Q) or flyObjects.down then
                movement -= Vector3.new(0, 1, 0)
            end

            if movement.Magnitude > 0.001 then
                movement = movement.Unit * values.flySpeed
            else
                movement = Vector3.zero
            end

            flyVelocity.Velocity = movement

            if look.Magnitude > 0.001 then
                flyGyro.CFrame = CFrame.lookAt(currentRoot.Position, currentRoot.Position + look)
            end
        end
    elseif flyObjects.active then
        stopFly()
    end

end))

