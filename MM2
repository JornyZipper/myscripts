--// SkidFling motion/impulses as used by YARHM 1.20 (Joystickplays).
--// Reference: https://github.com/Joystickplays/psychic-octo-invention/blob/main/source/yarhm/1.20/yarhm.lua
--// Independently integrated with this menu's cancellation and character cleanup.
--// All velocity writes and movers belong to OUR character.
stopRoleFling = function(_releaseBurst)
    local trip = flingTrip
    if not trip or trip.finished then return false end
    trip.finished = true
    if trip.stepConnection then
        trip.stepConnection:Disconnect()
        trip.stepConnection = nil
    end
    if trip.velocityController then
        pcall(function() trip.velocityController:Destroy() end)
        trip.velocityController = nil
    end
    local returned, returnError = false, nil
    if trip.active then
        for part, saved in pairs(trip.collisions) do
            if part.Parent then
                pcall(function() part.CanCollide = saved end)
                if originalCollisions[part] ~= nil then originalCollisions[part] = saved end
            end
        end
        local function clearVelocity()
            for _, part in ipairs(trip.character:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function()
                        part.AssemblyLinearVelocity = Vector3.zero
                        part.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
            end
        end
        clearVelocity()
        if LocalPlayer.Character == trip.character and trip.character.Parent
            and trip.root.Parent and trip.humanoid.Health > 0 then
            returned, returnError = pcall(function()
                trip.character:PivotTo(trip.returnPivot)
            end)
            clearVelocity()
        end
        -- Restore state even if returning failed or a different character spawned.
        if trip.humanoid.Parent then
            pcall(function()
                local resumeFly = LocalPlayer.Character == trip.character and state.fly
                if resumeFly then
                    trip.humanoid.PlatformStand = true
                    trip.humanoid.AutoRotate = false
                else
                    trip.humanoid.PlatformStand = trip.platformStand
                    trip.humanoid.AutoRotate = trip.autoRotate
                end
                trip.humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, trip.seatedEnabled)
                if trip.humanoid.Health > 0 and not trip.humanoid.PlatformStand then
                    trip.humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end)
        end
        if trip.flyVelocity and trip.flyVelocity.Parent and trip.flyMaxForce then
            pcall(function() trip.flyVelocity.MaxForce = trip.flyMaxForce end)
        end
        if trip.flyGyro and trip.flyGyro.Parent and trip.flyMaxTorque then
            pcall(function() trip.flyGyro.MaxTorque = trip.flyMaxTorque end)
        end
    end
    if trip.voidProtectionSet then
        pcall(function()
            local height = Workspace.FallenPartsDestroyHeight
            -- Leave a later change by the game/another script in place.
            if height ~= height then Workspace.FallenPartsDestroyHeight = trip.destroyHeight end
        end)
    end
    if trip.camera then
        pcall(function()
            if trip.camera.CameraSubject == trip.cameraTarget then
                local subject = trip.cameraSubject
                if subject == trip.humanoid and LocalPlayer.Character ~= trip.character then
                    subject = getHumanoid()
                end
                trip.camera.CameraSubject = subject
            end
        end)
    end
    if pauseAntiFling then pauseAntiFling() end
    flingTrip = nil
    flingBusy = false
    if state.noclip then applyNoclip() else restoreNoclip() end
    if not state.unloaded then
        UIRefs.flingMurdererButton.Text = "YARHM Fling Murderer"
        UIRefs.flingSheriffButton.Text = "YARHM Fling Sheriff"
        setButtonVisual(UIRefs.flingMurdererButton, false)
        setButtonVisual(UIRefs.flingSheriffButton, false)
    end
    return returned, returnError
end

local function flingRole(roleName, chosenPlayer, selectedGeneration)
    if state.unloaded then return end
    if flingAllActive and roleName ~= "Player" then
        UIRefs.Status.Text = "Fling: stop selected fling first"
        return
    end
    local isPlayer = roleName == "Player"
    local isMurderer = roleName == "Murderer"
    if isPlayer and (not flingAllActive or selectedGeneration ~= flingAllGeneration) then return end
    if flingBusy then
        if flingTrip and flingTrip.roleName == roleName then
            local returned, err = stopRoleFling(false)
            UIRefs.Status.Text = err and ("Fling return error: " .. tostring(err))
                or (returned and "Fling stopped • returned" or "Fling stopped")
        else
            UIRefs.Status.Text = "Fling: finish current fling first"
        end
        return
    end
    if teleportBusy or shootMurdererBusy then
        UIRefs.Status.Text = "Fling: finish teleport / weapon action first"
        return
    end
    if state.bringActive and UIRefs.stopBring then UIRefs.stopBring() end
    if state.coinFarm and UIRefs.setCoinFarmToggle then UIRefs.setCoinFarmToggle(false) end
    if pauseAntiFling then pauseAntiFling() end
    local character, root, humanoid = getCharacter(), getRoot(), getHumanoid()
    if not character or not root or not humanoid or humanoid.Health <= 0
        or root.Anchored or humanoid.Sit then
        UIRefs.Status.Text = "Fling: character not ready / leave the seat first"
        return
    end
    stopRegularSpin() -- Fling must snapshot the user's original AutoRotate
    local trip = {
        character=character, root=root, humanoid=humanoid,
        returnPivot=character:GetPivot(), roleName=roleName,
        collisions={}, active=false, finished=false,
    }
    flingTrip, flingBusy = trip, true
    if not isPlayer then
        local button = isMurderer and UIRefs.flingMurdererButton or UIRefs.flingSheriffButton
        button.Text = "Stop " .. roleName .. " Fling [ON]"
        setButtonVisual(button, true)
    end
    local function cancelled()
        return trip.finished or flingTrip ~= trip or state.unloaded
            or LocalPlayer.Character ~= character
            or (isPlayer and (not flingAllActive or selectedGeneration ~= flingAllGeneration))
    end
    local function targetMatches(player)
        if not player or player == LocalPlayer or player.Parent ~= Players then return false end
        if isPlayer then return player == chosenPlayer end
        return (isMurderer and Murder or Sheriff) == player.Name
    end
    local outcome = "Fling: attempt ended; server result unverified"
    local ok, err = pcall(function()
        local target
        local roleDeadline = os.clock() + CONFIG.FlingRoleWait
        repeat
            if cancelled() then return end
            if not isPlayer then refreshRoles() end
            -- Role lookup can yield. A cancelled worker must not acquire physics again.
            if cancelled() then return end
            local name = isPlayer and (chosenPlayer and chosenPlayer.Name or "")
                or (isMurderer and Murder or Sheriff)
            target = isPlayer and chosenPlayer or (name ~= "" and Players:FindFirstChild(name) or nil)
            if targetMatches(target) and roleAlive(target.Name) then break end
            UIRefs.Status.Text = "Fling: waiting for living " .. roleName
            task.wait(0.2)
        until os.clock() >= roleDeadline
        if cancelled() then return end
        if not targetMatches(target) or not roleAlive(target.Name) then
            outcome = "Fling: living target unavailable"
            return
        end
        local targetCharacter, targetRoot, targetHumanoid, contactPart
        local readyDeadline = os.clock() + CONFIG.FlingTargetWait
        repeat
            if cancelled() then return end
            if not targetMatches(target) then
                outcome = "Fling: target changed"
                return
            end
            targetCharacter = target.Character
            targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
            targetRoot = targetHumanoid and targetHumanoid.RootPart
                or (targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart"))
            local head = targetCharacter and targetCharacter:FindFirstChild("Head")
            local accessory = targetCharacter and targetCharacter:FindFirstChildOfClass("Accessory")
            local handle = accessory and accessory:FindFirstChild("Handle")
            contactPart = targetRoot or head or handle
            if targetRoot and head and (targetRoot.Position - head.Position).Magnitude > 5 then
                contactPart = head
            end
            if contactPart and contactPart:IsA("BasePart") and targetHumanoid
                and targetHumanoid.Health > 0 and not contactPart.Anchored then break end
            RunService.Heartbeat:Wait()
        until os.clock() >= readyDeadline
        if cancelled() then return end
        if not contactPart or not contactPart:IsA("BasePart") or not targetHumanoid
            or targetHumanoid.Health <= 0 or contactPart.Anchored
            or (targetRoot and targetRoot.Anchored) then
            outcome = "Fling: target root unavailable / anchored"
            return
        end
        if targetHumanoid.Sit then
            outcome = "Fling: target is seated"
            return
        end
        if not root.Parent or root.Anchored or humanoid.Health <= 0 or humanoid.Sit then return end
        local motionPart = targetRoot or contactPart
        trip.targetCharacter, trip.targetRoot = targetCharacter, motionPart
        trip.initialHealth = humanoid.Health
        trip.platformStand, trip.autoRotate = humanoid.PlatformStand, humanoid.AutoRotate
        trip.seatedEnabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.Seated)
        trip.flyVelocity, trip.flyGyro = flyObjects.flyVelocity, flyObjects.flyGyro
        trip.active = true
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                local saved = originalCollisions[part]
                if saved == nil then saved = part.CanCollide end
                trip.collisions[part] = saved
                -- Temporarily recover normal body contact when NoClip is enabled.
                part.CanCollide = saved
            end
        end
        local physicsService = game:GetService("PhysicsService")
        local canContact = false
        for _, part in ipairs(targetCharacter:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                for ownPart, collidable in pairs(trip.collisions) do
                    if collidable and ownPart.Parent then
                        local groupOK, collide = pcall(function()
                            return physicsService:CollisionGroupsAreCollidable(ownPart.CollisionGroup, part.CollisionGroup)
                        end)
                        if not groupOK or collide then canContact = true; break end
                    end
                end
                if canContact then break end
            end
        end
        if not canContact then
            outcome = "Fling unavailable: target avatar / game collision groups block contact"
            return
        end
        if trip.flyVelocity and trip.flyVelocity.Parent then
            trip.flyMaxForce = trip.flyVelocity.MaxForce
            trip.flyVelocity.MaxForce = Vector3.zero
            trip.flyVelocity.Velocity = Vector3.zero
        end
        if trip.flyGyro and trip.flyGyro.Parent then
            trip.flyMaxTorque = trip.flyGyro.MaxTorque
            trip.flyGyro.MaxTorque = Vector3.zero
        end
        -- YARHM runs the normal humanoid; Fly's PlatformStand must not persist.
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        if trip.platformStand then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        trip.destroyHeight = Workspace.FallenPartsDestroyHeight
        trip.voidProtectionSet = pcall(function()
            -- YARHM temporarily disables local fallen-part deletion during the impulse.
            Workspace.FallenPartsDestroyHeight = 0 / 0
        end)
        trip.camera = Workspace.CurrentCamera
        if trip.camera then
            trip.cameraSubject = trip.camera.CameraSubject
            trip.cameraTarget = targetCharacter:FindFirstChild("Head") or contactPart
            trip.camera.CameraSubject = trip.cameraTarget
        end
        trip.velocityController = Instance.new("BodyVelocity")
        trip.velocityController.Name = "ScriptMM2YARHMFlingVelocity"
        trip.velocityController.Velocity = Vector3.new(CONFIG.FlingBodySpeed, CONFIG.FlingBodySpeed, CONFIG.FlingBodySpeed)
        trip.velocityController.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        trip.velocityController.Parent = root

        local rootToPivot = root.CFrame:ToObjectSpace(character:GetPivot())
        local started = os.clock()
        local initialTargetPosition = motionPart.Position
        local contactSteps, maxTargetDisplacement, maxTargetSpeed = 0, 0, 0
        local phase, angle, slowMode = 0, 0, nil
        local lastStatusAt = -math.huge
        local function shouldStop()
            if cancelled() then return true end
            if not root.Parent or humanoid.Health <= 0 then
                outcome = "Fling: character changed/dead"; return true
            end
            if root.Anchored or humanoid.Health < trip.initialHealth then
                outcome = "Fling stopped: own character needs recovery"; return true
            end
            if not targetMatches(target) or target.Character ~= targetCharacter
                or not contactPart:IsDescendantOf(targetCharacter) or not motionPart.Parent
                or targetHumanoid.Health <= 0 or not roleAlive(target.Name) then
                outcome = "Fling: target left / died / role changed"; return true
            end
            if contactPart.Anchored or motionPart.Anchored or targetHumanoid.Sit then
                outcome = "Fling: target became anchored / seated"; return true
            end
            maxTargetDisplacement = math.max(maxTargetDisplacement,
                (motionPart.Position - initialTargetPosition).Magnitude)
            maxTargetSpeed = math.max(maxTargetSpeed, motionPart.AssemblyLinearVelocity.Magnitude,
                contactPart.AssemblyLinearVelocity.Magnitude)
            if maxTargetSpeed > CONFIG.FlingLaunchedSpeed then
                outcome = "Fling: target accelerated (observed locally)"; return true
            end
            if motionPart.Position.Y <= trip.destroyHeight + 40 then
                outcome = "Fling: target reached the void (observed locally)"; return true
            end
            -- 0 keeps the user's manual duration: stop with the same button.
            if CONFIG.FlingAttemptDuration > 0
                and os.clock() - started >= CONFIG.FlingAttemptDuration then return true end
            return false
        end
        local function showMotion()
            if cancelled() or os.clock() - lastStatusAt < CONFIG.FlingStatusInterval then return end
            lastStatusAt = os.clock()
            local displacement = (motionPart.Position - initialTargetPosition).Magnitude
            local targetSpeed = motionPart.AssemblyLinearVelocity.Magnitude
            local ownSpeed = root.AssemblyLinearVelocity.Magnitude
            local ownSpin = root.AssemblyAngularVelocity.Magnitude
            trip.metrics = {steps=contactSteps, targetShift=displacement, targetSpeed=targetSpeed,
                ownSpeed=ownSpeed, ownSpin=ownSpin}
            UIRefs.Status.Text = string.format("Fling: %d steps • shift %.1f • target %.0f/s",
                contactSteps, displacement, targetSpeed)
            if isPlayer and UIRefs.flingSelectStatus then
                local motion = (displacement > 0.5 or targetSpeed > 1)
                    and "Target motion observed" or "No target motion observed"
                UIRefs.flingSelectStatus.Text = string.format("Steps: %d • shift: %.1f • target: %.0f/s\n%s • own: %.1e/s • spin: %.1e",
                    contactSteps, displacement, targetSpeed, motion, ownSpeed, ownSpin)
            end
        end
        UIRefs.Status.Text = "Fling: " .. target.DisplayName .. " • YARHM SkidFling"
        -- Use YARHM's yielding worker. Each pose survives a simulation step;
        -- stopping/respawning invalidates this worker before it writes again.
        while not shouldStop() do
                local speed = contactPart.AssemblyLinearVelocity.Magnitude
                if phase == 0 or phase >= (slowMode and 6 or 10) then
                    slowMode = speed < CONFIG.FlingSlowTargetSpeed
                    phase = 1
                    if slowMode then angle = (angle + 100) % 360 end
                else phase += 1 end
                local offset, lead, rotation = Vector3.zero, Vector3.zero, 0
                if slowMode then
                    rotation = angle
                    if phase == 3 then offset = Vector3.new(2.25, 1.5, -2.25)
                    elseif phase == 4 then offset = Vector3.new(-2.25, -1.5, 2.25)
                    else offset = Vector3.new(0, phase % 2 == 1 and 1.5 or -1.5, 0) end
                    lead = targetHumanoid.MoveDirection * (phase <= 4 and speed / 1.25 or 1)
                else
                    local walkSpeed = targetHumanoid.WalkSpeed
                    local travel = motionPart.AssemblyLinearVelocity.Magnitude / 1.25
                    if phase <= 3 then
                        offset = Vector3.new(0, phase == 2 and -1.5 or 1.5,
                            phase == 2 and -walkSpeed or walkSpeed)
                    elseif phase <= 6 then
                        offset = Vector3.new(0, phase == 5 and -1.5 or 1.5,
                            phase == 5 and -travel or travel)
                    else offset = Vector3.new(0, -1.5, 0) end
                    rotation = (phase == 1 or phase == 3 or phase == 4 or phase == 6 or phase == 7)
                        and 90 or (phase == 9 and -90 or 0)
                end
                local destination = CFrame.new(contactPart.Position + offset + lead)
                    * CFrame.Angles(math.rad(rotation), 0, 0)
                if character.PrimaryPart == root then
                    root.CFrame = destination
                    character:SetPrimaryPartCFrame(destination)
                else character:PivotTo(destination * rootToPivot) end
                local linearVelocity = Vector3.new(CONFIG.FlingLinearSpeed,
                    CONFIG.FlingLinearSpeed * CONFIG.FlingLiftMultiplier, CONFIG.FlingLinearSpeed)
                local angularVelocity = Vector3.new(CONFIG.FlingSpinSpeed, CONFIG.FlingSpinSpeed, CONFIG.FlingSpinSpeed)
                local legacyOK = pcall(function()
                    root.Velocity = linearVelocity
                    root.RotVelocity = angularVelocity
                end)
                if not legacyOK then
                    root.AssemblyLinearVelocity = linearVelocity
                    root.AssemblyAngularVelocity = angularVelocity
                end
                contactSteps += 1
                task.wait()
                showMotion()
        end
        if outcome == "Fling: attempt ended; server result unverified" then
            outcome = string.format("Fling: %d steps • target shift %.1f studs, peak %.0f studs/s (observed locally)",
                contactSteps, maxTargetDisplacement, maxTargetSpeed)
        end
    end)
    if trip.finished then return end
    local returned, returnErr = stopRoleFling(false)
    if state.unloaded then return end
    if not ok then
        UIRefs.Status.Text = "Fling error: " .. tostring(err)
    elseif returnErr then
        UIRefs.Status.Text = "Fling return error: " .. tostring(returnErr)
    elseif trip.active and not returned then
        UIRefs.Status.Text = "Fling cancelled: character changed/dead"
    else
        UIRefs.Status.Text = outcome
    end
end

