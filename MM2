--// Read-only hit-position diagnostic. Uses replicated actual character roots.
--// Never invokes remotes or applies damage.
do
    local diag = {elapsed = 0}
    local function updateHitDiagnostic()
        if not state.hitRegistrationDiagnostic or state.unloaded then return end
        local ownChar = LocalPlayer.Character
        local ownRoot = ownChar and ownChar:FindFirstChild("HumanoidRootPart")
        local ownHum = ownChar and ownChar:FindFirstChildOfClass("Humanoid")
        if not ownRoot or not ownHum or ownHum.Health <= 0 then
            UIRefs.hitDiagStatus.Text = "Waiting for your living character..."
            return
        end
        local results = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    local delta = root.Position - ownRoot.Position
                    local dist = delta.Magnitude
                    local params = RaycastParams.new()
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    params.FilterDescendantsInstances = {ownChar}
                    params.IgnoreWater = true
                    local hit = dist > 0.01 and Workspace:Raycast(ownRoot.Position, delta, params) or nil
                    local sight = (not hit or hit.Instance:IsDescendantOf(char)) and "CLEAR" or "BLOCKED"
                    table.insert(results, {name = player.DisplayName, user = player.Name, dist = dist,
                        height = math.abs(delta.Y), sight = sight})
                end
            end
        end
        table.sort(results, function(a, b)
            if a.dist == b.dist then return a.user < b.user end
            return a.dist < b.dist
        end)
        local lines = {"CLIENT OBSERVATION (not server hit confirmation)",
            "Real replicated roots, not preview hitboxes:"}
        for i = 1, math.min(6, #results) do
            local entry = results[i]
            local shortName = string.sub(entry.name, 1, 13)
            table.insert(lines, string.format("%s (@%s): %.1f studs | height %.1f | LOS %s",
                shortName, string.sub(entry.user, 1, 12), entry.dist, entry.height, entry.sight))
        end
        if #results == 0 then table.insert(lines, "No living player roots currently replicated.") end
        table.insert(lines, "Server registration / damage: UNKNOWN (not observed)")
        UIRefs.hitDiagStatus.Text = table.concat(lines, "\n")
    end

    UIRefs.hitDiagButton, UIRefs.setHitDiagToggle = addToggle(
        "Hit Position Diagnostic (READ ONLY)", 16.975, function(enabled)
            state.hitRegistrationDiagnostic = enabled
            diag.elapsed = 0
            if enabled then updateHitDiagnostic() else
                UIRefs.hitDiagStatus.Text = "OFF: no tracking or hit requests."
            end
        end
    )
    UIRefs.hitDiagStatus = create("TextLabel", {
        Name = "HitPositionDiagnostic", Size = UDim2.new(1, -4, 0, 170),
        BackgroundTransparency = 1, Font = Enum.Font.Code,
        Text = "OFF: observes replicated player positions only; no server hit confirmation.",
        TextColor3 = Color3.fromRGB(185, 205, 220), TextSize = 10,
        TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        LayoutOrder = 16.976,
    }, UIRefs.Content)
    addConnection(RunService.Heartbeat:Connect(function(dt)
        if not state.hitRegistrationDiagnostic or state.unloaded then return end
        diag.elapsed += dt
        if diag.elapsed < 0.25 then return end
        diag.elapsed = 0
        updateHitDiagnostic()
    end))
end

