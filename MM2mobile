--// AimLock tracks only the living murderer from the shared role data.
local function getMurdererAimPart()
    if not rolesAvailable or Murder == "" or Murder == LocalPlayer.Name then
        return nil
    end

    local murderer = Players:FindFirstChild(Murder)
    if not murderer or not roleAlive(Murder) then
        return nil
    end

    local character = murderer.Character
    -- Body-only target: R15 UpperTorso, R6 Torso, then central body fallback.
    for _, name in ipairs({"UpperTorso", "Torso", "HumanoidRootPart", "LowerTorso"}) do
        local part = character and character:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            return part
        end
    end
    return nil
end

--// Smooth sampled target motion rather than extrapolating a single replicated velocity.
--// This changes local camera direction only; it cannot guarantee a server hit.
local aimMotion = {part = nil, position = nil, sampleAt = 0, filtered = nil}
updateAimLock = function()
    if state.unloaded or state.spectateMurderer or flingBusy or not state.aimLock or UIS:GetFocusedTextBox() then
        aimMotion.part = nil
        return
    end

    local humanoid = getHumanoid()
    local camera = Workspace.CurrentCamera
    if not humanoid or humanoid.Health <= 0 or not camera then return end
    if camera.CameraType == Enum.CameraType.Scriptable then return end

    local targetPart = getMurdererAimPart()
    if not targetPart then
        aimMotion.part = nil
        return
    end

    local cameraPosition = camera.CFrame.Position
    local targetPosition = targetPart.Position
    local targetChar = targetPart.Parent
    local root = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    local targetHumanoid = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
    local motionPart = (root and root:IsA("BasePart")) and root or targetPart
    local observedPosition = motionPart.Position
    local reportedVelocity = motionPart.AssemblyLinearVelocity
    local now = os.clock()
    local velocity = reportedVelocity

    -- A respawn, target swap or long frame pause invalidates old samples.
    local sampleDt = now - aimMotion.sampleAt
    if aimMotion.part ~= motionPart or not aimMotion.position or sampleDt > 0.35 or sampleDt < 0 then
        aimMotion.part = motionPart
        aimMotion.filtered = reportedVelocity
        aimMotion.position = observedPosition
        aimMotion.sampleAt = now
    elseif sampleDt >= 0.025 then
        local displacement = observedPosition - aimMotion.position
        local sampledVelocity = displacement / sampleDt
        -- Reject teleport/fling deltas; replicated positions can arrive in bursts.
        if sampledVelocity.Magnitude <= 75 and displacement.Magnitude >= 0.035 then
            -- Follow genuine reversals quickly to reduce overshooting strafing targets.
            local reversal = aimMotion.filtered and aimMotion.filtered:Dot(sampledVelocity) < -25
            local blend = reversal and 0.80 or 0.42
            local mixed = reportedVelocity:Lerp(sampledVelocity, 0.52)
            aimMotion.filtered = (aimMotion.filtered or mixed):Lerp(mixed, blend)
        else
            aimMotion.filtered = (aimMotion.filtered or reportedVelocity):Lerp(reportedVelocity, 0.30)
        end
    end
    if sampleDt >= 0.025 or aimMotion.position == nil or aimMotion.part ~= motionPart then
        aimMotion.position = observedPosition
        aimMotion.sampleAt = now
    end
    velocity = aimMotion.filtered or reportedVelocity

    local distance = (targetPosition - cameraPosition).Magnitude
    if values.aimLeadMs > 0 then
        local horizontal = Vector3.new(velocity.X, 0, velocity.Z)
        if horizontal.Magnitude > 1 then
            local t = math.clamp(values.aimLeadMs / 1000 + distance / 750, 0, 0.32)
            local offset = horizontal * t
            targetPosition = targetPosition + (offset.Magnitude > 7 and offset.Unit * 7 or offset)
        end
    end

    -- Short ballistic extrapolation for ascending, falling and apex frames.
    -- FloorMaterial alone is not reliable on a replicated remote character.
    if values.jumpLeadMs > 0 and targetHumanoid and targetHumanoid.Health > 0 then
        local ySpeed = math.clamp(velocity.Y, -75, 75)
        local airborne = targetHumanoid.FloorMaterial == Enum.Material.Air or math.abs(ySpeed) > 4
        if airborne then
            local t = math.clamp(values.jumpLeadMs / 1000 + distance / 1500, 0, 0.22)
            local yOffset = ySpeed * t - 0.5 * Workspace.Gravity * t * t
            targetPosition = targetPosition + Vector3.new(0, math.clamp(yOffset, -4.5, 5), 0)
        end
    end
    if (targetPosition - cameraPosition).Magnitude > 0.001 then
        camera.CFrame = CFrame.lookAt(cameraPosition, targetPosition)
    end
end

