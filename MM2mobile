        end
        attackBusy = true
        attackCooldownUntil = os.clock() + 0.35
        local ok, err = pcall(function()
            if not refreshRoles() then status("Attack: roles unavailable") return end
            if not roleAlive(target.Name) then status("Attack: selected player is unavailable/dead") return end
            local myRole = getRoleName(LocalPlayer.Name)
            if myRole == "Sheriff" or myRole == "Hero" then
                if target.Name ~= Murder then
                    status("Attack: revolver may only target the current Murderer") return
                end
                status("Attack: attempting regular revolver shot at " .. target.DisplayName)
                shootMurderer()
                return
            end
            if myRole ~= "Murderer" then
                status("Attack: you need a knife (Murderer) or revolver (Sheriff/Hero)") return
            end
            local char, hum, root = getCharacter(), getHumanoid(), getRoot()
            local targetChar = target.Character
            local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
            if not char or not hum or hum.Health <= 0 or not root or not targetRoot then
                status("Attack: character/target part unavailable") return
            end
            -- Only attempt when positions are nearby in the replicated view; this is not server validation.
            local distance = (root.Position - targetRoot.Position).Magnitude
            if distance > 7 then
                status(string.format("Attack: %.1f studs away; move within 7 studs", distance)) return
            end
            local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
            local knife
            for _, holder in ipairs({char, backpack}) do
                if holder then
                    for _, item in ipairs(holder:GetChildren()) do
                        if item:IsA("Tool") and item.Name:lower():find("knife", 1, true) then
                            knife = item break
                        end
                    end
                end
                if knife then break end
            end
            if not knife then status("Attack: knife not found") return end
            if knife.Parent ~= char then
                hum:EquipTool(knife)
                task.wait(0.05)
            end
            if state.unloaded or LocalPlayer.Character ~= char or hum.Health <= 0
                or target.Character ~= targetChar or not roleAlive(target.Name) or knife.Parent ~= char then
                status("Attack: cancelled (weapon/target changed)") return
            end
            knife:Activate()
            status("Attack attempt: " .. target.DisplayName .. " • server damage unverified")
            task.delay(0.1, function() pcall(function() knife:Deactivate() end) end)
        end)
        attackBusy = false
        if not ok then status("Attack error: " .. tostring(err)) end
    end
    addConnection(UIRefs.attackButton.MouseButton1Click:Connect(function()
        task.spawn(UIRefs.attackSelected)
    end))
