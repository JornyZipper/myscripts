--// Infer the active map from nearby anchored, collidable geometry. Characters,
--// loose items, oversized backgrounds, and the whole Workspace are excluded.
local function getFlingMapBounds(position)
    local candidates, nearbyParts, characters = {}, {}, {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then characters[player.Character] = true end
    end

    local function isGeometry(part)
        return part:IsA("BasePart") and part.Anchored and part.CanCollide
            and math.max(part.Size.X, part.Size.Y, part.Size.Z) <= CONFIG.FlingMapMaxSpan
            and not isInCharacter(part, characters)
    end
    for _, part in ipairs(Workspace:GetDescendants()) do
        if isGeometry(part) and (part.Position - position).Magnitude
            <= CONFIG.FlingMapSearchRadius + part.Size.Magnitude * 0.5 then
            table.insert(nearbyParts, part)
            local ancestor = part.Parent
            while ancestor and ancestor ~= Workspace do
                if ancestor:IsA("Model") or ancestor:IsA("Folder") then
                    candidates[ancestor] = (candidates[ancestor] or 0) + 1
                end
                ancestor = ancestor.Parent
            end
        end
    end

    local function measure(parts, skipPositionCheck)
        local low, high, count = nil, nil, 0
        for _, part in ipairs(parts) do
            if isGeometry(part) then
                local half = part.Size * 0.5
                local right, up, look = part.CFrame.RightVector, part.CFrame.UpVector, part.CFrame.LookVector
                local extent = Vector3.new(
                    math.abs(right.X) * half.X + math.abs(up.X) * half.Y + math.abs(look.X) * half.Z,
                    math.abs(right.Y) * half.X + math.abs(up.Y) * half.Y + math.abs(look.Y) * half.Z,
                    math.abs(right.Z) * half.X + math.abs(up.Z) * half.Y + math.abs(look.Z) * half.Z
                )
                local a, b = part.Position - extent, part.Position + extent
                low = low and Vector3.new(math.min(low.X, a.X), math.min(low.Y, a.Y), math.min(low.Z, a.Z)) or a
                high = high and Vector3.new(math.max(high.X, b.X), math.max(high.Y, b.Y), math.max(high.Z, b.Z)) or b
                count = count + 1
            end
        end
        if not low then return nil end
        local size = high - low
        if size.X < 8 or size.Z < 8 or size.X + size.Z < 60
            or math.max(size.X, size.Z) > CONFIG.FlingMapMaxSpan or size.Y > 1024 then
            return nil
        end
        if not skipPositionCheck and (position.X < low.X - 32 or position.X > high.X + 32
            or position.Z < low.Z - 32 or position.Z > high.Z + 32
            or position.Y < low.Y - 32 or position.Y > high.Y + 32) then
            return nil
        end
        return {low = low, high = high, count = count}
    end

    local ranked = {}
    local names = {map = true, currentmap = true, activemap = true, normal = true, roundmap = true}
    for container, hits in pairs(candidates) do
        local name = string.lower(container.Name):gsub("[^%w]", "")
        table.insert(ranked, {
            container = container,
            score = hits + (names[name] and 500 or 0) + (container:IsA("Model") and 10 or 0),
        })
    end
    table.sort(ranked, function(a, b) return a.score > b.score end)
    for index = 1, math.min(8, #ranked) do
        local candidate = ranked[index]
        local bounds = measure(candidate.container:GetDescendants())
        if bounds then
            bounds.name = candidate.container.Name
            bounds.estimated = Workspace.StreamingEnabled == true
            if bounds.estimated then
                bounds.refresh = function()
                    if not candidate.container.Parent then return end
                    local updated = measure(candidate.container:GetDescendants(), true)
                    if updated then
                        -- New streamed sections can expand the bounds, but
                        -- unloading old sections must never shrink them.
                        bounds.low = Vector3.new(math.min(bounds.low.X, updated.low.X),
                            math.min(bounds.low.Y, updated.low.Y), math.min(bounds.low.Z, updated.low.Z))
                        bounds.high = Vector3.new(math.max(bounds.high.X, updated.high.X),
                            math.max(bounds.high.Y, updated.high.Y), math.max(bounds.high.Z, updated.high.Z))
                    end
                end
            end
            return bounds
        end
    end
    local fallback = measure(nearbyParts)
    if fallback then
        fallback.name = "nearby map geometry"
        fallback.estimated = true
    end
    return fallback
end

local function getFlingExitDirection(bounds, position)
    local exits = {
        {distance = math.abs(position.X - bounds.low.X), direction = Vector3.new(-1, 0, 0)},
        {distance = math.abs(bounds.high.X - position.X), direction = Vector3.new(1, 0, 0)},
        {distance = math.abs(position.Z - bounds.low.Z), direction = Vector3.new(0, 0, -1)},
        {distance = math.abs(bounds.high.Z - position.Z), direction = Vector3.new(0, 0, 1)},
    }
    table.sort(exits, function(a, b) return a.distance < b.distance end)
    return exits[1].direction
end

local function isOutsideFlingMap(bounds, position)
    local margin = CONFIG.FlingExitMargin
    -- Height and speed alone do not mean the murderer left the map.
    return position.X < bounds.low.X - margin or position.X > bounds.high.X + margin
        or position.Z < bounds.low.Z - margin or position.Z > bounds.high.Z + margin
end

--// Role-based Inside Fling: local spin at target center until user release.
--// Only the server can decide whether another player is displaced.
stopRoleFling = function(releaseBurst)
    local trip = flingTrip
    if not trip or trip.finished then
        return
    end
    trip.finished = true
    if trip.stepConnection then
        trip.stepConnection:Disconnect()
    end
    -- On an intentional button release, make one final bounded contact attempt
    -- before resetting our own character. This cannot set another player's
    -- authoritative velocity; the server decides whether a collision moves them.
    if releaseBurst and trip.active and not state.unloaded
        and LocalPlayer.Character == trip.character and trip.root.Parent
        and trip.humanoid.Health > 0 and trip.targetRoot and trip.targetRoot.Parent
        and trip.targetCharacter and trip.targetRoot:IsDescendantOf(trip.targetCharacter)
        and not trip.targetRoot.Anchored and trip.releaseDirection then
        local releaseOK, releaseErr = pcall(function()
            UIRefs.Status.Text = "Fling: final contact burst • returning shortly"
            local dir = trip.releaseDirection
            local targetPosition = trip.targetRoot.Position
            -- Position once near the contact edge, not repeatedly inside the target.
            local offset = math.max(1.3, math.min(2.0,
                (trip.targetRoot.Size.X + trip.root.Size.X) * 0.45))
            local rootToPivot = trip.root.CFrame:ToObjectSpace(trip.character:GetPivot())
            local contact = CFrame.new(targetPosition - dir * offset) * trip.root.CFrame.Rotation
            trip.character:PivotTo(contact * rootToPivot)
            local finalVelocity = dir * CONFIG.FlingReleaseSpeed
                + Vector3.new(0, CONFIG.FlingReleaseSpeed * 0.08, 0)
            if trip.launchConstraint and trip.launchConstraint.Parent then
                trip.launchConstraint.VectorVelocity = finalVelocity
            end
            trip.root.AssemblyLinearVelocity = finalVelocity
            -- Allow at least a few normal physics steps before restoring position.
            local untilTime = os.clock() + CONFIG.FlingReleaseTime
            repeat
                RunService.Heartbeat:Wait()
            until os.clock() >= untilTime or state.unloaded
                or LocalPlayer.Character ~= trip.character or not trip.root.Parent
            print("[ScriptMM2 FLING] Release contact attempted; server displacement not verified")
        end)
        if not releaseOK then warn("[ScriptMM2 FLING] Release burst: " .. tostring(releaseErr)) end
    end
    if trip.spinConstraint then
        pcall(function() trip.spinConstraint:Destroy() end)
    end
    if trip.launchConstraint then
        pcall(function() trip.launchConstraint:Destroy() end)
    end
    if trip.spinAttachment then
        pcall(function() trip.spinAttachment:Destroy() end)
    end

    local returned, returnError = false, nil
    if trip.active then
        for part, saved in pairs(trip.physics) do
            if part.Parent then
                pcall(function() part.CollisionGroup = saved.collisionGroup end)
                pcall(function() part.CustomPhysicalProperties = saved.properties end)
                pcall(function() part.Massless = saved.massless end)
            end
        end
        for part, saved in pairs(trip.collisions) do
            if part.Parent then
                pcall(function()
                    part.CanCollide = saved
                end)
                if originalCollisions[part] ~= nil then
                    originalCollisions[part] = saved
                end
            end
        end

        if trip.root.Parent then
            pcall(function()
                trip.root.AssemblyLinearVelocity = Vector3.zero
                trip.root.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        if LocalPlayer.Character == trip.character and trip.character.Parent
            and trip.root.Parent and trip.humanoid.Health > 0 then
            local ok, err = pcall(function()
                trip.character:PivotTo(trip.returnPivot)
                if state.fly then
                    trip.humanoid.PlatformStand = true
                    trip.humanoid.AutoRotate = false
                elseif trip.startedFlying then
                    trip.humanoid.PlatformStand = false
                    trip.humanoid.AutoRotate = true
                else
                    trip.humanoid.PlatformStand = trip.platformStand
                    trip.humanoid.AutoRotate = trip.autoRotate
                end
                if not trip.humanoid.PlatformStand then
                    trip.humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end)
            returned, returnError = ok, err
        end

        if trip.flyVelocity and trip.flyVelocity.Parent and trip.flyMaxForce then
            trip.flyVelocity.MaxForce = trip.flyMaxForce
        end
        if trip.flyGyro and trip.flyGyro.Parent and trip.flyMaxTorque then
            trip.flyGyro.MaxTorque = trip.flyMaxTorque
        end
    end

    flingTrip = nil
    flingBusy = false
    if state.noclip then applyNoclip() else restoreNoclip() end
    if not state.unloaded then
        UIRefs.flingMurdererButton.Text = "Inside Fling Murderer"
        UIRefs.flingSheriffButton.Text = "Inside Fling Sheriff"
        setButtonVisual(UIRefs.flingMurdererButton, false)
        setButtonVisual(UIRefs.flingSheriffButton, false)
    end
    return returned, returnError
end

local function flingRole(roleName, chosenPlayer)
    if flingAllActive and roleName ~= "Player" then
        UIRefs.Status.Text = "Fling: stop selected fling first"
        return
    end
    local isMurderer = roleName == "Murderer"
    local isPlayer = roleName == "Player"
    if isPlayer and not flingAllActive then return end
    local function targetMatches(player)
        if isPlayer then
            return player == chosenPlayer and chosenPlayer ~= LocalPlayer and chosenPlayer.Parent == Players
        end
        return (isMurderer and Murder or Sheriff) == player.Name
    end
    if state.unloaded then return end
    if flingBusy then
        if flingTrip and flingTrip.roleName == roleName then
            local returned, returnError = stopRoleFling(true)
            UIRefs.Status.Text = returnError and ("Fling return error: " .. tostring(returnError))
                or (returned and "Fling stopped • returned" or "Fling stopped")
        else
            UIRefs.Status.Text = "Fling: stop current target before switching roles"
        end
        return
    end
    if state.coinFarm and UIRefs.setCoinFarmToggle then UIRefs.setCoinFarmToggle(false) end
    if teleportBusy then
        UIRefs.Status.Text = "Fling: wait for the revolver pickup to finish"
        return
    end
    if pauseAntiFling then pauseAntiFling() end

    local character = getCharacter()
    local root = getRoot()
    local humanoid = getHumanoid()
    if not character or not root or not humanoid or humanoid.Health <= 0
        or root.Anchored or humanoid.Sit then
        UIRefs.Status.Text = "Fling: character not ready / leave the seat first"
        return
    end

    local trip = {
        character = character, root = root, humanoid = humanoid,
        returnPivot = character:GetPivot(), rootCFrame = root.CFrame,
        platformStand = humanoid.PlatformStand, autoRotate = humanoid.AutoRotate,
        startedFlying = state.fly, collisions = {}, physics = {}, active = false, finished = false,
        roleName = roleName,
        flyVelocity = flyObjects.flyVelocity, flyGyro = flyObjects.flyGyro,
    }
    flingTrip = trip
    flingBusy = true
    local activeButton = isMurderer and UIRefs.flingMurdererButton or UIRefs.flingSheriffButton
    if not isPlayer then
        activeButton.Text = "Release " .. roleName .. " Inside Fling [ON]"
        setButtonVisual(activeButton, true)
    end
    UIRefs.Status.Text = "Fling: checking " .. roleName .. "..."

    local outcome = "Fling stopped • returned"
    local ok, err = pcall(function()
        -- Role data may arrive after the round starts. Never activate physics
        -- until a living target is confirmed, and keep the wait cancellable.
        local target, targetName
        local roleDeadline = os.clock() + CONFIG.FlingRoleWait
        repeat
            if trip.finished or state.unloaded or LocalPlayer.Character ~= character
                or (isPlayer and not flingAllActive) then return end
            if not isPlayer then refreshRoles() end
            targetName = isPlayer and (chosenPlayer and chosenPlayer.Name or "")
                or (isMurderer and Murder or Sheriff)
            target = isPlayer and chosenPlayer or (targetName ~= "" and Players:FindFirstChild(targetName) or nil)
            if target and target ~= LocalPlayer and roleAlive(target.Name) then break end
            UIRefs.Status.Text = "Fling: waiting for living " .. roleName .. " / round..."
            task.wait(0.35)
        until os.clock() >= roleDeadline
        if not target or target == LocalPlayer or not roleAlive(target.Name) then
            outcome = "Fling: no living " .. roleName .. " after role wait"
            return
        end

        -- Character parts and the role snapshot can arrive on different frames.
        -- Wait briefly rather than treating a still-streaming target as a failed fling.
        local targetCharacter, targetRoot
        local readyDeadline = os.clock() + CONFIG.FlingTargetWait
        repeat
            if trip.finished or state.unloaded or LocalPlayer.Character ~= character
                or (isPlayer and not flingAllActive) then return end
            if not targetMatches(target) then
                outcome = "Fling: target changed while waiting"
                return
            end
            targetCharacter = target.Character
            targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
            if targetRoot and targetRoot.Parent and not targetRoot.Anchored and roleAlive(target.Name) then break end
            UIRefs.Status.Text = "Fling: waiting for " .. roleName .. " character..."
            RunService.Heartbeat:Wait()
        until os.clock() >= readyDeadline
        if not targetRoot or not targetRoot.Parent or targetRoot.Anchored or not roleAlive(target.Name) then
            outcome = "Fling: target not ready / alive (retry after round starts)"
            return
        end
        if LocalPlayer.Character ~= character or not root.Parent or humanoid.Health <= 0 then
            outcome = "Fling cancelled: character changed/dead"
            return
        end

        local bounds = getFlingMapBounds(targetRoot.Position)
        local direction
        if bounds then
            direction = getFlingExitDirection(bounds, targetRoot.Position)
        else
            -- Spinning remains available outside the map or before its geometry
            -- streams in. Without bounds, do not claim a confirmed map exit.
            local forward = targetRoot.CFrame.LookVector
            local horizontal = Vector3.new(forward.X, 0, forward.Z)
            direction = horizontal.Magnitude > 0.001 and horizontal.Unit or Vector3.new(1, 0, 0)
        end
        local rootToPivot = trip.rootCFrame:ToObjectSpace(trip.returnPivot)
        local boundsRefreshTime = os.clock()
        local outsideSince = nil
        local outsideConfirmed = false
        local runningStatus = "Inside Fling: spinning inside target • Release = burst / return"
        local attemptStarted = os.clock()
        local collisionCheckTime = -math.huge
        local collisionAllowed = false
        local collisionProbeOK = true
        local noContactSince = nil
        local lastResponseAt = os.clock()
        local previousTargetPosition = targetRoot.Position
        local lastAlignment = -math.huge
        local initialTargetPosition = targetRoot.Position
        local bestOutwardTravel = 0
        -- Role lookup can yield while the user changes Fly. Capture the current
        -- controllers immediately before pausing them, not before that request.
        trip.flyVelocity, trip.flyGyro = flyObjects.flyVelocity, flyObjects.flyGyro
        trip.startedFlying = state.fly
        trip.platformStand, trip.autoRotate = humanoid.PlatformStand, humanoid.AutoRotate
        trip.targetCharacter = targetCharacter
        trip.targetRoot = targetRoot
        trip.releaseDirection = direction
        trip.active = true
        UIRefs.Status.Text = runningStatus

        for _, part in ipairs(character:GetChildren()) do
            if part:IsA("BasePart") then
                local saved = originalCollisions[part]
                if saved == nil then saved = part.CanCollide end
                trip.collisions[part] = saved
                trip.physics[part] = {
                    collisionGroup = part.CollisionGroup,
                    properties = part.CustomPhysicalProperties,
                    massless = part.Massless,
                }
                part.CanCollide = true
                -- CanCollide alone does not override non-colliding groups.
                -- Change only our body and restore its settings on every exit.
                part.CollisionGroup = "Default"
                part.CustomPhysicalProperties = PhysicalProperties.new(100, 0, 1, 100, 100)
                part.Massless = false
            end
        end
        if trip.flyVelocity and trip.flyVelocity.Parent then
            trip.flyMaxForce = trip.flyVelocity.MaxForce
            trip.flyVelocity.MaxForce = Vector3.zero
            trip.flyVelocity.Velocity = Vector3.zero
        end
        if trip.flyGyro and trip.flyGyro.Parent then
            trip.flyMaxTorque = trip.flyGyro.MaxTorque
            trip.flyGyro.MaxTorque = Vector3.zero
        end
        humanoid.PlatformStand = true
        humanoid.AutoRotate = false

        local spinVelocity = Vector3.new(CONFIG.FlingSpinSpeed, CONFIG.FlingSpinSpeed, CONFIG.FlingSpinSpeed)
        -- Keep applying torque throughout the attempt, rather than giving
        -- one angular impulse that collisions can slow down.
        trip.spinAttachment = Instance.new("Attachment")
        trip.spinAttachment.Name = "ScriptMM2FlingSpinAttachment"
        trip.spinAttachment.Parent = root
        trip.spinConstraint = Instance.new("AngularVelocity")
        trip.spinConstraint.Name = "ScriptMM2FlingSpin"
        trip.spinConstraint.Attachment0 = trip.spinAttachment
        trip.spinConstraint.RelativeTo = Enum.ActuatorRelativeTo.World
        trip.spinConstraint.AngularVelocity = spinVelocity
        trip.spinConstraint.MaxTorque = CONFIG.FlingSpinTorque
        trip.spinConstraint.ReactionTorqueEnabled = false
        trip.spinConstraint.Enabled = true
        trip.spinConstraint.Parent = root

        -- Maintain the contact velocity throughout the physics step. A one-off
        -- velocity assignment can be cancelled by the first wall/body contact.
        trip.launchConstraint = Instance.new("LinearVelocity")
        trip.launchConstraint.Name = "ScriptMM2FlingLaunch"
        trip.launchConstraint.Attachment0 = trip.spinAttachment
        trip.launchConstraint.RelativeTo = Enum.ActuatorRelativeTo.World
        trip.launchConstraint.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        trip.launchConstraint.ForceLimitsEnabled = true
        trip.launchConstraint.ForceLimitMode = Enum.ForceLimitMode.Magnitude
        trip.launchConstraint.MaxForce = CONFIG.FlingLinearForce
        trip.launchConstraint.VectorVelocity = Vector3.zero
        trip.launchConstraint.Enabled = true
        trip.launchConstraint.Parent = root

        local function hasCollisionPair()
            -- HumanoidRootPart is sometimes non-collidable even when torso/limbs
            -- can transmit a real contact. Check all of our actual body parts.
            for _, ownPart in ipairs(character:GetChildren()) do
                if ownPart:IsA("BasePart") and ownPart.CanCollide then
                    for _, targetPart in ipairs(targetCharacter:GetChildren()) do
                        if targetPart:IsA("BasePart") and targetPart.CanCollide
                            and ownPart:CanCollideWith(targetPart) then
                            local blocked = false
                            -- Some clients do not expose this optional inspection method.
                            -- A failed diagnostic must not terminate the physics loop.
                            local constraintsOK, constraints = pcall(function()
                                return ownPart:GetNoCollisionConstraints()
                            end)
                            if constraintsOK and type(constraints) == "table" then
                                for _, constraint in ipairs(constraints) do
                                    if constraint.Enabled and ((constraint.Part0 == ownPart and constraint.Part1 == targetPart)
                                        or (constraint.Part1 == ownPart and constraint.Part0 == targetPart)) then
                                        blocked = true
                                        break
                                    end
                                end
                            end
                            if not blocked then return true end
                        end
                    end
                end
            end
            return false
        end

        local function canMaintainContact()
            return not trip.finished and not trip.error and not state.unloaded
                and (not isPlayer or flingAllActive)
                and LocalPlayer.Character == character and target.Character == targetCharacter
                and root.Parent and targetRoot.Parent and humanoid.Health > 0
                and not targetRoot.Anchored and (isPlayer or rolesAvailable)
                and targetMatches(target) and roleAlive(target.Name)
        end
        local function alignWithTarget()
            -- Inside mode: place OUR pivot at the target root rather than orbiting
            -- around its perimeter. Only realign at bounded intervals/drift;
            -- never teleport in PostSimulation, which erases collision impulses.
            local center = targetRoot.Position
            local inside = CFrame.new(center) * root.CFrame.Rotation
            character:PivotTo(inside * rootToPivot)
        end
        alignWithTarget()
        lastAlignment = os.clock()

        trip.stepConnection = RunService.PreSimulation:Connect(function(deltaTime)
            if not canMaintainContact() then return end
            local stepOK, stepError = pcall(function()
                if os.clock() - collisionCheckTime >= 0.25 then
                    -- Optional physics APIs may not be implemented by every client.
                    -- Record a diagnostic instead of crashing the connection.
                    local probeOK, allowed = pcall(hasCollisionPair)
                    collisionProbeOK = probeOK
                    collisionAllowed = probeOK and allowed or false
                    collisionCheckTime = os.clock()
                end
                local targetVelocity = targetRoot.AssemblyLinearVelocity
                local outwardSpeed = targetVelocity:Dot(direction)
                -- Collision impulses must run for a full simulation step. Do NOT
                -- teleport us again in PostSimulation: that cancelled the solver.
                local now = os.clock()
                local displacement = targetRoot.Position - root.Position
                local distance = displacement.Magnitude
                -- Follow the target's center instead of driving toward a map edge.
                -- The high angular velocity supplies the rotational contact.
                -- Translational correction is bounded to avoid tunneling.
                if distance > CONFIG.FlingInsideMaxDrift
                    or now - lastAlignment >= CONFIG.FlingInsideRealignInterval then
                    alignWithTarget()
                    lastAlignment = now
                    displacement = targetRoot.Position - root.Position
                    distance = displacement.Magnitude
                end
                local follow = distance > 0.08
                    and displacement.Unit * math.min(CONFIG.FlingInsideFollowSpeed, distance * 35)
                    or Vector3.zero
                local carry = targetVelocity
                if carry.Magnitude > 180 then carry = carry.Unit * 180 end
                humanoid:Move(Vector3.zero, false)
                trip.launchConstraint.VectorVelocity = carry + follow
                root.AssemblyLinearVelocity = trip.launchConstraint.VectorVelocity
                root.AssemblyAngularVelocity = spinVelocity
            end)
            if not stepOK then trip.error = stepError end
        end)

        repeat
            if trip.finished or state.unloaded or trip.error
                or (isPlayer and not flingAllActive) then break end
            if LocalPlayer.Character ~= character or not root.Parent or humanoid.Health <= 0 then
                outcome = "Fling cancelled: character changed/dead"
                break
            end
            if (not isPlayer and not rolesAvailable) or not targetMatches(target) then
                outcome = "Fling: " .. roleName .. " target changed / unavailable"
                break
            end
            if target.Character ~= targetCharacter or not targetRoot.Parent or not roleAlive(target.Name) then
                outcome = "Fling: target left / died"
                break
            end
            if targetRoot.Anchored then
                outcome = "Fling: target became anchored"
                break
            end
            local currentTime = os.clock()
            -- A client-side position reading is not proof of a server fling.
            -- Abort a futile attempt rather than leaving the player spinning forever.
            if not collisionAllowed then
                noContactSince = noContactSince or currentTime
            else
                noContactSince = nil
            end
            local targetDelta = (targetRoot.Position - previousTargetPosition).Magnitude
            previousTargetPosition = targetRoot.Position
            if collisionAllowed and (targetDelta > 0.35
                or targetRoot.AssemblyLinearVelocity.Magnitude >= CONFIG.FlingResponseSpeed) then
                lastResponseAt = currentTime
            end
            -- No-response is diagnostic only. The ON state remains controlled by
            -- the user; a stationary target must not silently stop the fling.
            if bounds and bounds.refresh and currentTime - boundsRefreshTime >= 0.15 then
                bounds.refresh()
                boundsRefreshTime = currentTime
            end
            if bounds and isOutsideFlingMap(bounds, targetRoot.Position) then
                outsideSince = outsideSince or currentTime
                if not outsideConfirmed and currentTime - outsideSince >= CONFIG.FlingExitConfirmTime then
                    outsideConfirmed = true
                    UIRefs.Status.Text = bounds.estimated and "Inside Fling: target outside estimated bounds • Release = return"
                        or "Inside Fling: target outside bounds • Release = return"
                end
            else
                outsideSince = nil
                if outsideConfirmed then
                    outsideConfirmed = false
                    UIRefs.Status.Text = runningStatus
                end
            end
            if not outsideConfirmed then
                local traveled = (targetRoot.Position - initialTargetPosition):Dot(direction)
                bestOutwardTravel = math.max(bestOutwardTravel, traveled)
                local outwardSpeed = targetRoot.AssemblyLinearVelocity:Dot(direction)
                if not collisionAllowed and currentTime - attemptStarted >= 0.25 then
                    UIRefs.Status.Text = "Inside Fling: checking collision pairs • server response unverified"
                elseif bestOutwardTravel >= 8 and outwardSpeed >= CONFIG.FlingResponseSpeed then
                    UIRefs.Status.Text = "Inside Fling: target displacement observed (client) • Release = burst"
                elseif currentTime - attemptStarted >= CONFIG.FlingResponseGrace then
                    UIRefs.Status.Text = "Inside Fling: target stationary locally • Release = burst / return"
                else
                    UIRefs.Status.Text = runningStatus
                end
            end
            RunService.Heartbeat:Wait()
        until false
        if trip.error then error(trip.error) end
    end)

    if trip.finished then return end
    local returned, returnError = stopRoleFling()
    if state.unloaded then return end
    if not ok then
        UIRefs.Status.Text = "Fling error: " .. tostring(err)
    elseif returnError then
        UIRefs.Status.Text = "Fling return error: " .. tostring(returnError)
    elseif trip.active and not returned then
        UIRefs.Status.Text = "Fling cancelled: character changed/dead"
    else
        UIRefs.Status.Text = outcome
    end
end

local function getLocalRole()
    if LocalPlayer.Name == Murder then
        return "Murderer"
    elseif LocalPlayer.Name == Sheriff then
        return "Sheriff"
    elseif LocalPlayer.Name == Hero then
        return "Hero"
    end
    return "Innocent"
end

local function getRoleColor(role, alive)
    if not alive then
        return ESPColors.Dead
    end

    if role == "Murderer" then
        return ESPColors.Murderer
    elseif role == "Sheriff" then
        return ESPColors.Sheriff
    elseif role == "Hero" then
        return ESPColors.Hero
    elseif role == "Innocent" then
        return ESPColors.Innocent
    elseif role == "Unknown" then
        return ESPColors.Unknown
    end

    return ESPColors.Player
end

local function destroyESPForPlayer(player)
    local object = espObjects[player]
    if object then
        if object.highlight then
            object.highlight:Destroy()
        end
        if object.billboard then
            object.billboard:Destroy()
        end
        if object.tracer then
            object.tracer:Destroy()
        end
        espObjects[player] = nil
    end

    local character = player.Character
    if character then
        for _, child in ipairs(character:GetChildren()) do
            if child.Name == "ModMenuESP" or child.Name == "ModMenuESPInfo" then
                child:Destroy()
            end
        end
    end
end

