--// Reparent the existing MAIN controls into their category pages. No callbacks
--// are recreated; UIRefs still point to the original controls and slider states.
do
    local move = {}
    for _, child in ipairs(UIRefs.Content:GetChildren()) do
        if child:IsA("GuiObject") then
            local order = child.LayoutOrder
            local destination
            if child == UIRefs.gravityButton or child == UIRefs.spinButton then
                -- These are movement abilities, not visual effects.
                child.LayoutOrder = child == UIRefs.gravityButton and 12.2 or 12.3
                destination = nil -- Already parented to Player.
            elseif child == UIRefs.antiFlingButton then
                child.LayoutOrder = 30.1
                destination = UIRefs.CategoryPages.utilities
            else
                destination = order >= 30 and UIRefs.CategoryPages.utilities
                    or (order >= 20 and UIRefs.CategoryPages.visuals)
                    or (order >= 13 and UIRefs.CategoryPages.combat)
                    or nil -- 1..12: Player / movement.
            end
            if destination then
                table.insert(move, {child, destination})
            end
        end
    end
    for _, pair in ipairs(move) do pair[1].Parent = pair[2] end
end


UIRefs.dragStart = nil
UIRefs.startPosition = nil
UIRefs.draggingMain = false
UIRefs.mainDragInput = nil

local function beginDrag(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end
    if UIRefs.mainDragInput then return end
    UIRefs.mainDragInput = input
    UIRefs.draggingMain = true
    UIRefs.dragStart = input.Position
    UIRefs.startPosition = UIRefs.Main.Position
end

local function updateDrag(input)
    if not UIRefs.draggingMain then
        return
    end
    if not isPointerMove(input, UIRefs.mainDragInput) then return end

    local delta = (input.Position - UIRefs.dragStart) / Scale.Scale
    UIRefs.Main.Position = UDim2.new(
        UIRefs.startPosition.X.Scale,
        UIRefs.startPosition.X.Offset + delta.X,
        UIRefs.startPosition.Y.Scale,
        UIRefs.startPosition.Y.Offset + delta.Y
    )
end

addConnection(UIRefs.dragHandle.InputBegan:Connect(beginDrag))
addConnection(UIS.InputChanged:Connect(updateDrag))
addConnection(UIS.InputEnded:Connect(function(input)
    if isPointerEnd(input, UIRefs.mainDragInput) then
        UIRefs.draggingMain = false
        UIRefs.mainDragInput = nil
