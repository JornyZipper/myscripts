--// Feature helpers
local function setCharacterMovement()
    applyMovementSettings(getHumanoid())
end

local function stopFly()
    local humanoid = flyObjects.humanoid
    flyObjects.active = false
    flyObjects.up = false
    flyObjects.down = false

    if flyObjects.flyVelocity then
        pcall(function()
            flyObjects.flyVelocity:Destroy()
        end)
        flyObjects.flyVelocity = nil
    end

    if flyObjects.flyGyro then
        pcall(function()
            flyObjects.flyGyro:Destroy()
        end)
        flyObjects.flyGyro = nil
    end

    if humanoid and humanoid.Parent == getCharacter() and humanoid.Health > 0 then
        humanoid.PlatformStand = flyObjects.platformStand
        humanoid.AutoRotate = flyObjects.autoRotate
        pcall(function()
            if not humanoid.PlatformStand then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
        end)
    end
    flyObjects.humanoid = nil

    UIRefs.MobileFlyControls.Visible = false
end

local function startFly()
    stopFly()

    local character = getCharacter()
    if not character then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or humanoid.Health <= 0 or root.Anchored or humanoid.Sit then
        return
    end
    flyObjects.humanoid = humanoid
    flyObjects.platformStand = humanoid.PlatformStand
    flyObjects.autoRotate = humanoid.AutoRotate

    local flyVelocity = Instance.new("BodyVelocity")
    flyVelocity.Name = "ModMenuFlyVelocity"
    flyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    flyVelocity.P = 10000
    flyVelocity.Velocity = Vector3.zero
    flyVelocity.Parent = root

    local flyGyro = Instance.new("BodyGyro")
    flyGyro.Name = "ModMenuFlyGyro"
    flyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    flyGyro.P = 10000
    flyGyro.D = 500
    flyGyro.CFrame = root.CFrame
    flyGyro.Parent = root

    flyObjects.flyVelocity = flyVelocity
    flyObjects.flyGyro = flyGyro
    flyObjects.active = true

    humanoid.PlatformStand = true
    humanoid.AutoRotate = false

    UIRefs.MobileFlyControls.Visible = IsMobile and state.fly
end

applyNoclip = function()
    if not state.noclip or (flingTrip and flingTrip.active) then
        return
    end

    local character = getCharacter()
    if not character then
        return
    end

    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("BasePart") then
            if originalCollisions[object] == nil then
                originalCollisions[object] = object.CanCollide
            end
            object.CanCollide = false
        end
    end
end

restoreNoclip = function()
    if flingTrip and flingTrip.active then return end
    for object, canCollide in pairs(originalCollisions) do
        if object and object.Parent then
            object.CanCollide = canCollide
        end
        originalCollisions[object] = nil
    end
end


--// Coin farm uses the existing Fly/NoClip controllers. No remote spam or instant TP.
--// Actual pickup must still be accepted by the game server.
do
    local function coinPart(obj)
        if not obj or not obj.Parent then return nil end
        local cached = coinFarm.partCache[obj]
        if cached then
            -- MM2 removes a visual part on pickup. Never return a detached cache.
            if cached.Parent and (cached == obj or cached:IsDescendantOf(obj))
                and cached:IsDescendantOf(Workspace) then return cached end
            coinFarm.partCache[obj] = nil
        end
        local n = obj.Name:lower():gsub("[^%w]", "")
        if n ~= "coin" and n ~= "coinserver" and n ~= "coinpickup" and n ~= "goldcoin" then return nil end
        if not obj:IsDescendantOf(Workspace) then return nil end
        -- Don't farm decorative lobby coins or player-owned models/tools.
        local ancestor = obj.Parent
        while ancestor and ancestor ~= Workspace do
            local an = ancestor.Name:lower():gsub("[^%w]", "")
            if an == "lobby" or an == "mainlobby" or an == "lobbymap" or ancestor:IsA("Tool") then return nil end
            if ancestor:IsA("Model") and Players:GetPlayerFromCharacter(ancestor) then return nil end
            ancestor = ancestor.Parent
        end
        if obj:IsA("BasePart") then
            -- The visible Coin inside Coin_Server is not a second target.
            if obj.Parent and obj.Parent:IsA("Model") and obj.Parent.Name:lower():gsub("[^%w]", "") == "coinserver" then
                return nil
            end
            coinFarm.partCache[obj] = obj
            return obj
        end
        if obj:IsA("Model") then
            -- Resolve expensive model lookup just once per live target.
            local visual = obj:FindFirstChild("Coin", true)
            local resolved = visual and visual:IsA("BasePart") and visual
                or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
            if resolved then coinFarm.partCache[obj] = resolved end
            return resolved
        end
        return nil
    end

    local function registerCoin(obj)
        if not obj or not obj.Parent then return end
        -- Some MM2 variants spawn a model first, its MeshPart later.
        local candidate = obj
        if obj:IsA("BasePart") and obj.Parent:IsA("Model") then
            local pn = obj.Parent.Name:lower():gsub("[^%w]", "")
            if pn == "coinserver" or pn == "coin" then candidate = obj.Parent end
        end
        if coinFarm.targetSet[candidate] or not coinPart(candidate) then return end
        coinFarm.targetSet[candidate] = true
        coinFarm.targets[#coinFarm.targets + 1] = candidate
    end

    -- Never build Workspace:GetDescendants() on the simulation thread: doing so
    -- caused multi-second FPS stalls in large MM2 maps. Process <=180 nodes/yield.
    -- DescendantAdded remains the primary source of new coin objects.
    local function scanCoins(force)
        local now = os.clock()
        if coinFarm.scanRunning then return end
        if not force and now - coinFarm.lastScan < CONFIG.CoinFarmScanInterval then return end
        coinFarm.lastScan = now
        coinFarm.scanRunning = true
        local generation = coinFarm.scanGeneration
        local baseline = coinFarm.baselineScan
        task.spawn(function()
            local queue, head = Workspace:GetChildren(), 1
            local namedCount, sample = 0, nil
            while head <= #queue do
                if state.unloaded or not state.coinFarm or generation ~= coinFarm.scanGeneration then
                    return -- a newer scan owns scanRunning after re-arm
                end
                local batch = 0
                while head <= #queue and batch < 90 do
                    local obj = queue[head]
                    queue[head] = false -- release old references as the scan advances
                    head += 1
                    batch += 1
                    if obj and obj.Parent then
                        local name = obj.Name:lower()
                        if name:find("coin", 1, true) then
                            namedCount += 1
                            if not sample then sample = obj.Name end
                            registerCoin(obj)
                            if baseline and coinFarm.targetSet[obj] then
                                coinFarm.knownCoins[obj] = true
                            end
                            -- BaseParts inside Coin_Server get promoted to their model.
                            if baseline and obj:IsA("BasePart") and obj.Parent:IsA("Model")
                                and coinFarm.targetSet[obj.Parent] then
                                coinFarm.knownCoins[obj.Parent] = true
                            end
                        end
                        -- Skip irrelevant heavy lobby and live character subtrees.
                        local norm = name:gsub("[^%w]", "")
                        local skipTree = norm == "lobby" or norm == "mainlobby" or norm == "lobbymap"
                            or (obj:IsA("Model") and Players:GetPlayerFromCharacter(obj) ~= nil)
                        if not skipTree then
                            for _, child in ipairs(obj:GetChildren()) do queue[#queue + 1] = child end
                        end
                    end
                end
                task.wait()
            end
            if generation ~= coinFarm.scanGeneration or state.unloaded then return end
            -- Compact stale references without discarding coins added by events.
            local kept = {}
            local set = setmetatable({}, {__mode = "k"})
            for _, object in ipairs(coinFarm.targets) do
                if not set[object] and coinPart(object) then
                    set[object] = true
                    kept[#kept + 1] = object
                end
            end
            coinFarm.targets, coinFarm.targetSet = kept, set
            coinFarm.coinLikeSample, coinFarm.coinNamedCount = sample, namedCount
            coinFarm.baselineScan, coinFarm.scanRunning = false, false
        end)
    end

    -- Track newly spawned coins instead of traversing the entire map every frame.
    -- A new collectible Coin_Server model also recovers from a missed CoinsStarted event.
    -- This is narrower than treating any old replicated coin as a new round.
    addConnection(Workspace.DescendantAdded:Connect(function(obj)
        if not state.coinFarm or state.unloaded then return end
        local n = obj.Name:lower()
        local parent = obj.Parent
        local pn = parent and parent.Name:lower() or ""
        if n:find("coin", 1, true) or pn:find("coin", 1, true) then
            registerCoin(obj)
            if parent and parent:IsA("Model") then registerCoin(parent) end
            local spawnedModel = obj:IsA("Model") and obj
                or (parent and parent:IsA("Model") and parent)
            if coinFarm.roundEnded and spawnedModel
                and spawnedModel.Name:lower():gsub("[^%w]", "") == "coinserver"
                and not coinFarm.roundEndKnown[spawnedModel] and coinPart(spawnedModel) then
                -- Only fresh model instances after GameOver can re-arm the farm.
                coinFarm.roundEnded = false
                coinFarm.deathLock = false
                coinFarm.paused = true
                coinFarm.allowExistingCoins = true
                coinFarm.freshSince = nil
                coinFarm.limitReached = false
                coinFarm.collected = 0
                coinFarm.pendingPickups = {}
                coinFarm.visited = setmetatable({}, {__mode = "k"})
                coinFarm.skipped = setmetatable({}, {__mode = "k"})
                UIRefs.Status.Text = "Coin Farm: new coin spawn • preparing Fly"
            end
        end
    end))

    -- Arm while stationary: existing coins become baseline, only newly spawned
    -- collectible instances can release the next round's waiting state.
    local function armWaitingForNewCoins(allowExistingCoins)
        coinFarm.target = nil
        coinFarm.lastNearestCheck = 0
        coinFarm.paused = true
        coinFarm.freshSince = nil
        -- Only an explicit ON press may use coins already spawned this round.
        -- Respawns and round transitions must wait for NEW coin instances.
        coinFarm.allowExistingCoins = (allowExistingCoins == true)
        -- New round / respawn: fresh per-round pickup estimate.
        coinFarm.collected = 0
        coinFarm.cachedBagCount = nil
        coinFarm.lastHudRead = -1
        coinFarm.bagLabels = nil
        coinFarm.pendingPickups = {}
        coinFarm.visited = setmetatable({}, {__mode = "k"})
        coinFarm.skipped = setmetatable({}, {__mode = "k"})
        coinFarm.limitReached = false
        coinFarm.limitEmptySince = nil
        coinFarm.knownCoins = setmetatable({}, {__mode = "k"})
        coinFarm.freshCoins = setmetatable({}, {__mode = "k"})
        -- Cancel any older incremental traversal before resetting target caches.
        coinFarm.scanGeneration += 1
        coinFarm.scanRunning = false
        coinFarm.baselineScan = not coinFarm.allowExistingCoins
        coinFarm.targets = {}
        coinFarm.targetSet = setmetatable({}, {__mode = "k"})
        coinFarm.lastScan = -math.huge
        scanCoins(true)
        stopFly()
        restoreNoclip()
    end
    UIRefs.armCoinFarmWaiting = armWaitingForNewCoins

    -- MM2 exposes explicit CoinsStarted / GameOver events in Remotes.Gameplay.
    -- These prevent stale locally replicated coins from locking the farm forever
    -- after death or the 40-coin limit. We never invoke either remote.
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local gameplay = remotes and remotes:FindFirstChild("Gameplay")
    if gameplay then
        local coinsStarted = gameplay:FindFirstChild("CoinsStarted")
        if coinsStarted and coinsStarted:IsA("RemoteEvent") then
            addConnection(coinsStarted.OnClientEvent:Connect(function()
                if not state.coinFarm or state.unloaded then return end
                coinFarm.roundEnded = false
                coinFarm.deathLock = false
                coinFarm.deathEmptySince = nil
                -- This signal confirms a new collectible round: existing coins
                -- are allowed after spawn confirmation, even if added earlier.
                armWaitingForNewCoins(true)
                UIRefs.Status.Text = "Coin Farm: new round • waiting for coin spawn"
            end))
        end
        local gameOver = gameplay:FindFirstChild("GameOver")
        if gameOver and gameOver:IsA("RemoteEvent") then
            addConnection(gameOver.OnClientEvent:Connect(function()
                if not state.coinFarm or state.unloaded then return end
                -- GameOver pauses movement only; never change state.coinFarm/UI toggle.
                coinFarm.roundEnded = true
                coinFarm.roundEndKnown = setmetatable({}, {__mode = "k"})
                for _, old in ipairs(coinFarm.targets) do coinFarm.roundEndKnown[old] = true end
                coinFarm.paused = true
                coinFarm.target = nil
                coinFarm.pendingPickups = {}
                if flyObjects.flyVelocity then flyObjects.flyVelocity.Velocity = Vector3.zero end
                stopFly()
                restoreNoclip()
                coinFarm.switching = true
                if UIRefs.setFlyToggle then UIRefs.setFlyToggle(false) end
                if UIRefs.setNoclipToggle then UIRefs.setNoclipToggle(false) end
                coinFarm.switching = false
                UIRefs.Status.Text = "Coin Farm: round ended • waiting for next coins"
            end))
        end
    end
    -- A defeated player cannot continue the route. Keep the ON setting,
    -- but require the old round's coins to clear before arming a new round.
    UIRefs.pauseCoinFarmOnDeath = function(character)
        if not state.coinFarm or state.unloaded or LocalPlayer.Character ~= character then return end
        if coinFarm.deathLock then return end
        coinFarm.deathLock = true
        coinFarm.deathEmptySince = nil
        coinFarm.paused = true
        coinFarm.allowExistingCoins = false
        coinFarm.freshSince = nil
        coinFarm.target = nil
        coinFarm.pendingPickups = {}
        if flyObjects.flyVelocity then flyObjects.flyVelocity.Velocity = Vector3.zero end
        stopFly()
        restoreNoclip()
        UIRefs.Status.Text = "Coin Farm: ON • defeated; waiting for next round"
    end

    -- A plain numeric TextLabel inside a Coin GUI may be a currency balance, NOT
    -- the current round's bag. Only accept explicit progress out of 40.
    -- Without an unambiguous HUD, retain the conservative locally observed count.
    -- HUD candidates are indexed once; continuously walking PlayerGui:GetDescendants()
    -- every half second was a measurable source of client-side GC / small frame spikes.
    local function indexBagLabels()
        local items = {}
        for _, gui in ipairs(PlayerGui:GetDescendants()) do
            if (gui:IsA("TextLabel") or gui:IsA("TextButton"))
                and not gui:IsDescendantOf(UIRefs.ScriptMM2) then
                local n = gui.Name:lower()
                local pn = gui.Parent and gui.Parent.Name:lower() or ""
                local raw = tostring(gui.Text or "")
                if n:find("coin", 1, true) or n:find("bag", 1, true)
                    or pn:find("coin", 1, true) or pn:find("bag", 1, true)
                    or raw:match("%d+%s*/%s*40") then
                    items[#items + 1] = gui
                end
            end
        end
        coinFarm.bagLabels = items
        coinFarm.lastBagIndex = os.clock()
    end
    addConnection(PlayerGui.DescendantAdded:Connect(function(gui)
        if not state.coinFarm or not coinFarm.bagLabels then return end
        if not (gui:IsA("TextLabel") or gui:IsA("TextButton")) then return end
        if gui:IsDescendantOf(UIRefs.ScriptMM2) then return end
        local n = gui.Name:lower()
        local pn = gui.Parent and gui.Parent.Name:lower() or ""
        if n:find("coin", 1, true) or n:find("bag", 1, true)
            or pn:find("coin", 1, true) or pn:find("bag", 1, true) then
            coinFarm.bagLabels[#coinFarm.bagLabels + 1] = gui
        end
    end))
    local function readCoinBagCount()
        local now = os.clock()
        if now - coinFarm.lastHudRead < 0.8 then return coinFarm.cachedBagCount end
        coinFarm.lastHudRead = now
        if not coinFarm.bagLabels or (now - coinFarm.lastBagIndex > 12 and #coinFarm.bagLabels == 0) then
            indexBagLabels()
        end
        local highest = nil
        for _, gui in ipairs(coinFarm.bagLabels) do
            if gui.Parent then
                local raw = tostring(gui.Text or "")
                local count = raw:match("^%s*(%d+)%s*/%s*40%s*$")
                    or raw:match("[Cc][Oo][Ii][Nn][Ss]?%s*:?%s*(%d+)%s*/%s*40")
                count = tonumber(count)
                if count and count >= 0 and count <= CONFIG.CoinFarmRoundLimit then
                    highest = math.max(highest or 0, count)
                end
            end
        end
        coinFarm.cachedBagCount = highest
        return highest
    end

    local function completeCoinFarmRound()
        if coinFarm.limitReached then return end
        coinFarm.limitReached = true
        coinFarm.limitEmptySince = nil
        coinFarm.paused = true
        coinFarm.target = nil
        coinFarm.pendingPickups = {}
        if flyObjects.flyVelocity then flyObjects.flyVelocity.Velocity = Vector3.zero end
        stopFly()
        restoreNoclip()
        -- Explicitly switch Fly OFF without switching the persistent farm toggle OFF.
        coinFarm.switching = true
        if UIRefs.setFlyToggle then UIRefs.setFlyToggle(false) end
        if UIRefs.setNoclipToggle then UIRefs.setNoclipToggle(false) end
        coinFarm.switching = false
        UIRefs.Status.Text = "Coin Farm: 40/40 • Fly OFF; waiting for next round"
        -- Do NOT set Humanoid.Health to zero or force a respawn.
    end

    -- Local disappearance is pickup evidence; merely approaching a coin is not.
    -- If the MM2 bag HUD is visible, its count overrides this fallback estimate.
    local function updatePickupProgress()
        if coinFarm.limitReached or not state.coinFarm then return end
        local now = os.clock()
        local bagCount = readCoinBagCount()
        for object, markedAt in pairs(coinFarm.pendingPickups) do
            local part = coinPart(object)
            local localGone = not part
                or (part and (part.LocalTransparencyModifier >= 0.95 or part.Transparency >= 0.95))
            if localGone then
                coinFarm.visited[object] = true
                coinFarm.pendingPickups[object] = nil
                coinFarm.skipped[object] = math.huge
                if bagCount == nil then coinFarm.collected += 1 end
            elseif now - markedAt > 1.2 then
                -- An unchanged coin is NOT a confirmed pickup. The old logic
                -- marked it visited forever, eventually excluding every visible
                -- coin from the available-target list. Retry after a cooldown.
                coinFarm.pendingPickups[object] = nil
                coinFarm.skipped[object] = now + CONFIG.CoinFarmRetryDelay
            end
        end
        -- Pickup progress within one round cannot decrease. Do not let unrelated
        -- HUD zeros or late UI refreshes erase locally confirmed pickups.
        if bagCount ~= nil then coinFarm.collected = math.max(coinFarm.collected, bagCount) end
        if coinFarm.collected >= CONFIG.CoinFarmRoundLimit then
            completeCoinFarmRound()
            return
        end
        UIRefs.Status.Text = "Coin Farm: " .. coinFarm.collected .. "/"
            .. CONFIG.CoinFarmRoundLimit
            .. (bagCount ~= nil and " (bag HUD)" or " (locally confirmed estimate)")
    end

    -- Workspace can keep a coin replicated after it disappears just for this
    -- player. Separate raw coin instances from genuinely available targets.
    local function coinAvailable(object)
        local part = coinPart(object)
        if not part then return nil end
        if coinFarm.visited[object] or coinFarm.pendingPickups[object] then return nil end
        if (coinFarm.skipped[object] or 0) > os.clock() then return nil end
        -- MM2 can use invisible trigger/mesh parts even for an UNCOLLECTED coin.
        -- Excluding by transparency alone left every target unavailable and Fly OFF.
        -- Confirm pickup from pending/visited or object removal instead.
        return part
    end

    -- Re-evaluate distance from the CURRENT character position for each pickup.
    -- Exclude pending pickups immediately, otherwise a still-replicated coin can
    -- be targeted over and over before the local counter marks it visited.
    local function nextCoin(root)
        local now = os.clock()
        local closest, shortest = nil, math.huge
        for _, obj in ipairs(coinFarm.targets) do
            local part = coinAvailable(obj)
            if part then
                local d = (part.Position - root.Position).Magnitude
                if d < shortest then closest, shortest = obj, d end
            end
        end
        return closest, shortest
    end

    UIRefs.stopCoinFarm = function()
        if not state.coinFarm then return end
        state.coinFarm = false
        coinFarm.paused = false
        coinFarm.target = nil
        coinFarm.scanGeneration += 1
        coinFarm.scanRunning = false
        coinFarm.targets = {}
        coinFarm.targetSet = setmetatable({}, {__mode = "k"})
        coinFarm.partCache = setmetatable({}, {__mode = "k"})
        coinFarm.bagLabels = nil
        coinFarm.knownCoins = setmetatable({}, {__mode = "k"})
        coinFarm.freshCoins = setmetatable({}, {__mode = "k"})
        coinFarm.freshSince = nil
        coinFarm.allowExistingCoins = false
        coinFarm.collected = 0
        coinFarm.pendingPickups = {}
        coinFarm.visited = setmetatable({}, {__mode = "k"})
        coinFarm.skipped = setmetatable({}, {__mode = "k"})
        coinFarm.limitReached = false
        coinFarm.limitEmptySince = nil
        coinFarm.deathLock = false
        coinFarm.deathEmptySince = nil
        coinFarm.roundEnded = false
        coinFarm.switching = true
        if UIRefs.setFlyToggle then UIRefs.setFlyToggle(coinFarm.savedFly) end
        if UIRefs.setNoclipToggle then UIRefs.setNoclipToggle(coinFarm.savedNoclip) end
        coinFarm.switching = false
        if flyObjects.flyVelocity then flyObjects.flyVelocity.Velocity = Vector3.zero end
        if not state.unloaded then UIRefs.Status.Text = "Coin Farm: OFF • Fly/NoClip restored" end
    end

    UIRefs.startCoinFarm = function()
        if state.coinFarm then return end
        local char, root, hum = getCharacter(), getRoot(), getHumanoid()
        if state.unloaded then return end
        -- Enabling the farm while another action is active is allowed: remember
        -- ON and wait for the character/round rather than auto-switching OFF.
        coinFarm.savedFly, coinFarm.savedNoclip = state.fly, state.noclip
        -- Set PAUSED before enabling Fly/NoClip, otherwise flight can start
        -- in the lobby for a frame before the next movement refresh.
        state.coinFarm = true
        coinFarm.paused = true
        coinFarm.deathLock = not (hum and hum.Health > 0)
        coinFarm.deathEmptySince = nil
        coinFarm.roundEnded = false
        -- Fly/NoClip are enabled ONLY after the spawn confirmation in refreshCoinFarm.
        coinFarm.progressAt = os.clock()
        coinFarm.lastDistance = math.huge
        armWaitingForNewCoins(not coinFarm.deathLock)
        UIRefs.Status.Text = coinFarm.deathLock
            and "Coin Farm: ON • defeated; waiting for next round"
            or "Coin Farm: ON • waiting for round coins"
    end

    -- Keep ON across rounds but NEVER use coins already present at activation
    -- as proof a new round has started. Require newly observed coin instances.
    UIRefs.refreshCoinFarm = function()
        if not state.coinFarm or state.unloaded then return end
        local refreshNow = os.clock()
        if refreshNow - coinFarm.lastRefresh < 0.45 then return end
        coinFarm.lastRefresh = refreshNow
        if coinFarm.roundEnded then return end
        if coinFarm.limitReached then
            -- There is no forced death now. Wait for the actual old round's
            -- coins to disappear, then arm the next round while staying ON.
            local now = os.clock()
            if now - coinFarm.lastScan >= CONFIG.CoinFarmScanInterval then scanCoins() end
            local anyOldCoin = false
            for _, obj in ipairs(coinFarm.targets) do
                if coinPart(obj) then anyOldCoin = true break end
            end
            if anyOldCoin then
                coinFarm.limitEmptySince = nil
            else
                coinFarm.limitEmptySince = coinFarm.limitEmptySince or now
                if now - coinFarm.limitEmptySince >= 1.0 then
                    armWaitingForNewCoins(false)
                    UIRefs.Status.Text = "Coin Farm: ON • waiting for next round coins"
                end
            end
            return
        end
        local char, root, hum = getCharacter(), getRoot(), getHumanoid()
        -- Health must be checked BEFORE pending pickups can advance the counter.
        if char and hum and hum.Health <= 0 then
            if UIRefs.pauseCoinFarmOnDeath then UIRefs.pauseCoinFarmOnDeath(char) end
            return
        end
        if not coinFarm.deathLock then updatePickupProgress() end
        if coinFarm.limitReached then return end
        -- Fly deliberately sets PlatformStand=true; do not mistake our own active
        -- flight for a failed/unfinished character and suspend it each frame.
        local ready = char and root and hum and hum.Health > 0
            and not root.Anchored and not hum.Sit
            and not teleportBusy and not flingBusy and not shootMurdererBusy
            and (not hum.PlatformStand or (flyObjects.active and flyObjects.humanoid == hum))
        local now = os.clock()
        if now - coinFarm.lastScan >= CONFIG.CoinFarmScanInterval then
            scanCoins()
        end
        local visibleCount, freshCount, availableCount, availableFreshCount = 0, 0, 0, 0
        for _, obj in ipairs(coinFarm.targets) do
            if coinPart(obj) then
                visibleCount += 1
                if not coinFarm.knownCoins[obj] then
                    coinFarm.knownCoins[obj] = true
                    coinFarm.freshCoins[obj] = true
                end
                if coinFarm.freshCoins[obj] then freshCount += 1 end
                if coinAvailable(obj) then
                    availableCount += 1
                    if coinFarm.freshCoins[obj] then availableFreshCount += 1 end
                end
            end
        end
        -- After defeat, remain idle through respawn and the rest of this round.
        -- A stable empty map is the next-round baseline; NEW coin instances can
        -- then release the existing spawn confirmation delay.
        if coinFarm.deathLock then
            if visibleCount > 0 then
                coinFarm.deathEmptySince = nil
                UIRefs.Status.Text = "Coin Farm: ON • defeated; waiting for round end"
                return
            end
            coinFarm.deathEmptySince = coinFarm.deathEmptySince or now
            if now - coinFarm.deathEmptySince >= 1.0 then
                coinFarm.deathLock = false
                coinFarm.deathEmptySince = nil
                armWaitingForNewCoins(false)
                UIRefs.Status.Text = "Coin Farm: ON • waiting for next round coins"
            end
            return
        end
        -- Coins all disappeared: arm the *next* round, without turning OFF.
        if visibleCount == 0 then
            if coinFarm.scanRunning then
                if now - coinFarm.lastDiagnostic >= 2.0 then
                    coinFarm.lastDiagnostic = now
                    UIRefs.Status.Text = "Coin Farm: ON • indexing coin objects..."
                end
                return
            end
            if not coinFarm.paused then
                armWaitingForNewCoins()
            end
            coinFarm.freshSince = nil
            if now - coinFarm.lastDiagnostic >= 2.0 then
                coinFarm.lastDiagnostic = now
                UIRefs.Status.Text = "Coin Farm: 0 usable coins • names="
                    .. tostring(coinFarm.coinNamedCount or 0) .. " (e.g. "
                    .. tostring(coinFarm.coinLikeSample or "none") .. ") • waiting"
            end
            return
        end
        -- All targets can remain in Workspace but be locally hidden or visited.
        -- Do not fly in that state, and do not treat it as a new round.
        if availableCount == 0 then
            coinFarm.freshSince = nil
            if flyObjects.flyVelocity then flyObjects.flyVelocity.Velocity = Vector3.zero end
            if not coinFarm.paused then stopFly() end
            -- Preserve permission to resume this round after a transient skip.
            -- The death and 40/40 branches above are deliberately separate.
            coinFarm.allowExistingCoins = true
            coinFarm.paused = true
            local pendingCount, retryCount, hiddenCount = 0, 0, 0
            for _, obj in ipairs(coinFarm.targets) do
                local part = coinPart(obj)
                if part then
                    if coinFarm.pendingPickups[obj] then pendingCount += 1 end
                    if (coinFarm.skipped[obj] or 0) > now and not coinFarm.visited[obj] then retryCount += 1 end
                    if part.Transparency >= 0.95 or part.LocalTransparencyModifier >= 0.95 then hiddenCount += 1 end
                end
            end
            if visibleCount > 0 then
                UIRefs.Status.Text = "Coin Farm: " .. visibleCount .. " found, " .. retryCount
                    .. " retrying, " .. pendingCount .. " pending, " .. hiddenCount .. " hidden • waiting"
            else
                UIRefs.Status.Text = "Coin Farm: 0 targets; candidate: "
                    .. tostring(coinFarm.coinLikeSample or "none") .. " • waiting"
            end
            return
        end
        if not ready then
            if not coinFarm.paused then
                armWaitingForNewCoins()
                UIRefs.Status.Text = "Coin Farm: ON • character not ready; waiting"
            end
            return
        end
        if coinFarm.paused then
            -- If enabled mid-round, already-spawned collectible coins are valid.
            -- Otherwise (after respawn / round end) require genuinely NEW coins.
            if (coinFarm.allowExistingCoins and availableCount >= 1)
                or availableFreshCount >= CONFIG.CoinFarmMinFreshCoins then
                coinFarm.freshSince = coinFarm.freshSince or now
                if now - coinFarm.freshSince >= CONFIG.CoinFarmSpawnConfirm then
                    -- Fly is OFF after a completed 40-coin round; enable it only
                    -- once the next round's coin spawn is confirmed.
                    coinFarm.switching = true
                    if UIRefs.setFlyToggle then UIRefs.setFlyToggle(true) end
                    if UIRefs.setNoclipToggle then UIRefs.setNoclipToggle(true) end
                    coinFarm.switching = false
                    coinFarm.paused = false
                    coinFarm.allowExistingCoins = false
                    -- Choose nearest collectible coin from the current position as
                    -- soon as Fly starts; recalculate after every pickup.
                    coinFarm.target = nextCoin(root)
                    coinFarm.progressAt, coinFarm.lastDistance = now, math.huge
                    UIRefs.Status.Text = "Coin Farm: flying to nearest coin • " .. values.coinFarmSpeed .. " studs/s"
                end
            else
                coinFarm.freshSince = nil
                if now - coinFarm.lastDiagnostic >= 2.0 then
                    coinFarm.lastDiagnostic = now
                    UIRefs.Status.Text = "Coin Farm: ON • coins=" .. availableCount
                        .. " fresh=" .. availableFreshCount
                        .. " allowExisting=" .. tostring(coinFarm.allowExistingCoins)
                        .. " (waiting for round)"
                end
            end
        end
    end

    UIRefs.coinFarmVelocity = function(root)
        local hum = getHumanoid()
        if not state.coinFarm or coinFarm.paused or coinFarm.deathLock or coinFarm.roundEnded
            or not hum or hum.Health <= 0 or root ~= getRoot() then return nil end
        local now = os.clock()
        if now - coinFarm.lastScan >= CONFIG.CoinFarmScanInterval then scanCoins() end

        -- V0.9.52: continuously choose the closest AVAILABLE coin to our current
        -- character position. A new closer coin can replace the current target,
        -- rather than waiting for the old (possibly distant) target to disappear.
        -- Rate-limited to 5 checks/sec and uses only the cached coin array.
        if now - coinFarm.lastNearestCheck >= 0.25 then
            coinFarm.lastNearestCheck = now
            local nearest, nearestDistance = nextCoin(root)
            local currentPart = coinAvailable(coinFarm.target)
            local currentDistance = currentPart
                and (currentPart.Position - root.Position).Magnitude or math.huge
            if nearest ~= coinFarm.target and nearest
                and (not currentPart or nearestDistance + 0.10 < currentDistance) then
                coinFarm.target = nearest
                coinFarm.progressAt, coinFarm.lastDistance = now, math.huge
            end
        end

        -- Retarget from cached targets; NEVER force a full Workspace traversal on target loss.
        -- A collected/removed coin may vanish before the scheduled network scan.
        for attempt = 1, 3 do
            local previousTarget = coinFarm.target
            local part = coinPart(previousTarget)
            if not part or not coinAvailable(previousTarget) then
                -- Refresh on target loss and periodically while waiting. The
                -- candidate distances are measured from the CURRENT root.Position
                -- on every acquisition, without scanning Workspace every frame.
                -- DescendantAdded keeps the cache current; scanCoins is rate-limited.
                -- No forced full-map scan on every retarget.
                coinFarm.target = nextCoin(root)
                part = coinPart(coinFarm.target)
                coinFarm.progressAt, coinFarm.lastDistance = now, math.huge
            end

            if not part then
                if now - coinFarm.lastMovementStatus >= 1.5 then
                    coinFarm.lastMovementStatus = now
                    UIRefs.Status.Text = #coinFarm.targets > 0
                        and "Coin Farm: no uncollected coins left nearby • waiting"
                        or "Coin Farm: no coin objects detected • waiting for spawn"
                end
                return Vector3.zero
            end

            local delta = part.Position - root.Position
            local dist = delta.Magnitude
            if dist < coinFarm.lastDistance - 0.2 then
                coinFarm.progressAt, coinFarm.lastDistance = now, dist
            end

            if dist <= CONFIG.CoinFarmReach then
                -- V0.9.3: at reach distance, immediately retarget in this same
                -- simulation frame. Confirmation remains asynchronous via HUD/
                -- local disappearance; no artificial stop at the coin.
                if not coinFarm.visited[coinFarm.target] and coinFarm.pendingPickups[coinFarm.target] == nil then
                    coinFarm.pendingPickups[coinFarm.target] = now
                end
                coinFarm.skipped[coinFarm.target] = now + CONFIG.CoinFarmRetryDelay
                coinFarm.target = nil
            elseif now - coinFarm.progressAt > 4.0 then
                -- A stuck/blocked target should not stall the whole route.
                coinFarm.skipped[coinFarm.target] = now + CONFIG.CoinFarmRetryDelay
                coinFarm.target = nil
            else
                -- V0.9.3 continuous travel: no slowdown near the coin.
                -- Keep the newer speed slider as an optional override.
                return delta.Unit * values.coinFarmSpeed
            end
        end

        -- All nearby targets may have been reached/skipped; rescan next frame.
        return Vector3.zero
    end
end

enableFullBright = function()
    if not savedLighting then
        savedLighting = {
            Ambient = Lighting.Ambient,
            Brightness = Lighting.Brightness,
            ClockTime = Lighting.ClockTime,
            FogEnd = Lighting.FogEnd,
            GlobalShadows = Lighting.GlobalShadows,
            OutdoorAmbient = Lighting.OutdoorAmbient,
        }
    end

    Lighting.Ambient = Color3.new(1, 1, 1)
    Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
    Lighting.Brightness = 3
    Lighting.ClockTime = 14
    Lighting.FogEnd = 100000
    Lighting.GlobalShadows = false
end

disableFullBright = function()
    if not savedLighting then
        return
    end

    Lighting.Ambient = savedLighting.Ambient
    Lighting.Brightness = savedLighting.Brightness
    Lighting.ClockTime = savedLighting.ClockTime
    Lighting.FogEnd = savedLighting.FogEnd
    Lighting.GlobalShadows = savedLighting.GlobalShadows
    Lighting.OutdoorAmbient = savedLighting.OutdoorAmbient
    savedLighting = nil
end

local function findGetPlayerData()
    local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if remote and remote:IsA("RemoteFunction") then
        return remote
    end
    return nil
end

local roleRequestPending = false
local function clearRoles()
    roles, Murder, Sheriff, Hero = {}, "", "", ""
    rolesAvailable = false
    rolesUpdatedAt = -math.huge
    if UIRefs.updateRoleHUD then UIRefs.updateRoleHUD() end
end

local function refreshRoles()
    if state.unloaded then
        return false
    end
    if roleRequestPending then
        repeat RunService.Heartbeat:Wait() until not roleRequestPending or state.unloaded
        return not state.unloaded and rolesAvailable
    end

    local remote = findGetPlayerData()
    if not remote then
        clearRoles()
        UIRefs.Status.Text = "Role ESP: GetPlayerData not found"
        return false
    end

    roleRequestPending = true
    local success, result = pcall(function()
        return remote:InvokeServer()
    end)
    roleRequestPending = false

    if state.unloaded then
        return false
    end

    if not success or type(result) ~= "table" then
        clearRoles()
        UIRefs.Status.Text = "Role ESP: failed to read roles"
        return false
    end

    roles = result
    rolesAvailable = true
    rolesUpdatedAt = os.clock()
    Murder = ""
    Sheriff = ""
    Hero = ""

    for playerName, data in pairs(roles) do
        if type(data) == "table" then
            if data.Role == "Murderer" then
                Murder = playerName
            elseif data.Role == "Sheriff" then
                Sheriff = playerName
            elseif data.Role == "Hero" then
                Hero = playerName
            end
        end
    end

    if UIRefs.updateRoleHUD then UIRefs.updateRoleHUD() end

    if teleportBusy or flingBusy or shootMurdererBusy or state.spectateMurderer then return true end
    if LocalPlayer.Name == Murder then
        UIRefs.Status.Text = "Role: Murderer"
    elseif LocalPlayer.Name == Sheriff then
        UIRefs.Status.Text = "Role: Sheriff"
    elseif LocalPlayer.Name == Hero then
        UIRefs.Status.Text = "Role: Hero"
    else
        UIRefs.Status.Text = "Role: Innocent / unknown"
    end

    return true
end


--// Camera-only spectate: role targets and manually selected players.
--// The compatibility flag state.spectateMurderer means any spectate mode is active.
do
    local spectate = {
        mode = nil, player = nil, camera = nil, savedType = nil,
        savedSubject = nil, target = nil, targetPlayer = nil,
        previousRoleName = nil,
    }
    local function setSpectateStatus(message)
        if UIRefs.spectateStatus then UIRefs.spectateStatus.Text = message end
        if not state.unloaded and UIRefs.Status then UIRefs.Status.Text = message end
    end
    local function paintSpectateButtons()
        local murder = spectate.mode == "Murderer"
        local sheriff = spectate.mode == "Sheriff"
        UIRefs.spectateMurdererButton.Text = "Spectate Murderer " .. (murder and "[ON]" or "[OFF]")
        UIRefs.spectateSheriffButton.Text = "Spectate Sheriff " .. (sheriff and "[ON]" or "[OFF]")
        setButtonVisual(UIRefs.spectateMurdererButton, murder)
        setButtonVisual(UIRefs.spectateSheriffButton, sheriff)
        if UIRefs.spectatePlayerButtons then
            for player, button in pairs(UIRefs.spectatePlayerButtons) do
                if button and button.Parent then
                    local active = spectate.mode == "Player" and spectate.player == player
                    setButtonVisual(button, active)
                    button.Text = player.DisplayName .. "  (@" .. player.Name .. ")" .. (active and "  [WATCHING]" or "")
                end
            end
        end
    end
    stopSpectateMurderer = function(reason)
        if not state.spectateMurderer then return end
        state.spectateMurderer = false
        local camera = Workspace.CurrentCamera
        -- Restore the local camera, including when the previous target despawned.
        if camera and (camera == spectate.camera) and
            (camera.CameraSubject == spectate.target or not spectate.target or
                not spectate.target.Parent) then
            pcall(function()
                local ownHumanoid = getHumanoid()
                camera.CameraType = (spectate.savedType == Enum.CameraType.Scriptable)
                    and Enum.CameraType.Custom or (spectate.savedType or Enum.CameraType.Custom)
                camera.CameraSubject = (ownHumanoid and ownHumanoid.Parent and ownHumanoid)
                    or (spectate.savedSubject and spectate.savedSubject.Parent and spectate.savedSubject)
                    or camera.CameraSubject
            end)
        end
        spectate.mode, spectate.player, spectate.targetPlayer = nil, nil, nil
        spectate.camera, spectate.savedType, spectate.savedSubject = nil, nil, nil
        spectate.target, spectate.previousRoleName = nil, nil
        paintSpectateButtons()
        if reason then setSpectateStatus(reason) end
    end
    local function startSpectate(mode, player)
        if state.unloaded or shootMurdererBusy or teleportBusy then
            setSpectateStatus("Spectate: finish current camera action first")
            return
        end
        if mode == "Player" and (not player or player == LocalPlayer or player.Parent ~= Players) then
            setSpectateStatus("Spectate: choose another player")
            return
        end
        if state.spectateMurderer and spectate.mode == mode and spectate.player == player then
            stopSpectateMurderer("Spectate OFF • own camera")
            return
        end
        if state.spectateMurderer then stopSpectateMurderer() end
        local camera = Workspace.CurrentCamera
        if not camera or camera.CameraType == Enum.CameraType.Scriptable then
            setSpectateStatus("Spectate: camera is busy")
            return
        end
        spectate.mode, spectate.player = mode, player
        spectate.camera, spectate.savedType, spectate.savedSubject = camera, camera.CameraType, camera.CameraSubject
        spectate.target, spectate.targetPlayer = nil, nil
        spectate.previousRoleName = nil
        state.spectateMurderer = true
        if mode ~= "Player" then rolesAvailable = false end
        paintSpectateButtons()
        setSpectateStatus("Spectate: waiting for " .. (player and player.DisplayName or mode) .. "...")
    end
    toggleSpectateMurderer = function() startSpectate("Murderer") end
    UIRefs.toggleSpectateSheriff = function() startSpectate("Sheriff") end
    UIRefs.selectSpectatePlayer = function(player) startSpectate("Player", player) end
    UIRefs.stopSpectate = function() stopSpectateMurderer("Spectate OFF • own camera") end

    -- Recreate buttons only on join/leave/page open; transient buttons own their click links.
    UIRefs.rebuildSpectatorList = function()
        if state.unloaded or not UIRefs.spectatePlayerList then return end
        if UIRefs.spectatePlayerButtons then
            for _, button in pairs(UIRefs.spectatePlayerButtons) do button:Destroy() end
        end
        UIRefs.spectatePlayerButtons = {}
        if UIRefs.teleportPlayerButtons then
            for _, button in pairs(UIRefs.teleportPlayerButtons) do button:Destroy() end
        end
        UIRefs.teleportPlayerButtons = {}
        if UIRefs.bringPlayerButtons then
            for _, button in pairs(UIRefs.bringPlayerButtons) do button:Destroy() end
        end
        UIRefs.bringPlayerButtons = {}
        if UIRefs.attackPlayerButtons then
            for _, button in pairs(UIRefs.attackPlayerButtons) do button:Destroy() end
        end
        UIRefs.attackPlayerButtons = {}
        if UIRefs.selectedAttackPlayer and UIRefs.selectedAttackPlayer.Parent ~= Players then
            UIRefs.selectedAttackPlayer = nil
            UIRefs.attackStatus.Text = "Selected player left. Choose another player."
        end
        local players = Players:GetPlayers()
        table.sort(players, function(a, b) return a.Name:lower() < b.Name:lower() end)
        local order = 0
        for _, player in ipairs(players) do
            if player ~= LocalPlayer then
                order += 1
                local button = create("TextButton", {
                    Name = "Watch_" .. tostring(player.UserId),
                    Size = UDim2.new(1, -4, 0, 38),
                    BackgroundColor3 = UITheme.item, BorderSizePixel = 0,
                    Font = Enum.Font.GothamSemibold,
                    Text = player.DisplayName .. "  (@" .. player.Name .. ")",
                    TextColor3 = UITheme.text, TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
                    LayoutOrder = order,
                }, UIRefs.spectatePlayerList)
                create("UICorner", { CornerRadius = UDim.new(0, 8) }, button)
                UIRefs.spectatePlayerButtons[player] = button
                button.MouseButton1Click:Connect(function() UIRefs.selectSpectatePlayer(player) end)
                local tpButton = create("TextButton", {
                    Name = "TP_" .. tostring(player.UserId),
                    Size = UDim2.new(1, -4, 0, 38),
                    BackgroundColor3 = Color3.fromRGB(42, 66, 100), BorderSizePixel = 0,
                    Font = Enum.Font.GothamSemibold,
                    Text = "TP → " .. player.DisplayName .. "  (@" .. player.Name .. ")",
                    TextColor3 = Color3.fromRGB(235, 240, 255), TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
                    LayoutOrder = order,
                }, UIRefs.teleportPlayerList)
                create("UICorner", { CornerRadius = UDim.new(0, 8) }, tpButton)
                UIRefs.teleportPlayerButtons[player] = tpButton
                tpButton.MouseButton1Click:Connect(function()
                    if UIRefs.teleportToPlayer then task.spawn(UIRefs.teleportToPlayer, player) end
                end)
                local bringButton = create("TextButton", {
                    Name = "Bring_" .. tostring(player.UserId),
                    Size = UDim2.new(1, -4, 0, 38),
                    BackgroundColor3 = Color3.fromRGB(78, 59, 106), BorderSizePixel = 0,
                    Font = Enum.Font.GothamSemibold,
                    Text = "Bring → " .. player.DisplayName .. " (@" .. player.Name .. ")",
                    TextColor3 = Color3.fromRGB(245, 235, 255), TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
                    LayoutOrder = order,
                }, UIRefs.bringPlayerList)
