--// Android safety: some executors can register local MP3 assets but crash the
--// Roblox client when those custom assets are played from rapid UI toggles.
--// Keep toggle feedback on Roblox's built-in sound, independent from GitHub MP3s.
local MobileToggleSounds = {}
local function playSafeToggleSound(enabled)
    local key = enabled and "on" or "off"
    local sound = MobileToggleSounds[key]
    if not sound or not sound.Parent then
        sound = Instance.new("Sound")
        sound.Name = "ScriptMM2_MobileSafeToggle_" .. key
        sound.SoundId = "rbxasset://sounds/electronicpingshort.wav"
        sound.PlaybackSpeed = enabled and 1.18 or 0.82
        sound.Volume = enabled and 0.42 or 0.65
        sound.Looped = false
        sound.Parent = SoundService
        MobileToggleSounds[key] = sound
    end
    pcall(function()
        sound:Stop()
        sound.TimePosition = 0
        sound:Play()
    end)
end

local function makeNativeFallbackSound(which)
    if MenuAudio.unloaded or MenuAudio.ready[which] then return end
    local sound = Instance.new("Sound")
    sound.Name = "ScriptMM2_UI_Fallback_" .. which
    sound.SoundId = "rbxasset://sounds/electronicpingshort.wav"
    local speeds = {open=0.92, close=0.72, toggleOn=1.18, toggleOff=0.82, tab=1.35}
    sound.PlaybackSpeed = speeds[which] or 1
    sound.Volume = (MenuAudio.volumes[which] or 0.4) * MenuAudio.volumeFactor
    sound.Looped = false
    sound.Parent = SoundService
    pcall(function() ContentProvider:PreloadAsync({sound}) end)
    if MenuAudio.unloaded then sound:Destroy(); return end
    MenuAudio.ready[which] = sound
    print("[ScriptMM2 AUDIO] Native mobile fallback: " .. which)
end

local function findLocalAssetFunction()
    if type(getcustomasset) == "function" then return getcustomasset end
    if type(getsynasset) == "function" then return getsynasset end
    if type(getasset) == "function" then return getasset end
    if type(syn) == "table" and type(syn.getcustomasset) == "function" then
        return syn.getcustomasset
    end
    return nil
end

local function setupMenuAudio()
    local assetFn = findLocalAssetFunction()
    if type(writefile) ~= "function" or not assetFn then
        warn("[ScriptMM2 AUDIO] Custom MP3 unavailable on this Android executor; using native fallback sounds")
        for which in pairs(MenuAudio.urls) do makeNativeFallbackSound(which) end
        return
    end
    for which, url in pairs(MenuAudio.urls) do
        task.spawn(function()
            if MenuAudio.unloaded then return end
            local filename = MenuAudio.files[which]
            local cached = false
            if type(isfile) == "function" then
                local ok, exists = pcall(isfile, filename)
                cached = ok and exists == true
            end
            if not cached then
                local ok, body = pcall(function() return game:HttpGet(url) end)
                if not ok or type(body) ~= "string" or #body < 128
                    or (body:sub(1, 3) ~= "ID3" and body:byte(1) ~= 255) then
                    warn("[ScriptMM2 AUDIO] MP3 download failed: " .. which .. "; using fallback")
                    makeNativeFallbackSound(which)
                    return
                end
                local saved, err = pcall(writefile, filename, body)
                if not saved then
                    warn("[ScriptMM2 AUDIO] Cache write failed: " .. which .. " (" .. tostring(err) .. "); using fallback")
                    makeNativeFallbackSound(which)
                    return
                end
            end
            local ok, assetId = pcall(assetFn, filename)
            if not ok or type(assetId) ~= "string" or assetId == "" then
                warn("[ScriptMM2 AUDIO] Local asset unavailable: " .. which .. "; using fallback")
                makeNativeFallbackSound(which)
                return
            end
            if MenuAudio.unloaded then return end
            local sound = Instance.new("Sound")
            sound.Name = "ScriptMM2_UI_" .. which
            sound.SoundId = assetId
            sound.Volume = (MenuAudio.volumes[which] or 0.4) * MenuAudio.volumeFactor
            sound.Looped = false
            sound.Parent = SoundService
            local preloadOK = pcall(function() ContentProvider:PreloadAsync({sound}) end)
            if MenuAudio.unloaded then sound:Destroy(); return end
            if not preloadOK or not sound.IsLoaded then
                sound:Destroy()
                warn("[ScriptMM2 AUDIO] MP3 preload failed: " .. which .. "; using fallback")
                makeNativeFallbackSound(which)
                return
            end
            if MenuAudio.ready[which] and MenuAudio.ready[which] ~= sound then
                pcall(function() MenuAudio.ready[which]:Destroy() end)
            end
            MenuAudio.ready[which] = sound
            print("[ScriptMM2 AUDIO] Preloaded mobile MP3: " .. which)
        end)
    end
end

task.spawn(setupMenuAudio)

