--// Experimental remote-argument Silent Aim based on the supplied readable MM2 script.
--// Does not turn the camera, fire weapons automatically, or promise server acceptance.
local Silent = {installed = false, old = nil, error = nil, rawMeta = nil, wrapper = nil}
function Silent.target(name)
    local player = name and Players:FindFirstChild(name)
    local char = player and player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local part = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
    if player ~= LocalPlayer and hum and hum.Health > 0 and part and part:IsA("BasePart") then
        return part
    end
    return nil
end
function Silent.closest()
    local mine = LocalPlayer.Character
    local root = mine and mine:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, distance = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local part = Silent.target(player.Name)
            if part then
                local d = (part.Position - root.Position).Magnitude
                if d < distance then best, distance = part, d end
            end
        end
    end
    return best, distance
end
function Silent.redirect(object, method, args)
    if state.unloaded then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum or hum.Health <= 0 then return end

    -- Current MM2 GunClient (including TouchTapInWorld) fires:
    --     Gun.Shoot:FireServer(originCFrame, targetCFrame)
    -- On Android we leave the game's touch-fire handler intact and only replace
    -- its second CFrame argument. That avoids the PC-only Gun.Activated replacement
    -- and avoids an extra/double shot.
    if state.silentGun and method == "FireServer" and typeof(args[2]) == "CFrame"
        and object:IsA("RemoteEvent") and object.Name == "Shoot" then
        local gun = object.Parent
        local bag = LocalPlayer:FindFirstChild("Backpack")
        if gun and gun:IsA("Tool") and gun.Name == "Gun"
            and (gun.Parent == char or (bag and gun.Parent == bag)) then
            local aim = Silent.xenoTargetCFrame()
            if aim then args[2] = aim end
        end
        return
    end

    -- Legacy signatures remain supported for compatibility with old MM2 builds.
    if typeof(args[2]) ~= "Vector3" then return end
    if state.silentGun and method == "InvokeServer" and object:IsA("RemoteFunction") and object.Name == "ShootGun" then
        local target = rolesAvailable and Murder ~= "" and Silent.target(Murder)
        if target then
            local velocity = target.AssemblyLinearVelocity
            args[2] = target.Position + Vector3.new(velocity.X, 0, velocity.Z) / 40
        end
    elseif state.silentKnife and method == "FireServer" and object:IsA("RemoteEvent") and object.Name == "Throw" then
        local target, distance = Silent.closest()
        if target then
            local velocity = target.AssemblyLinearVelocity
            local lead = math.clamp(distance / 180, 0.035, 0.22)
            args[2] = target.Position + Vector3.new(velocity.X, 0, velocity.Z) * lead
        end
    end
end
function Silent.install()
    if Silent.installed then return true end
    if type(getnamecallmethod) ~= "function" or type(newcclosure) ~= "function" then
        return false, "Executor: getnamecallmethod/newcclosure unavailable"
    end
    if type(hookmetamethod) == "function" then
        local old
        local wrapper = newcclosure(function(object, ...)
            local args = {...}
            if not (type(checkcaller) == "function" and checkcaller()) then
                pcall(Silent.redirect, object, getnamecallmethod(), args)
            end
            return old(object, (table.unpack or unpack)(args))
        end)
        local ok, result = pcall(function() return hookmetamethod(game, "__namecall", wrapper) end)
        if not ok or type(result) ~= "function" then return false, "hookmetamethod failed" end
        old = result
        Silent.wrapper, Silent.old, Silent.installed = wrapper, old, true
        return true
    end
    if type(getrawmetatable) ~= "function" or type(setreadonly) ~= "function" then
        return false, "Executor: __namecall hook API unavailable"
    end
    local ok, result = pcall(function()
        local meta = getrawmetatable(game)
        local old = meta.__namecall
        local wrapper = newcclosure(function(object, ...)
            local args = {...}
            if not (type(checkcaller) == "function" and checkcaller()) then
                pcall(Silent.redirect, object, getnamecallmethod(), args)
            end
            return old(object, (table.unpack or unpack)(args))
        end)
        setreadonly(meta, false)
        meta.__namecall = wrapper
        setreadonly(meta, true)
        Silent.rawMeta, Silent.wrapper, Silent.old = meta, wrapper, old
    end)
    if not ok then return false, "__namecall installation failed: " .. tostring(result) end
    Silent.installed = true
    return true
end
function Silent.stop()
    state.silentGun, state.silentKnife = false, false
    -- Leave hook inert. Restoring a shared metatable would risk overwriting another script's hook.
end

--// V0.9.44 isolated experimental GunClient-activation replacement.
--// Never require/patch WeaponService or RobloxScript modules, and never install
--// a shared __namecall / hookfunction interception. This mode is opt-in and
--// refuses to run unless the executor positively identifies the ONE original
--// GunClient Tool.Activated connection and can reversibly disable that handler.
--// Shoot signature comes from the user's decompiled GunClient:
--//     Gun.Shoot:FireServer(GunRaycastAttachment.WorldCFrame, targetCFrame)
--// The server may still reject a redirected shot.
function Silent.restoreXeno(keepEnabled)
    if not keepEnabled then state.silentGun = false end
    if Silent.xenoActivation then
        pcall(function() Silent.xenoActivation:Disconnect() end)
        Silent.xenoActivation = nil
    end
    if Silent.xenoAncestry then
        pcall(function() Silent.xenoAncestry:Disconnect() end)
        Silent.xenoAncestry = nil
    end
    if Silent.xenoOriginalConnection then
        local conn = Silent.xenoOriginalConnection
        Silent.xenoOriginalConnection = nil
        local ok, err = pcall(function() conn:Enable() end)
        if not ok then warn("[ScriptMM2] Could not restore GunClient handler: " .. tostring(err)) end
    end
    Silent.xenoTool = nil
    Silent.xenoInstalled = false
end

function Silent.xenoTargetCFrame()
    if not state.silentGun or not rolesAvailable or Murder == "" then return nil end
    local camera, mine = Workspace.CurrentCamera, LocalPlayer.Character
    local target = Silent.target(Murder)
    if not camera or not mine or not target then return nil end
    local hum = mine:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    local targetHumanoid = target.Parent and target.Parent:FindFirstChildOfClass("Humanoid")
    local point, visible = camera:WorldToViewportPoint(target.Position)
    if not visible or point.Z <= 0 then return nil end
    local center = camera.ViewportSize * 0.5
    if (Vector2.new(point.X, point.Y) - center).Magnitude > values.aimRadius then return nil end
    if state.aimVisibleOnly and not state.wallbang then
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {mine, target.Parent}
        params.IgnoreWater = true
        if Workspace:Raycast(camera.CFrame.Position, target.Position - camera.CFrame.Position, params) then return nil end
    end

    -- V1.0: adaptive Silent Revolver prediction. Airborne targets used to feel
    -- sluggish because vertical lead was capped to a short fixed window. Keep
    -- the correction bounded, but react faster to Jumping/Freefall and range.
    local velocity = target.AssemblyLinearVelocity
    local distance = (target.Position - camera.CFrame.Position).Magnitude
    local horizontalLead = math.clamp(values.aimLeadMs / 1000 + distance / 2600, 0, 0.24)
    local offset = Vector3.new(velocity.X, 0, velocity.Z) * horizontalLead
    if offset.Magnitude > 5.5 then offset = offset.Unit * 5.5 end
    local predicted = target.Position + offset

    local airborne = math.abs(velocity.Y) > 3.5
    if targetHumanoid and targetHumanoid.Health > 0 then
        local targetState = targetHumanoid:GetState()
        airborne = airborne
            or targetHumanoid.FloorMaterial == Enum.Material.Air
            or targetState == Enum.HumanoidStateType.Jumping
            or targetState == Enum.HumanoidStateType.Freefall
    end

    if airborne then
        local t = values.jumpLeadMs / 1000 + distance / 1900
        if velocity.Y > 8 then
            t += 0.018 -- rising target: catch the jump sooner
        elseif velocity.Y < -8 then
            t += 0.010 -- falling target: small extra fall compensation
        end
        t = math.clamp(t, 0.035, 0.22)
        local vertical = velocity.Y * t - 0.5 * Workspace.Gravity * t * t
        predicted += Vector3.new(0, math.clamp(vertical, -5.0, 5.5), 0)
    end

    return CFrame.new(predicted)
end

function Silent.installXeno()
    if Silent.xenoInstalled then return true end
    if UIS.PreferredInput == Enum.PreferredInput.Touch then
        return false, "PC mouse mode only; touch fire signature differs"
    end
    if type(getconnections) ~= "function" then return false, "Xeno getconnections unavailable" end
    local char, bag = LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack")
    local gun = (char and char:FindFirstChild("Gun")) or (bag and bag:FindFirstChild("Gun"))
    if not gun or not gun:IsA("Tool") then return false, "Equip/pick up Gun first" end
    local client, remote = gun:FindFirstChild("GunClient"), gun:FindFirstChild("Shoot")
    if not client or not client:IsA("LocalScript") or not remote or not remote:IsA("RemoteEvent") then
        return false, "GunClient or Gun.Shoot RemoteEvent not found"
    end
    local okList, list = pcall(getconnections, gun.Activated)
    if not okList or type(list) ~= "table" then return false, "Cannot inspect Gun.Activated connections" end
    -- Xeno can expose the one activated callback while masking its `script`
    -- environment (`getfenv(fn).script == nil`). In a clean, single-script
    -- session the supplied GunClient source has exactly one Activated:Connect.
    -- Accept this narrow fallback ONLY for one visible, active callback and
    -- with the expected GunClient + Shoot objects present. More than one is
    -- ambiguous: refuse instead of disabling unrelated game/third-party code.
    if #list ~= 1 then
        return false, "Expected exactly 1 Gun.Activated handler; found " .. tostring(#list) .. " (restart Roblox; run only this version)"
    end
    local selected = list[1]
    local fnOK, fn = pcall(function() return selected.Function end)
    if not fnOK or type(fn) ~= "function" then
        return false, "Xeno did not expose the sole Gun.Activated function"
    end
    local ownerOK, ownerEnv = pcall(getfenv, fn)
    if ownerOK and type(ownerEnv) == "table" then
        local owner = rawget(ownerEnv, "script")
        if owner ~= nil and owner ~= client then
            return false, "Sole activation handler belongs to another script"
        end
    end
    if type(selected.Disable) ~= "function" or type(selected.Enable) ~= "function" then
        return false, "Xeno connection has no reversible Disable/Enable"
    end
    local enabledOK, wasEnabled = pcall(function() return selected.State end)
    if enabledOK and wasEnabled == false then
        return false, "Original activation handler is already disabled"
    end
    -- Install our replacement before disabling the game's own connection so a
    -- failed :Disable() cannot leave the weapon without a click handler.
    local okConnect, replacement = pcall(function()
        return gun.Activated:Connect(function()
            if state.unloaded or not state.silentGun or LocalPlayer.Character ~= gun.Parent then return end
            local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local attachment = root and root:FindFirstChild("GunRaycastAttachment")
            if not attachment then return end
            local aim = Silent.xenoTargetCFrame()
            if not aim then
                local mouse = LocalPlayer:GetMouse()
                aim = mouse and mouse.Hit
            end
            if typeof(aim) ~= "CFrame" then return end
            local okShot, shotError = pcall(function()
                remote:FireServer(attachment.WorldCFrame, aim)
            end)
            if not okShot then warn("[ScriptMM2] Gun shot failed: " .. tostring(shotError)) end
        end)
    end)
    if not okConnect or not replacement then return false, "Cannot attach replacement activation: " .. tostring(replacement) end
    local okDisable, disableError = pcall(function() selected:Disable() end)
    if not okDisable then
        replacement:Disconnect()
        return false, "Cannot disable original GunClient: " .. tostring(disableError)
    end
    local stateOK, stateValue = pcall(function() return selected.State end)
    if stateOK and stateValue == true then
        replacement:Disconnect()
        pcall(function() selected:Enable() end)
        return false, "GunClient remained active; refusing a possible double shot"
    end
    Silent.xenoOriginalConnection, Silent.xenoActivation = selected, replacement
    Silent.xenoTool, Silent.xenoInstalled = gun, true
    Silent.xenoAncestry = gun.AncestryChanged:Connect(function(_, parent)
        if not parent and Silent.xenoTool == gun then
            -- Weapon was destroyed/removed at round transition. Preserve user ON preference.
            Silent.restoreXeno(true)
            if not state.unloaded and state.silentGun then
                Silent.xenoStatusKey = nil -- let the retry worker publish WAITING
            end
        end
    end)
    return true
end

local function addConnection(connection, bucket)
    bucket = bucket or connections
    table.insert(bucket, connection)
    return connection
end

local function disconnectBucket(bucket)
    for i = #bucket, 1, -1 do
        local connection = bucket[i]
        if connection and connection.Disconnect then
            pcall(function()
                connection:Disconnect()
            end)
        end
        bucket[i] = nil
    end
end

local function getCharacter()
    return LocalPlayer.Character
end

local function getHumanoid()
    local character = getCharacter()
    if not character then
        return nil
    end
    return character:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local character = getCharacter()
    if not character then
        return nil
    end
    return character:FindFirstChild("HumanoidRootPart")
end

local function stopRegularSpin()
    if spinState.root and spinState.root.Parent and not flingBusy then
        pcall(function() spinState.root.AssemblyAngularVelocity = spinState.velocity end)
    end
    spinState.root, spinState.velocity = nil, nil
end

local function isAliveCharacter(player)
    local character = player.Character
    if not character then
        return false
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    return humanoid ~= nil and humanoid.Health > 0
end

-- Save only properties a feature actually overrides, per character.
local function applyMovementSettings(humanoid)
    if not humanoid then return end
    local saved = movementSnapshots[humanoid]
    if state.speed or state.jump then
        saved = saved or {}
        movementSnapshots[humanoid] = saved
    end
    if state.speed then
        if saved.walkSpeed == nil then saved.walkSpeed = humanoid.WalkSpeed end
        humanoid.WalkSpeed = values.walkSpeed
    elseif saved and saved.walkSpeed ~= nil then
        humanoid.WalkSpeed = saved.walkSpeed
        saved.walkSpeed = nil
    end
    if state.jump then
        if saved.useJumpPower == nil then
            saved.useJumpPower = humanoid.UseJumpPower
            saved.jumpPower = humanoid.JumpPower
            saved.jumpHeight = humanoid.JumpHeight
        end
        humanoid.UseJumpPower = true
        humanoid.JumpPower = values.jumpPower
    elseif saved and saved.useJumpPower ~= nil then
        humanoid.JumpPower = saved.jumpPower
        humanoid.JumpHeight = saved.jumpHeight
        humanoid.UseJumpPower = saved.useJumpPower
        saved.useJumpPower, saved.jumpPower, saved.jumpHeight = nil, nil, nil
    end
    if saved and next(saved) == nil then movementSnapshots[humanoid] = nil end
end

local function applyCameraFOV()
    local camera = Workspace.CurrentCamera
    if state.unloaded or not fovState.active or not camera then return end
    if fovState.saved[camera] == nil then fovState.saved[camera] = camera.FieldOfView end
    camera.FieldOfView = values.fov
end

local function restoreCameraFOV()
    fovState.active = false
    for camera, value in pairs(fovState.saved) do
        pcall(function() camera.FieldOfView = value end)
    end
    table.clear(fovState.saved)
end

local function isPointerMove(input, source)
    return source and ((source.UserInputType == Enum.UserInputType.Touch and input == source)
        or (source.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement))
end

local function isPointerEnd(input, source)
    return source and ((source.UserInputType == Enum.UserInputType.Touch and input == source)
        or (source.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseButton1))
end

