--// V0.9.47: persistent user ON setting. The temporary GunClient connection
--// may disappear each round; ON now means "armed / awaiting weapon", not "hook live".
--// Retry at a bounded interval (no scanning Workspace, no WeaponService require).
function Silent.publishXenoStatus(key, message)
    if state.unloaded or not state.silentGun or Silent.xenoStatusKey == key then return end
    Silent.xenoStatusKey = key
    if UIRefs.Status then UIRefs.Status.Text = message end
end
function Silent.beginXenoWatcher()
    Silent.xenoWatcherGeneration = (Silent.xenoWatcherGeneration or 0) + 1
    local generation = Silent.xenoWatcherGeneration
    task.spawn(function()
        while state.silentGun and not state.unloaded and Silent.xenoWatcherGeneration == generation do
            local char, bag = LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack")
            local tool = Silent.xenoTool
            if Silent.xenoInstalled and (not tool or (tool.Parent ~= char and tool.Parent ~= bag)) then
                Silent.restoreXeno(true)
            end
            if IsMobile then
                -- Android/Touch: keep MM2's original TouchTapInWorld handler and
                -- redirect only Gun.Shoot's target CFrame through __namecall.
                local hookOK, hookReason = Silent.install()
                local gun = (char and char:FindFirstChild("Gun")) or (bag and bag:FindFirstChild("Gun"))
                if not hookOK then
                    local detail = tostring(hookReason or "mobile hook unavailable")
                    Silent.publishXenoStatus("mobile-error:" .. detail, "Silent Revolver MOBILE: " .. detail)
                elseif gun and gun:IsA("Tool") and gun:FindFirstChild("Shoot") then
                    Silent.publishXenoStatus("mobile-active", "Silent Revolver MOBILE: ready • use normal fire button")
                else
                    Silent.publishXenoStatus("mobile-waiting", "Silent Revolver MOBILE: ON • waiting for revolver")
                end
            elseif Silent.xenoInstalled then
                Silent.publishXenoStatus("active", "Silent Revolver ON: connected; server hit unverified")
            else
                local ok, reason = Silent.installXeno()
                if ok then
                    Silent.publishXenoStatus("active", "Silent Revolver ON: connected; server hit unverified")
                elseif tostring(reason) == "Equip/pick up Gun first" then
                    Silent.publishXenoStatus("waiting", "Silent Revolver ON: waiting for revolver")
                else
                    local detail = tostring(reason or "connection unavailable")
                    Silent.publishXenoStatus("retry:" .. detail, "Silent Revolver ON: waiting / retrying: " .. detail)
                end
            end
            task.wait(1.0)
        end
    end)
end
