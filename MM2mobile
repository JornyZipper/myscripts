--// Dedicated Android layout. The PC tree is reused, but the geometry is
--// genuinely compact instead of shrinking a 580x610 desktop window into tiny text.
local function applyCompactMobileLayout()
    if not IsMobile then return end
    local baseW, baseH = 350, 520
    UIRefs.Main.Size = UDim2.fromOffset(baseW, baseH)
    UIRefs.TopBar.Size = UDim2.new(1, 0, 0, 58)

    if BrandTile then
        BrandTile.Position = UDim2.fromOffset(10, 10)
        BrandTile.Size = UDim2.fromOffset(36, 36)
    end
    if UIRefs.Title then
        UIRefs.Title.Position = UDim2.fromOffset(54, 8)
        UIRefs.Title.Size = UDim2.new(1, -128, 0, 21)
        UIRefs.Title.TextSize = 15
    end
    if UIRefs.Status then
        UIRefs.Status.Position = UDim2.fromOffset(54, 30)
        UIRefs.Status.Size = UDim2.new(1, -126, 0, 18)
        UIRefs.Status.TextSize = 9
    end
    if UIRefs.Minimize then
        UIRefs.Minimize.Position = UDim2.new(1, -70, 0, 13)
        UIRefs.Minimize.Size = UDim2.fromOffset(27, 27)
    end
    if UIRefs.Close then
        UIRefs.Close.Position = UDim2.new(1, -38, 0, 13)
        UIRefs.Close.Size = UDim2.fromOffset(27, 27)
    end

    local sideX, sideY, sideW = 8, 66, 88
    local contentX, contentY = 104, 66
    local contentRight, contentBottom = 112, 74
    if UIRefs.TabBar then
        UIRefs.TabBar.Position = UDim2.fromOffset(sideX, sideY)
        UIRefs.TabBar.Size = UDim2.new(0, sideW, 1, -74)
        local caption = UIRefs.TabBar:FindFirstChild("NavigationCaption")
        local divider = UIRefs.TabBar:FindFirstChild("NavDivider")
        if caption then caption.Visible = false end
        if divider then divider.Visible = false end
    end
    if UIRefs.CategoryPages then
        for _, page in pairs(UIRefs.CategoryPages) do
            if page and page.Parent then
                page.Position = UDim2.fromOffset(contentX, contentY)
                page.Size = UDim2.new(1, -contentRight, 1, -contentBottom)
                page.ScrollBarThickness = 3
            end
        end
    end
    local order = {"player", "visuals", "combat", "utilities", "spectate", "language", "settings"}
    for i, key in ipairs(order) do
        local button = UIRefs.CategoryTabs and UIRefs.CategoryTabs[key]
        if button then
            button.Position = UDim2.fromOffset(6, 10 + (i - 1) * 50)
            button.Size = UDim2.new(1, -12, 0, 42)
            button.TextSize = 9
        end
    end
    if UIRefs.reopen then
        UIRefs.reopen.Size = UDim2.fromOffset(62, 44)
        UIRefs.reopen.TextSize = 13
    end
    if UIRefs.MobileFlyControls then
        UIRefs.MobileFlyControls.Position = UDim2.new(1, -12, 1, -18)
        UIRefs.MobileFlyControls.Size = UDim2.fromOffset(56, 120)
    end
    if UIRefs.aimLockButton then
        UIRefs.aimLockButton.Text = "AimLock Murderer"
    end
end

