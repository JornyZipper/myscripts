-- Role HUD can be dragged independently from the main menu (mouse or touch).
do
    local dragging, dragInput, dragStart, startPosition = false, nil, nil, nil

    local function clampRoleHUDPosition(position)
        local camera = Workspace.CurrentCamera
        if not camera or not UIRefs.RoleHUD then return position end
        local scale = (Scale and Scale.Scale) or 1
        if scale <= 0 then scale = 1 end
        local viewport = camera.ViewportSize / scale
        local size = UIRefs.RoleHUD.AbsoluteSize / scale
        local x = position.X.Scale * viewport.X + position.X.Offset
        local y = position.Y.Scale * viewport.Y + position.Y.Offset
        -- AnchorPoint is (0.5, 0): x is the card centre, y is its top.
        x = math.clamp(x, size.X * 0.5 + 6, viewport.X - size.X * 0.5 - 6)
        y = math.clamp(y, 6, viewport.Y - size.Y - 6)
        return UDim2.fromOffset(x, y)
    end

    addConnection(UIRefs.RoleHUD.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = true
        dragInput = input
        dragStart = input.Position
        startPosition = UIRefs.RoleHUD.Position
    end))

    addConnection(UIS.InputChanged:Connect(function(input)
        if not dragging or not dragInput or not dragStart or not startPosition then return end
        local matches = (dragInput.UserInputType == Enum.UserInputType.Touch and input == dragInput)
            or (dragInput.UserInputType == Enum.UserInputType.MouseButton1
                and input.UserInputType == Enum.UserInputType.MouseMovement)
        if not matches then return end
        local scale = (Scale and Scale.Scale) or 1
        if scale <= 0 then scale = 1 end
        local delta = (input.Position - dragStart) / scale
        UIRefs.RoleHUD.Position = clampRoleHUDPosition(UDim2.new(
            startPosition.X.Scale, startPosition.X.Offset + delta.X,
            startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
        ))
    end))

    addConnection(UIS.InputEnded:Connect(function(input)
        if not dragging or not dragInput then return end
        if input == dragInput or (dragInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseButton1) then
            dragging, dragInput, dragStart, startPosition = false, nil, nil, nil
        end
    end))
    addConnection(UIS.WindowFocusReleased:Connect(function()
        dragging, dragInput, dragStart, startPosition = false, nil, nil, nil
    end))
end

