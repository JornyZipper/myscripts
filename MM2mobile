local function getRoleName(playerName)
    local data = roles[playerName]
    if type(data) == "table" and type(data.Role) == "string" then
        return data.Role
    end
    return "Unknown"
end

roleAlive = function(playerName)
    local player = Players:FindFirstChild(playerName)
    if not player or player == LocalPlayer then
        return false
    end

    local data = roles[playerName]
    if type(data) == "table" and (data.Killed or data.Dead) then
        return false
    end

    return isAliveCharacter(player)
end

