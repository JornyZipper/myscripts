--------------------------------------------------
-- DRAG SYSTEM
--------------------------------------------------

local dragging = false
local dragInput = nil
local dragStart = nil
local dragStartPosition = nil
local dragTarget = nil

local function beginDrag(input, target)

	dragging = true
	dragInput = input
	dragStart = input.Position
	dragStartPosition = target.Position
	dragTarget = target
end

local function endDrag()

	dragging = false
	dragInput = nil
	dragStart = nil
	dragStartPosition = nil
	dragTarget = nil
end

local function updateDrag(input)

	if not dragging then
		return
	end

	if not dragTarget then
		return
	end

	local delta = input.Position - dragStart

	local newPosition = UDim2.new(
		dragStartPosition.X.Scale,
		dragStartPosition.X.Offset + delta.X,
		dragStartPosition.Y.Scale,
		dragStartPosition.Y.Offset + delta.Y
	)

	dragTarget.Position = newPosition

	if dragTarget == frame then
		settingsFrame.Position = newPosition
	elseif dragTarget == settingsFrame then
		frame.Position = newPosition
	end
end

