--------------------------------------------------

RunService.RenderStepped:Connect(function()

	if unloaded then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local camera = workspace.CurrentCamera

	if not root or not humanoid or not camera then
		return
	end

	--------------------------------------------------
	-- SPEED
	--------------------------------------------------

	if speedEnabled then
		if humanoid.WalkSpeed ~= WALK_SPEED then
			humanoid.WalkSpeed = WALK_SPEED
		end
	end

	--------------------------------------------------
	-- NOCLIP
	--------------------------------------------------

	if noclipEnabled then

		for _, object in ipairs(character:GetDescendants()) do

			if object:IsA("BasePart") then

				if originalCollision[object] == nil then
					originalCollision[object] = object.CanCollide
				end

				object.CanCollide = false
			end
		end
	end

	--------------------------------------------------
	-- FULLBRIGHT
	--------------------------------------------------

	if fullBrightEnabled then

		Lighting.Brightness = 3
		Lighting.ClockTime = 12
		Lighting.FogEnd = 100000
		Lighting.GlobalShadows = false
	end

	--------------------------------------------------
	-- LOW GRAVITY
	--------------------------------------------------

	if lowGravityEnabled then
		workspace.Gravity = 70
	end

	--------------------------------------------------
	-- FOV
	--------------------------------------------------

	camera.FieldOfView = CURRENT_FOV

	--------------------------------------------------
	-- FLY
	--------------------------------------------------

	if flyEnabled then

		if not flyVelocity or not flyVelocity.Parent then
			startFly()
			return
		end

		if not flyGyro or not flyGyro.Parent then
			startFly()
			return
		end

		local movement = Vector3.zero

		local look = camera.CFrame.LookVector
		local right = camera.CFrame.RightVector

		if IS_MOBILE then

			if mobileFly.Forward then
				movement += look
			end

			if mobileFly.Backward then
				movement -= look
			end

			if mobileFly.Left then
				movement -= right
			end

			if mobileFly.Right then
				movement += right
			end

			if mobileFly.Up then
				movement += Vector3.new(0, 1, 0)
			end

			if mobileFly.Down then
				movement -= Vector3.new(0, 1, 0)
			end

		else

			if UserInputService:IsKeyDown(Enum.KeyCode.W) then
				movement += look
			end

			if UserInputService:IsKeyDown(Enum.KeyCode.S) then
				movement -= look
			end

			if UserInputService:IsKeyDown(Enum.KeyCode.A) then
				movement -= right
			end

			if UserInputService:IsKeyDown(Enum.KeyCode.D) then
				movement += right
			end

			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
				movement += Vector3.new(0, 1, 0)
			end

			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
				movement -= Vector3.new(0, 1, 0)
			end
		end

		if movement.Magnitude > 0 then
			movement = movement.Unit * FLY_SPEED
		else
			movement = Vector3.zero
		end

		flyVelocity.Velocity = movement

		flyGyro.CFrame = CFrame.lookAt(
			root.Position,
			root.Position + camera.CFrame.LookVector
		)
	end

	updateMobileFlyControls()
end)

