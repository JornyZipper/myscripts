    local function relationColor(entry)
        if entry and entry.kind == "drone" then
            if entry.own or entry.viewed then return OWN_DRONE_COLOR end
            if entry.controlKind == "bot" then return BOT_COLOR end
            if entry.controlKind ~= "player" then return UNKNOWN_DRONE_COLOR end
            if not settings.SmartTeams or entry.relation == "unknown" then return PLAYER_DRONE_COLOR end
        end
        if not settings.SmartTeams then return settings.Color end
        if entry and entry.relation == "enemy" then return ENEMY_COLOR end
        if entry and entry.relation == "friendly" then return FRIENDLY_COLOR end
        return settings.Color -- unknown / fallback color stays user-selectable
    end

