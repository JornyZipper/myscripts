    -- One shared drag listener: a second finger on the joystick cannot hijack it.
    local drag, suppressUntil = nil, {}
    local function clampPosition(target, x, y)
        local available, size = menuRoot.AbsoluteSize, target.AbsoluteSize
        return Vector2.new(
            math.clamp(x, 0, math.max(0, available.X - size.X)),
            math.clamp(y, 0, math.max(0, available.Y - size.Y))
        )
    end
    local function place(target, position)
        target.Position = UDim2.fromOffset(position.X, position.Y)
    end
    local function draggable(handle, target)
        connect(handle.InputBegan, function(input)
            local kind = input.UserInputType
            if drag or (kind ~= Enum.UserInputType.Touch and kind ~= Enum.UserInputType.MouseButton1) then return end
            drag = {
                input = input, touch = kind == Enum.UserInputType.Touch,
                handle = handle, target = target, moved = false,
                start = Vector2.new(input.Position.X, input.Position.Y),
                origin = Vector2.new(target.Position.X.Offset, target.Position.Y.Offset),
            }
        end)
    end
    draggable(dragHandle, panel)
    draggable(openButton, openButton)
    draggable(lockButton, lockButton)
    connect(UserInputService.InputChanged, function(input)
        if not drag then return end
        if drag.touch and input ~= drag.input then return end
        if not drag.touch and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local delta = Vector2.new(input.Position.X, input.Position.Y) - drag.start
        if delta.Magnitude > 5 then drag.moved = true end
        if drag.moved then
            suppressUntil[drag.handle] = os.clock() + 0.25
            local p = drag.origin + delta
            place(drag.target, clampPosition(drag.target, p.X, p.Y))
        end
    end)
    connect(UserInputService.InputEnded, function(input)
        if not drag then return end
        if (drag.touch and input == drag.input)
            or (not drag.touch and input.UserInputType == Enum.UserInputType.MouseButton1) then
            if drag.moved then suppressUntil[drag.handle] = os.clock() + 0.25 end
            drag = nil
        end
    end)
    connect(openButton.Activated, function()
        if os.clock() >= (suppressUntil[openButton] or 0) then setMenuOpen(not panel.Visible) end
    end)
    connect(lockButton.Activated, function()
