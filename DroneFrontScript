        tag.Name = kind == "player" and "PlayerLabel" or "DroneLabel"
        tag.TextStrokeTransparency = 0.55
        tag.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        tag.TextTruncate = Enum.TextTruncate.AtEnd
